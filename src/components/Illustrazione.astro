---
// Illustrazioni delle pagine servizio, nello stile «Eclisse»: pannelli scuri, il colore del tema,
// l'ambra dell'iride e il punto rosso. Si muovono piano (servizio.css); con «riduci movimento» stanno ferme.
interface Props { id: string; lang?: 'it' | 'en' }
const { id, lang = 'it' } = Astro.props;
const it = lang === 'it';
const T = (a: string, b: string) => (it ? a : b);
const g = `ill-${id}`; // id unici per sfumature
// l'occhio del logo, in piccolo: cerchio avorio, iride ambra, pupilla e riflesso
const occhio = (x: number, y: number, r: number) => `
  <circle class="l" cx="${x}" cy="${y}" r="${r}"/>
  <ellipse class="a" cx="${x + r * 0.3}" cy="${y - r * 0.3}" rx="${r * 0.55}" ry="${r * 0.66}" transform="rotate(-35 ${x + r * 0.3} ${y - r * 0.3})"/>
  <ellipse class="notte" cx="${x + r * 0.36}" cy="${y - r * 0.38}" rx="${r * 0.22}" ry="${r * 0.27}" transform="rotate(-35 ${x + r * 0.36} ${y - r * 0.38})"/>
  <circle class="l" cx="${x + r * 0.44}" cy="${y - r * 0.5}" r="${r * 0.07}"/>`;
