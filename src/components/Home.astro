---
// La home in italiano (/) e in inglese (/en/): stessa struttura, testi nella lingua della pagina.
import Base from '../layouts/Base.astro';
import Icona from './Icona.astro';
import Occhio from './Occhio.astro';
import { dati } from '../i18n/dati.js';
import { url } from '../i18n/ui.js';
import { euro } from '../data/formato.js';

interface Props { lang?: 'it' | 'en' }
const { lang = 'it' } = Astro.props;
const it = lang === 'it';
const T = (a: string, b: string) => (it ? a : b);
const { servizi, metodo, lavori, faq, contatti, categorie } = dati(lang);
const eur = (n: number) => euro(n, lang);
const preventivo = url('preventivo', lang);
const mese = T('/mese', '/month');

const sito = categorie.find((c) => c.id === 'sito')!;
const piani = ['signature', 'presenza', 'impulso'].map((id) => sito.livelli.find((l) => l.id === id)!);
const perChi: Record<string, string> = it ? {
  signature: 'Per professionisti e brand che vogliono essere ricordati.',
  presenza: 'Per attività e professionisti che vogliono richieste ogni settimana.',
  impulso: 'Per partire subito o lanciare una promozione.',
} : {
  signature: 'For professionals and brands who want to be remembered.',
  presenza: 'For businesses and professionals who want enquiries every week.',
  impulso: 'To get started fast or launch a promotion.',
};
const altri = ['ecommerce', 'software', 'integrazioni', 'ads', 'cura'].map((id) => {
  const c = categorie.find((x) => x.id === id)!;
  const l = c.livelli[0];
  return { nome: c.nome, prezzo: l.una ? eur(l.una) : eur(l.mese!) + mese };
});
const parole = it
  ? ['Siti web', 'Negozi online', 'Software con AI', 'Collegamenti AI', 'Meta Ads', 'Google Ads', 'TikTok Ads', 'Neuromarketing', 'Copy che vende', 'Esperienze 3D']
  : ['Websites', 'Online stores', 'AI software', 'AI integrations', 'Meta Ads', 'Google Ads', 'TikTok Ads', 'Neuromarketing', 'Copy that sells', '3D experiences'];

// Benvenuto: le tre domande dell'hero
const settori = it
  ? [['professionista', 'Professionista'], ['artigiano', 'Artigiano o servizi'], ['immobiliare', 'Immobiliare'], ['negozio', 'Negozio o e-commerce'], ['azienda', 'Azienda'], ['altro', 'Altro']]
  : [['professionista', 'Professional'], ['artigiano', 'Trades and services'], ['immobiliare', 'Real estate'], ['negozio', 'Shop or e-commerce'], ['azienda', 'Company'], ['altro', 'Other']];
const colori = [
  { id: 'blu', c: '#3D7BFF', nome: T('Blu', 'Blue'), senso: T('Fiducia', 'Trust') },
  { id: 'rosso', c: '#FF3347', nome: T('Rosso', 'Red'), senso: T('Energia', 'Energy') },
  { id: 'viola', c: '#8B6CFF', nome: T('Viola', 'Purple'), senso: T('Creatività', 'Creativity') },
  { id: 'verde', c: '#22D47E', nome: T('Verde', 'Green'), senso: T('Crescita', 'Growth') },
];

const waTesto = T('Ciao Gabriele, ho visto il tuo sito e vorrei parlarti di un progetto.', "Hi Gabriele, I saw your website and I'd like to talk about a project.");
const descrizione = T(
  'Siti web, e-commerce, software con intelligenza artificiale e pubblicità online progettati con psicologia e neuromarketing.',
  'Websites, e-commerce, AI software and online advertising designed with psychology and neuromarketing.',
);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: contatti.studio,
  founder: { '@type': 'Person', name: contatti.nome, jobTitle: T('Fondatore', 'Founder') },
  description: descrizione,
  url: new URL(url('home', lang), Astro.site).toString(),
  email: contatti.email,
  telephone: contatti.telefono,
  areaServed: ['IT', 'CH'],
  inLanguage: lang,
  address: { '@type': 'PostalAddress', addressLocality: 'Milano', addressCountry: 'IT' },
  sameAs: [contatti.linkedin],
};
---
<Base
  lang={lang}
  path={url('home', lang)}
  alt={url('home', it ? 'en' : 'it')}
  title={T('Studio Desideri · Siti web, AI e pubblicità che portano clienti', 'Studio Desideri · Websites, AI and ads that bring clients')}
  description={T(
    'Siti web, e-commerce, software con intelligenza artificiale e pubblicità online, progettati con la psicologia per portare le persone dal primo sguardo al «sì». Milano, Italia e Svizzera.',
    'Websites, e-commerce, AI software and online advertising, designed with psychology to take people from first glance to "yes". Based in Milan, working across Italy and Switzerland.',
  )}
  jsonLd={jsonLd}
>
  <!-- 01 · ATTENZIONE -->
  <section class="hero" id="inizio" data-forma="0" data-lato="destra" data-x="1.13" data-scala="0.86" data-y-mobile="0.2" data-scala-mobile="0.6" data-luce-mobile="1">
    <div class="wrap">
      <div class="hero-testo">
        <div class="hero-spazio-occhio" aria-hidden="true"></div>
        <span class="capitolo" data-appare>{T('Capitolo 01 · Attenzione', 'Chapter 01 · Attention')}</span>
        {it ? (
          <h1 data-righe>
            <span class="riga riga-nome" data-riga-nome hidden><span><span data-saluto></span><span data-nome></span>,</span></span>
            <span class="riga"><span data-minuscola>Trasformo</span></span>
            <span class="riga"><span>chi ti guarda</span></span>
            <span class="riga"><span>in chi ti <span class="em em-firma">sceglie.</span></span></span>
          </h1>
        ) : (
          <h1 data-righe>
            <span class="riga riga-nome" data-riga-nome hidden><span><span data-saluto></span><span data-nome></span>,</span></span>
            <span class="riga"><span>I turn</span></span>
            <span class="riga"><span>attention</span></span>
            <span class="riga"><span>into <span class="em em-firma">clients.</span></span></span>
          </h1>
        )}
        {it ? (
          <p class="lead" data-appare="0.25">
            <a class="parola-iride" href="#servizi" data-iride="sito">Siti web</a>, <a class="parola-iride" href="#servizi" data-iride="ecommerce">negozi online</a>, <a class="parola-iride" href="#servizi" data-iride="software">software con intelligenza artificiale</a> e <a class="parola-iride" href="#servizi" data-iride="ads">pubblicità</a>.
            Progettati con la psicologia per portare le persone <strong style="color:var(--latte);font-weight:600">dal primo sguardo al «sì»</strong>.
          </p>
        ) : (
          <p class="lead" data-appare="0.25">
            <a class="parola-iride" href="#servizi" data-iride="sito">Websites</a>, <a class="parola-iride" href="#servizi" data-iride="ecommerce">online stores</a>, <a class="parola-iride" href="#servizi" data-iride="software">AI software</a> and <a class="parola-iride" href="#servizi" data-iride="ads">advertising</a>.
            Designed with psychology to take people <strong style="color:var(--latte);font-weight:600">from first glance to "yes"</strong>.
          </p>
        )}
        <div class="hero-azioni" data-appare="0.4">
          <a class="btn btn-azione btn-grande" href={preventivo} data-azione data-sguardo-meta>{T('Calcola il tuo preventivo', 'Get your quote')} <span class="freccia" aria-hidden="true">→</span></a>
          <a class="btn btn-vetro btn-grande" href="#metodo">{T('Guarda come funziona', 'See how it works')}</a>
        </div>
        <ul class="rassicura" data-appare="0.55">
          <li>{T('Preventivo in 2 minuti', 'Quote in 2 minutes')}</li>
          <li>{T('Risposta entro 24 ore', 'Reply within 24 hours')}</li>
          <li>{contatti.zona}</li>
        </ul>

        <!-- Benvenuto: tre domande facoltative che rendono il sito suo -->
        <div class="benvenuto" id="personalizza" data-benvenuto data-appare="0.7">
          <div class="bv-testa">
            <Occhio espressione="curioso" />
            <span class="mono">{T('Rendi tuo questo sito', 'Make this site yours')}</span>
            <span class="bv-passi" aria-hidden="true"><i class="attivo"></i><i></i><i></i></span>
            <button class="bv-chiudi" type="button" data-bv-chiudi aria-label={T('Chiudi la personalizzazione', 'Close personalisation')}>×</button>
          </div>

          <form class="bv-passo" data-bv-passo="1">
            <label class="bv-domanda" for="bv-nome">{T('Come ti chiami?', "What's your name?")}</label>
            <div class="bv-riga">
              <input id="bv-nome" name="nome" type="text" autocomplete="given-name" maxlength="24" placeholder={T('Il tuo nome', 'Your first name')} enterkeyhint="next" />
              <button class="btn btn-vetro btn-piccolo" type="submit">{T('Avanti', 'Next')} <span class="freccia" aria-hidden="true">→</span></button>
            </div>
            <button class="bv-salta" type="button" data-bv-salta>{T('Salta', 'Skip')}</button>
          </form>

          <div class="bv-passo" data-bv-passo="2" hidden>
            <p class="bv-domanda"><span data-bv-saluto></span>{T('Di cosa ti occupi?', 'What do you do?')}</p>
            <div class="bv-scelte">
              {settori.map(([id, nome]) => <button class="bv-chip" type="button" data-settore={id}>{nome}</button>)}
            </div>
            <button class="bv-salta" type="button" data-bv-salta>{T('Salta', 'Skip')}</button>
          </div>

          <div class="bv-passo" data-bv-passo="3" hidden>
            <p class="bv-domanda">{T('Che colore ti somiglia?', 'Which colour feels like you?')}</p>
            <div class="bv-colori" role="radiogroup" aria-label={T('Colore del sito', 'Site colour')}>
              {colori.map((c) => (
                <button class="bv-colore" type="button" role="radio" aria-checked="false" data-tema-scelta={c.id} style={`--c:${c.c}`}>
                  <i aria-hidden="true"></i><span>{c.nome}</span><small>{c.senso}</small>
                </button>
              ))}
            </div>
            <button class="bv-salta" type="button" data-bv-salta>{T('Salta', 'Skip')}</button>
          </div>

          <div class="bv-passo bv-fatto" data-bv-passo="4" hidden>
            <Occhio espressione="occhiolino" />
            <p><span data-bv-fatto></span> <button class="bv-salta" type="button" data-bv-modifica>{T('Modifica', 'Edit')}</button></p>
          </div>
          <p class="bv-nota">{T('Resta solo sul tuo dispositivo.', 'Stays on your device only.')}</p>
        </div>
      </div>
    </div>
    <div class="didascalia">
      {it
        ? <p class="didascalia-testo">L'attenzione è la moneta più preziosa di oggi. <span class="em em-firma">Chi la cattura, vince.</span></p>
        : <p class="didascalia-testo">Attention is today's most valuable currency. <span class="em em-firma">Whoever captures it, wins.</span></p>}
      <p class="sguardo-hint" aria-hidden="true">
        <span class="sguardo-mouse">{T("Passa sulle parole e guarda dove va l'attenzione", 'Hover over the words and watch where attention goes')}</span>
        <span class="sguardo-dito">{T("Tocca le parole e guarda dove va l'attenzione", 'Tap the words and watch where attention goes')}</span>
      </p>
    </div>
    <a class="scorri" href="#problema" aria-label={T('Scorri', 'Scroll')}>
      <span class="mono">{T('Scorri', 'Scroll')}</span>
      <span class="scorri-linea"></span>
    </a>
  </section>

  <div class="nastro" aria-hidden="true">
    <div class="nastro-traccia">
      {[0, 1].map(() => (
        <div class="nastro-gruppo">
          {parole.map((p) => <span>{p}<i>✦</i></span>)}
        </div>
      ))}
    </div>
  </div>

  <!-- IL PROBLEMA -->
  <section class="sezione" id="problema" data-forma="0" data-lato="destra" data-y="0.2" data-luce="0.5" data-scala="0.62">
    <div class="wrap">
      <div class="testa-sezione">
        <span class="capitolo" data-appare>{T('Il problema', 'The problem')}</span>
        {it ? (
          <h2 data-righe>
            <span class="riga"><span>Un sito bello non basta.</span></span>
            <span class="riga"><span>Deve far venire <span class="em">voglia</span></span></span>
            <span class="riga"><span>di sceglierti.</span></span>
          </h2>
        ) : (
          <h2 data-righe>
            <span class="riga"><span>A beautiful site isn't enough.</span></span>
            <span class="riga"><span>It has to make people <span class="em">want</span></span></span>
            <span class="riga"><span>to choose you.</span></span>
          </h2>
        )}
      </div>
      <div class="dolori" data-sequenza>
        {(it ? [
          ['01 — Nessuno ti trova', 'Sei bravo, ma online sei invisibile.', 'I clienti cercano proprio quello che fai. Solo che trovano prima gli altri.'],
          ['02 — Ti trovano, ma se ne vanno', 'Pochi secondi e chiudono la pagina.', 'Il sito è lento, confuso o uguale a mille altri. Il cervello decide in fretta e passa oltre.'],
          ['03 — Ti guardano, ma non ti scrivono', 'Visite tante, richieste poche.', 'Manca il percorso che porta dalla curiosità alla fiducia, e dalla fiducia al «ti scrivo».'],
        ] : [
          ['01 — Nobody finds you', "You're good, but online you're invisible.", 'Clients are searching for exactly what you do. They just find someone else first.'],
          ['02 — They find you, then leave', 'A few seconds and the tab is closed.', 'The site is slow, confusing or looks like a thousand others. The brain decides fast and moves on.'],
          ["03 — They look, but don't get in touch", 'Lots of visits, few enquiries.', 'The path from curiosity to trust, and from trust to "let\'s talk", is missing.'],
        ]).map(([n, h, p]) => (
          <div class="dolore">
            <span class="dolore-num">{n}</span>
            <h3>{h}</h3>
            <p>{p}</p>
          </div>
        ))}
      </div>
      <p class="svolta" data-appare>
        {T('Io costruisco quel percorso.', 'I build that path.')} <span class="em em-firma">{T('Dal primo sguardo al sì.', 'From first glance to yes.')}</span>
      </p>
    </div>
  </section>

  <!-- 02 · INTERESSE -->
  <section class="sezione" id="servizi" data-forma="1" data-lato="destra" data-y="0.18" data-luce="0.45" data-scala="0.8">
    <div class="wrap">
      <div class="testa-sezione">
        <span class="capitolo" data-appare>{T('Capitolo 02 · Interesse', 'Chapter 02 · Interest')}</span>
        <h2 data-righe>
          <span class="riga"><span>{T('Cosa faccio,', 'What I do,')}</span></span>
          <span class="riga"><span><span class="em">{T('detto semplice.', 'in plain words.')}</span></span></span>
        </h2>
        <p class="lead" data-appare>{T(
          'Sei servizi che lavorano insieme. Puoi sceglierne uno solo o farli parlare tra loro: è lì che i risultati si moltiplicano.',
          "Six services that work together. Pick just one or let them talk to each other: that's where results multiply.",
        )}</p>
      </div>
      <div class="servizi-griglia" data-sequenza>
        {servizi.map((s) => (
          <article class="card servizio" data-iride={s.id}>
            <div class="servizio-top">
              <span class="servizio-icona"><Icona nome={s.icona} /></span>
              <span class="mono">{s.numero}</span>
            </div>
            <h3>{s.titolo}</h3>
            <div style="display:grid;gap:1rem;align-content:start">
              <p>{s.semplice}</p>
              <p class="esempio">{s.esempio}</p>
            </div>
            <div class="servizio-piede">
              <span class="prezzo-da">{T('A partire da', 'Starting from')}<strong>{eur(s.da)}{s.mese && <small> {mese}</small>}</strong></span>
              <a class="link-freccia" href={`${preventivo}?s=${s.id}`}>{T('Aggiungi', 'Add')} <span class="freccia" aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CALCOLATORE DEL TEMPO RISPARMIATO -->
  <section class="sezione" id="risparmio" data-forma="1" data-lato="sinistra" data-luce="0.75" data-scala="0.9">
    <div class="wrap risparmio">
      <div class="testa-sezione" style="margin-bottom:0">
        <span class="capitolo" data-appare>{T('Software con AI', 'AI software')}</span>
        {it ? (
          <h2 data-righe>
            <span class="riga"><span>Quanto tempo</span></span>
            <span class="riga"><span>perdi in lavori</span></span>
            <span class="riga"><span class="em">che una macchina</span></span>
            <span class="riga"><span class="em">farebbe meglio?</span></span>
          </h2>
        ) : (
          <h2 data-righe>
            <span class="riga"><span>How much time</span></span>
            <span class="riga"><span>do you lose on work</span></span>
            <span class="riga"><span class="em">a machine would</span></span>
            <span class="riga"><span class="em">do better?</span></span>
          </h2>
        )}
        <p class="lead" data-appare>{T(
          'Copiare dati, rispondere sempre alle stesse email, preparare preventivi, cercare documenti. Muovi i cursori e guarda quanto vale il tempo che ti restituisco.',
          'Copying data, answering the same emails over and over, preparing quotes, hunting for documents. Move the sliders and see what the time I give back is worth.',
        )}</p>
      </div>
      <div class="risparmio-pannello" data-risparmio data-lang={lang} data-appare>
        <div class="cursore-campo">
          <label for="r-ore">{T('Ore a settimana in lavori ripetitivi, a persona', 'Hours a week on repetitive work, per person')} <output data-out="ore">8</output></label>
          <input id="r-ore" type="range" min="1" max="30" value="8" data-in="ore" />
        </div>
        <div class="cursore-campo">
          <label for="r-persone">{T('Persone che li fanno', 'People doing it')} <output data-out="persone">3</output></label>
          <input id="r-persone" type="range" min="1" max="30" value="3" data-in="persone" />
        </div>
        <div class="cursore-campo">
          <label for="r-costo">{T("Costo di un'ora di lavoro", 'Cost of one hour of work')} <output data-out="costo">{eur(25)}</output></label>
          <input id="r-costo" type="range" min="12" max="80" value="25" data-in="costo" />
        </div>
        <div class="risultati" aria-live="polite">
          <div class="risultato"><strong data-ris="ore">662</strong><span>{T('ore restituite in un anno', 'hours given back each year')}</span></div>
          <div class="risultato caldo"><strong data-ris="euro">{eur(16550)}</strong><span>{T('di lavoro risparmiato ogni anno', 'of work saved every year')}</span></div>
        </div>
        <a class="btn btn-azione" href={`${preventivo}?s=software`} data-azione>{T('Voglio recuperare questo tempo', 'I want this time back')} <span class="freccia" aria-hidden="true">→</span></a>
        <p class="nota">{T(
          'Stima prudente: calcolo 46 settimane lavorative e considero automatizzabile il 60% di quelle ore. Il numero vero lo misuriamo insieme nella Diagnosi AI.',
          'A cautious estimate: I count 46 working weeks and assume 60% of those hours can be automated. We measure the real number together in the AI diagnosis.',
        )}</p>
      </div>
    </div>
  </section>

  <!-- 03 · FIDUCIA: IL METODO -->
  <section class="sezione" id="metodo">
    <div class="wrap metodo">
      <div class="metodo-fisso">
        <span class="icona-titolo"><Icona nome="sguardo" /></span>
        <span class="capitolo">{T('Capitolo 03 · Il metodo', 'Chapter 03 · The method')}</span>
        {it ? (
          <h2 data-righe>
            <span class="riga"><span>Cinque passi</span></span>
            <span class="riga"><span>nella testa</span></span>
            <span class="riga"><span>del <span class="em em-firma">tuo cliente.</span></span></span>
          </h2>
        ) : (
          <h2 data-righe>
            <span class="riga"><span>Five steps</span></span>
            <span class="riga"><span>inside your</span></span>
            <span class="riga"><span><span class="em em-firma">client's mind.</span></span></span>
          </h2>
        )}
        <p class="metodo-sotto">{T(
          'Le cinque tappe che ogni persona attraversa prima di comprare. Per ognuna uso tecniche studiate dalla psicologia e provate sul campo.',
          'The five stages everyone goes through before buying. For each one I use techniques studied by psychology and tested in the field.',
        )}</p>
        <ol class="metodo-indice" data-indice>
          {metodo.map((m, i) => <li class={i === 0 ? 'attivo' : ''}>{String(i + 1).padStart(2, '0')} {m.passo}</li>)}
        </ol>
      </div>
      <div class="passi">
        {metodo.map((m, i) => (
          <article class="passo" data-passo data-forma={m.forma} data-lato="sinistra" data-y="-0.31" data-scala="0.44">
            <span class="passo-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="capitolo">{m.passo}</span>
            <h3>{m.titolo}</h3>
            <p class="passo-testa">{m.testa}</p>
            <div class="passo-tecnica">
              <span class="mono">{T('Tecnica', 'Technique')} · {m.tecnica}</span>
              <p>{m.spiega}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- LAVORI -->
  <section class="sezione" id="lavori" data-forma="2" data-lato="destra" data-y="0.22" data-luce="0.3" data-scala="0.75">
    <div class="wrap">
      <div class="testa-sezione">
        <span class="capitolo" data-appare>{T('Lavori', 'Work')}</span>
        <h2 data-righe>
          <span class="riga"><span>{T('Non te lo racconto.', "I won't tell you.")}</span></span>
          <span class="riga"><span><span class="em">{T('Te lo mostro.', "I'll show you.")}</span></span></span>
        </h2>
        <p class="lead" data-appare>{T(
          'Due progetti molto diversi, con lo stesso obiettivo: far scegliere il mio cliente invece della concorrenza.',
          'Two very different projects with the same goal: getting my client chosen over the competition.',
        )}</p>
      </div>
      <div class="lavori" data-lavori>
        {lavori.map((l) => (
          <article class="lavoro" data-lavoro={l.id}>
            <a class="lavoro-media" href={l.url} target="_blank" rel="noopener" aria-label={T(`Apri il sito di ${l.cliente}`, `Open ${l.cliente}'s website`)} data-appare>
              <span class="browser" aria-hidden="true"><i></i><i></i><i></i></span>
              <img src={l.img} alt={T(`La home del sito di ${l.cliente}`, `The home page of ${l.cliente}'s website`)} width="1440" height="900" loading="lazy" decoding="async" />
            </a>
            <div class="lavoro-testo" data-appare="0.1">
              <span class="pacchetto-tag">{l.pacchetto}</span>
              <h3 style="font-size:clamp(1.8rem,3vw,2.6rem)">{l.cliente}</h3>
              <p class="settore">{l.settore}</p>
              <p class="sfida">{l.sfida}</p>
