---
// La home in italiano (/) e in inglese (/en/): stessa struttura, testi nella lingua della pagina.
import Base from '../layouts/Base.astro';
import Icona from './Icona.astro';
import Anteprima from './Anteprima.astro';
import Intruso from './Intruso.astro';
import MicroIcona from './MicroIcona.astro';
import '../styles/recensioni.css';
import '../styles/servizi-vivi.css';
import { dati } from '../i18n/dati.js';
import { url, urlServizio } from '../i18n/ui.js';

interface Props { lang?: 'it' | 'en' }
const { lang = 'it' } = Astro.props;
const it = lang === 'it';
const T = (a: string, b: string) => (it ? a : b);
const { servizi, metodo, lavori, faq, contatti } = dati(lang);
const iniziali = (nome: string) => nome.replace(/^Dott\.\s*/, '').split(' ').map((p) => p[0]).slice(0, 2).join('');
const preventivo = url('preventivo', lang);

// i servizi sul telefono: una riga sola per scheda
const brevi: Record<string, string> = it
  ? { sito: 'Ti trovano su Google e ti scrivono.', ecommerce: 'Vendi 24 ore su 24, anche mentre dormi.', software: 'Il lavoro ripetitivo si fa da solo.', gestionale: 'Il programma fatto come lavori tu.', ads: 'Annunci che portano clienti, non solo «mi piace».', cura: 'Sempre aggiornato, sicuro e più efficace.' }
  : { sito: 'People find you on Google and get in touch.', ecommerce: 'Sell 24/7, even while you sleep.', software: 'Repetitive work does itself.', gestionale: 'Software built around how you work.', ads: 'Ads that bring clients, not just likes.', cura: 'Always updated, secure and improving.' };


const waTesto = T('Ciao! Ho visto il sito di Desideri&Code e vorrei parlarvi di un progetto.', "Hi! I saw the Desideri&Code website and I'd like to talk to you about a project.");
const descrizione = T(
  'Siti web, e-commerce, software con intelligenza artificiale e pubblicità online progettati con psicologia e neuromarketing.',
  'Websites, e-commerce, AI software and online advertising designed with psychology and neuromarketing.',
);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: contatti.studio,
  founder: { '@type': 'Person', name: contatti.nome, jobTitle: T('Fondatore', 'Founder') },
  description: descrizione,
  url: new URL(url('home', lang), Astro.site).toString(),
  email: contatti.email,
  telephone: contatti.telefono,
  areaServed: ['IT', 'CH'],
  inLanguage: lang,
  address: { '@type': 'PostalAddress', addressLocality: 'Milano', addressCountry: 'IT' },
  sameAs: [contatti.linkedin],
};
---
<Base
  lang={lang}
  path={url('home', lang)}
  alt={url('home', it ? 'en' : 'it')}
  title={T('Desideri&Code · Siti web, AI e pubblicità che portano clienti', 'Desideri&Code · Websites, AI and ads that bring clients')}
  description={T(
    'Siti web, e-commerce, software con intelligenza artificiale e pubblicità online, progettati con la psicologia per portare le persone dal primo sguardo al «sì». Milano, Italia e Svizzera.',
    'Websites, e-commerce, AI software and online advertising, designed with psychology to take people from first glance to "yes". Based in Milan, working across Italy and Switzerland.',
  )}
  jsonLd={jsonLd}
>

  <!-- 01 · ATTENZIONE -->
  <!-- HERO: si capisce subito cosa facciamo. A sinistra il titolo, una frase e un bottone; a destra le anteprime dei servizi
       che girano da sole (le stesse delle pagine servizio), con il nome del servizio acceso sotto il titolo (servizi-vivi.js) -->
  <section class="hero hero-chiara" id="inizio" data-forma="0">
    <div class="wrap hc-griglia">
      <div class="hc-testo">
        <h1 data-righe>
          <span class="riga riga-nome" data-riga-nome hidden><span><span data-saluto></span><span data-nome></span>,</span></span>
          {it ? (
            <Fragment>
              <span class="riga"><span data-minuscola>Automazioni AI,</span></span>
              <span class="riga"><span>gestionali e siti</span></span>
              <span class="riga"><span class="em">per la tua azienda</span><span class="quadratino" aria-hidden="true"></span></span>
            </Fragment>
          ) : (
            <Fragment>
              <span class="riga"><span data-minuscola>AI automation,</span></span>
              <span class="riga"><span>custom software</span></span>
              <span class="riga"><span class="em">and websites</span><span class="quadratino" aria-hidden="true"></span></span>
            </Fragment>
          )}
        </h1>
        <p class="lead" data-appare="0.2">{T(
          'Studiamo come lavori, poi costruiamo gli strumenti che ti fanno risparmiare ore e portano clienti.',
          'We study how you work, then build the tools that save you hours and bring in clients.',
        )}</p>
        <div class="hc-servizi" data-appare="0.3" role="group" aria-label={T('I servizi', 'Services')}>
          {servizi.map((s, i) => <button type="button" class={i === 0 ? 'on' : ''} data-hc={i} aria-pressed={i === 0 ? 'true' : 'false'}>{s.titolo}</button>)}
        </div>
        <div class="hero-azioni" data-appare="0.4">
          <a class="btn btn-azione btn-grande" href={preventivo} data-azione>{T('Richiedi un preventivo', 'Request a quote')} <span class="freccia" aria-hidden="true">→</span></a>
          <a class="btn btn-vetro btn-grande" href="#servizi">{T('Guarda i servizi', 'See the services')}</a>
        </div>
        <ul class="rassicura" data-appare="0.5">
          <li><MicroIcona nome="tempo" />{T('Preventivo scritto, su misura', 'Written, tailored quote')}</li>
          <li><MicroIcona nome="risposta" />{T('Risposta entro 24 ore', 'Reply within 24 hours')}</li>
        </ul>
      </div>
      <div class="hc-vetrina" data-hero-vetrina aria-hidden="true">
        {servizi.map((s, i) => <div class="sv-ap hc-ap" data-ap={s.id} hidden={i !== 0}><Anteprima id={s.id} lang={lang} lazy={i !== 0} /></div>)}
      </div>
    </div>
  </section>

  <!-- 02 · INTERESSE -->
  <section class="sezione" id="servizi" data-forma="1">
    <div class="wrap">
      <div class="testa-sezione testa-riga">
        <span class="capitolo" data-appare>{T('I servizi', 'Services')}</span>
        <h2 data-righe>
          <span class="riga"><span>{T('Cosa facciamo,', 'What we do,')}</span></span>
          <span class="riga"><span><span class="em">{T('detto semplice.', 'in plain words.')}</span></span></span>
        </h2>
        <p class="lead" data-appare>{T(
          'Sei servizi che lavorano insieme. Puoi sceglierne uno solo o farli parlare tra loro: è lì che i risultati si moltiplicano.',
          "Six services that work together. Pick just one or let them talk to each other: that's where results multiply.",
        )}</p>
      </div>
      <!-- i servizi in movimento (servizi-vivi.js): le stesse anteprime animate delle pagine servizio.
           Sul computer l'indice e l'anteprima, sul telefono i nomi sopra e le schede da scorrere -->
      <div class="sv" data-servizi-vivi data-lang={lang}>
        <div class="sv-pc">
          <nav class="sv-lista" aria-label={T('Servizi', 'Services')}>
            {servizi.map((s) => (
              <a class="sv-voce" href={urlServizio(s.id, lang)} data-id={s.id} data-titolo={s.titolo} data-testo={s.semplice}>
                <span class="mono">{s.numero}</span><span class="servizio-icona"><Icona nome={s.icona} /></span><b>{s.titolo}</b><span class="freccia" aria-hidden="true">→</span>
              </a>
            ))}
          </nav>
          <div class="sv-anteprima" aria-hidden="true">
            <div class="sv-palco">{servizi.map((s, i) => <div class="sv-ap" data-ap={s.id} hidden={i !== 0}><Anteprima id={s.id} lang={lang} lazy /></div>)}</div>
            <div class="sv-info"><div><b data-sv-titolo></b><p data-sv-testo></p></div><a class="link-freccia" href={urlServizio(servizi[0].id, lang)} data-sv-scopri tabindex="-1">{T('Scopri', 'Discover')} <span class="freccia">→</span></a></div>
          </div>
        </div>
        <div class="sv-tel">
          <div class="sv-chips">{servizi.map((s, i) => <button class="sv-chip" type="button" aria-pressed={i === 0 ? 'true' : 'false'}><i></i>{s.titolo}</button>)}</div>
          <div class="sv-fila" data-sv-fila>
            {servizi.map((s) => (
              <article class="sv-scheda">
                <div class="sv-ap sv-ap-scheda"><Anteprima id={s.id} lang={lang} lazy /></div>
                <div class="sv-corpo">
                  <div class="sv-riga1"><h3><a href={urlServizio(s.id, lang)}>{s.titolo}</a></h3><span class="mono">{s.numero} / 0{servizi.length}</span></div>
                  <p>{brevi[s.id] || s.semplice}</p>
                  <span class="link-freccia" aria-hidden="true">{T('Scopri', 'Discover')} <span class="freccia">→</span></span>
                </div>
              </article>
            ))}
          </div>
          <div class="sv-sotto"><span class="sv-hint">{T('Scorri o tocca un nome', 'Swipe or tap a name')} <i aria-hidden="true">→</i></span><span class="sv-conta" data-sv-conta><b>01</b> / 0{servizi.length}</span></div>
          <div class="sv-linea" data-sv-linea style={`--n:${servizi.length}`}><b></b></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 · IL METODO: i cinque passi. Scorrendo si accende un numero alla volta (rosso) e a destra entra il suo passo (vita.js, metodoNumeri) -->
  <section class="sezione" id="metodo" data-forma="2">
    <div class="wrap">
      <div class="testa-sezione">
        <span class="capitolo">{T('Il metodo', 'The method')}</span>
        {it ? (
          <h2 data-righe>
            <span class="riga"><span>Cinque passi nella testa</span></span>
            <span class="riga"><span>del <span class="em em-firma">tuo cliente.</span></span></span>
          </h2>
        ) : (
          <h2 data-righe>
            <span class="riga"><span>Five steps inside</span></span>
            <span class="riga"><span><span class="em em-firma">your client's mind.</span></span></span>
          </h2>
        )}
        <p class="lead">{T(
          'Le cinque tappe che ogni persona attraversa prima di comprare. Per ognuna usiamo tecniche studiate dalla psicologia e provate sul campo.',
          'The five stages everyone goes through before buying. For each one we use techniques studied by psychology and tested in the field.',
        )}</p>
      </div>
    </div>
    <div class="metodo-pista" data-metodo>
      <div class="metodo-palco wrap">
        <ol class="metodo-numeri" aria-hidden="true">
          {metodo.map((_, i) => <li class={i === 0 ? 'on' : ''}>{String(i + 1).padStart(2, '0')}</li>)}
        </ol>
        <div class="metodo-passi">
          {metodo.map((m, i) => (
            <article class={`passo${i === 0 ? ' on' : ''}`}>
              <span class="passo-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="capitolo">{String(i + 1).padStart(2, '0')} · {m.passo}</span>
              {/* il verbo del passo è sottolineato: la linea si allunga mentre scorri il passo (vita.js, metodoNumeri) */}
              <h3>{(() => { const k = m.verbo ? m.titolo.indexOf(m.verbo) : -1; return k < 0 ? m.titolo : <>{m.titolo.slice(0, k)}<span class="verbo">{m.verbo}</span>{m.titolo.slice(k + m.verbo.length)}</>; })()}</h3>
              <p class="passo-testa">{m.testa}</p>
              {/* il nome della tecnica si vede sempre; la spiegazione la apre solo chi è curioso */}
              <details class="passo-tecnica">
                <summary>
                  <span class="pt-nome mono">{T('Tecnica', 'Technique')} · <b>{m.tecnica}</b></span>
                  <span class="pt-vedi"><span class="pt-piu" aria-hidden="true"></span><span class="pt-apri">{T('Vedi la spiegazione', 'See the explanation')}</span><span class="pt-chiudi">{T('Chiudi', 'Close')}</span></span>
                </summary>
                <p class="pt-corpo">{m.spiega}</p>
              </details>
              {i === 0 && <Intruso lang={lang} />}
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PARLANO DI NOI: le recensioni dei clienti in una fila che scorre da sola (vita.js, data-fila).
       Cliccandone una si apre il progetto: il sito, cosa abbiamo fatto e il link per guardarlo dal vivo.
       Finché un cliente non ha scritto la sua recensione, al suo posto c'è la sfida del progetto (data/sito.js, lavori) -->
  <section class="sezione" id="lavori" data-forma="2">
    <div class="wrap">
      <div class="testa-sezione testa-riga">
        <span class="capitolo" data-appare>{T('Parlano di noi', 'What clients say')}</span>
        <h2 data-righe>
          <span class="riga"><span>{T('Clienti veri,', 'Real clients,')}</span></span>
          <span class="riga"><span><span class="em">{T('siti veri.', 'real websites.')}</span></span></span>
        </h2>
        <p class="lead" data-appare>{T(
          'Sono online e lavorano ogni giorno per loro. Tocca una scheda per vedere il progetto e aprire il sito dal vivo.',
          'They are live and working for them every day. Tap a card to see the project and open the live site.',
        )}</p>
      </div>
      <ul class="recensioni" role="list" data-fila data-recensioni data-appare>
        {lavori.map((l) => (
          <li>
            <button class="recensione" type="button" data-recensione={l.id} aria-haspopup="dialog">
              <span class="rc-testa">
                {l.voto
                  ? <span class="rc-stelle" role="img" aria-label={T(`${l.voto} stelle su 5`, `${l.voto} out of 5 stars`)}>{[1, 2, 3, 4, 5].map((n) => <i class={n <= l.voto ? 'piena' : ''}></i>)}</span>
                  : <span class="mono">{T('La sfida', 'The challenge')}</span>}
                <span class="rc-virgolette" aria-hidden="true">“</span>
              </span>
              <span class={l.recensione ? 'rc-testo' : 'rc-testo rc-sfida'}>{l.recensione ? `«${l.recensione}»` : l.sfida}</span>
              <span class="rc-firma">
                {l.logo
                  ? <img src={l.logo} alt="" width="42" height="42" loading="lazy" decoding="async" />
                  : <span class="cliente-iniziali" aria-hidden="true">{iniziali(l.cliente)}</span>}
                <span><strong>{l.cliente}</strong><small>{l.settore}</small></span>
              </span>
              <span class="rc-piede"><span class="pacchetto-tag">{l.pacchetto}</span><span class="rc-apri">{T('Vedi il progetto', 'See the project')} <span class="freccia" aria-hidden="true">→</span></span></span>
            </button>
          </li>
        ))}
      </ul>
    </div>
    {lavori.map((l) => {
      const dominio = new URL(l.url).hostname.replace(/^www\./, '');
      return (
        <dialog class="rc-dialogo" data-recensione-dialogo={l.id} aria-label={l.cliente} data-lenis-prevent>
          <div class="rc-box">
            <button class="cl-chiudi rc-chiudi" type="button" data-rc-chiudi aria-label={T('Chiudi', 'Close')}>×</button>
            <a class="cliente-anteprima" href={l.url} target="_blank" rel="noopener" aria-label={T(`Apri il sito di ${l.cliente}`, `Open ${l.cliente}'s website`)}>
              <span class="browser" aria-hidden="true"><i></i><i></i><i></i><span>{dominio}</span></span>
              <img src={l.img} alt={T(`La home del sito di ${l.cliente}`, `The home page of ${l.cliente}'s website`)} width="1440" height="900" loading="lazy" decoding="async" />
              <span class="cliente-guarda" aria-hidden="true">{T('Guarda il sito', 'View the site')} ↗</span>
            </a>
            <div class="rc-corpo">
              {l.voto && <span class="rc-stelle" role="img" aria-label={T(`${l.voto} stelle su 5`, `${l.voto} out of 5 stars`)}>{[1, 2, 3, 4, 5].map((n) => <i class={n <= l.voto ? 'piena' : ''}></i>)}</span>}
              {l.recensione
                ? <blockquote class="cliente-citazione">«{l.recensione}»</blockquote>
                : <p class="cliente-sfida"><span class="mono">{T('La sfida', 'The challenge')}</span>{l.sfida}</p>}
              <div class="cliente-firma">
                {l.logo
                  ? <img class="cliente-logo" src={l.logo} alt="" width="42" height="42" loading="lazy" decoding="async" />
                  : <span class="cliente-iniziali" aria-hidden="true">{iniziali(l.cliente)}</span>}
                <span><strong>{l.cliente}</strong><small>{l.settore}</small></span>
                <span class="pacchetto-tag">{l.pacchetto}</span>
              </div>
              <span class="mono rc-fatto-titolo">{T('Cosa abbiamo fatto', 'What we did')}</span>
              <ul class="cliente-fatto">{l.fatto.map((f) => <li>{f}</li>)}</ul>
              <a class="btn btn-azione" href={l.url} target="_blank" rel="noopener">{T('Visita', 'Visit')} {dominio} <span class="freccia" aria-hidden="true">↗</span></a>
            </div>
          </div>
        </dialog>
      );
    })}
  </section>

  <!-- DOMANDE -->
  <section class="sezione" id="domande" data-forma="3">
    <div class="wrap">
      <div class="testa-sezione centro">
        <span class="capitolo" data-appare>{T('Domande frequenti', 'Frequently asked questions')}</span>
        {it
          ? <h2 data-righe><span class="riga"><span>Quello che <span class="em">tutti</span> ci chiedono.</span></span></h2>
          : <h2 data-righe><span class="riga"><span>What <span class="em">everyone</span> asks us.</span></span></h2>}
      </div>
      <div class="faq">
        {faq.slice(0, 5).map((f) => (
          <details>
            <summary>{f.d}<span class="piu" aria-hidden="true"></span></summary>
            <p class="risposta">{f.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- RICHIEDI UN PREVENTIVO: niente listino. I tre passi, le garanzie in una riga e i bottoni, in una sezione sola -->
  <section class="sezione finale" id="prezzi" data-forma="4">
    <div class="wrap finale-testo">
      <span class="capitolo" data-appare>{T('Richiedi un preventivo', 'Request a quote')}</span>
      <h2 data-righe>
        <span class="riga riga-nome" data-riga-nome hidden><span><span data-nome></span>,</span></span>
        <span class="riga"><span data-minuscola>{T('Prima ti ascoltiamo.', 'First we listen.')}</span></span>
        <span class="riga"><span><span class="em">{T('Poi il preventivo', 'Then the quote')}</span><span class="quadratino" aria-hidden="true"></span></span></span>
      </h2>
      <p class="lead" data-appare>{T(
        'Ogni azienda è diversa, per questo non trovi listini. Ci racconti cosa ti serve, ci sentiamo e ti mandiamo un preventivo scritto, voce per voce.',
        'Every business is different, so you won’t find a price list. You tell us what you need, we talk, and we send you a written quote, line by line.',
      )}</p>
      <ol class="pv-tappe" data-sequenza>
        {(it ? [
          ['Ci racconti cosa ti serve', 'Due minuti: nome, contatti e due righe sul tuo lavoro.'],
          ['Ti chiamiamo per conoscerci', 'Venti minuti, gratis e senza impegno.'],
          ['Ricevi il preventivo scritto', 'Su misura, voce per voce, con i tempi.'],
        ] : [
          ['Tell us what you need', 'Two minutes: name, contact details and a couple of lines about your work.'],
          ['We call you to get to know you', 'Twenty minutes, free and with no commitment.'],
          ['You get the written quote', 'Tailored, line by line, with timings.'],
        ]).map(([t, d], i) => <li><span class="mono">0{i + 1}</span><b>{t}</b><p>{d}</p></li>)}
      </ol>
      <div class="hero-azioni" data-appare style="justify-content:center">
        <a class="btn btn-azione btn-grande" href={preventivo} data-azione>{T('Richiedi un preventivo', 'Request a quote')} <span class="freccia" aria-hidden="true">→</span></a>
        <a class="btn btn-vetro btn-grande" href={`https://wa.me/${contatti.whatsapp}?text=${encodeURIComponent(waTesto)}`} target="_blank" rel="noopener" data-wa data-wa-testo={waTesto}>{T('Scrivici su WhatsApp', 'Message us on WhatsApp')}</a>
      </div>
      <ul class="rassicura centro" data-appare>
        <li><MicroIcona nome="gratis" />{T('Preventivo gratuito', 'Free quote')}</li>
        <li><MicroIcona nome="chiamata" />{T('Ritocchi finché ti convince', "Tweaks until you're convinced")}</li>
        <li><MicroIcona nome="libero" />{T('Tutto è tuo: codice, dominio, account', 'Everything is yours: code, domain, accounts')}</li>
      </ul>
    </div>
  </section>
</Base>

<script>
  import { serviziVivi } from '../scripts/servizi-vivi.js';
  serviziVivi();
</script>
