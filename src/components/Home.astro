---
// La home in italiano (/) e in inglese (/en/): stessa struttura, testi nella lingua della pagina.
import Base from '../layouts/Base.astro';
import Icona from './Icona.astro';
import PrimaDopo from './PrimaDopo.astro';
import Intruso from './Intruso.astro';
import Bozza from './Bozza.astro';
import LogoGigante from './LogoGigante.astro';
import MicroIcona from './MicroIcona.astro';
import '../styles/chisiamo.css';
import '../styles/recensioni.css';
import '../styles/servizi-vivi.css';
import { metodoStudio } from '../data/metodo.js';
import volto from '../assets/img/gabriele-volto.webp';
import { dati } from '../i18n/dati.js';
import { url, urlServizio } from '../i18n/ui.js';
import { euro } from '../data/formato.js';

interface Props { lang?: 'it' | 'en' }
const { lang = 'it' } = Astro.props;
const it = lang === 'it';
const T = (a: string, b: string) => (it ? a : b);
const { servizi, metodo, lavori, faq, contatti } = dati(lang);
const iniziali = (nome: string) => nome.replace(/^Dott\.\s*/, '').split(' ').map((p) => p[0]).slice(0, 2).join('');
const eur = (n: number) => euro(n, lang);
const preventivo = url('preventivo', lang);

// i servizi sul telefono: una riga sola per scheda
const brevi: Record<string, string> = it
  ? { sito: 'Ti trovano su Google e ti scrivono.', ecommerce: 'Vendi 24 ore su 24, anche mentre dormi.', software: 'Il lavoro ripetitivo si fa da solo.', gestionale: 'Il programma fatto come lavori tu.', ads: 'Annunci che portano clienti, non solo «mi piace».', cura: 'Sempre aggiornato, sicuro e più efficace.' }
  : { sito: 'People find you on Google and get in touch.', ecommerce: 'Sell 24/7, even while you sleep.', software: 'Repetitive work does itself.', gestionale: 'Software built around how you work.', ads: 'Ads that bring clients, not just likes.', cura: 'Always updated, secure and improving.' };
// 12 · tipografia cinetica: tre righe giganti al posto del nastro
const cinetica = it
  ? [['Siti web', 'Negozi online', 'Automazioni e AI', 'Gestionali'], ['Attenzione', 'Interesse', 'Fiducia', 'Desiderio', 'Azione'], ['Neuromarketing', 'Meta Ads', 'Google Ads', 'TikTok Ads', 'Copy che vende']]
  : [['Websites', 'Online stores', 'AI & automation', 'Custom software'], ['Attention', 'Interest', 'Trust', 'Desire', 'Action'], ['Neuromarketing', 'Meta Ads', 'Google Ads', 'TikTok Ads', 'Copy that sells']];
// 01 · le parole che il cursore scrive in fondo al titolo
const scrive = it ? 'sceglie,scrive,chiama,compra' : 'clients,buyers,bookings,fans';

// Il calcolatore: lavori sempre uguali, cosa fa l'AI al posto tuo, ore a settimana (stima prudente)
const ripetitivi: [string, string, number][] = it ? [
  ['Rispondere sempre alle stesse domande', 'Un assistente risponde da solo su WhatsApp, email e sito, anche di notte.', 3],
  ['Copiare dati da email e moduli a Excel o al gestionale', 'I dati passano da soli dove servono, senza copia e incolla.', 3],
  ['Preparare i preventivi', 'La bozza si scrive da sola con i tuoi prezzi: tu la controlli e la mandi.', 2],
  ['Fissare appuntamenti e mandare promemoria', 'Il cliente sceglie l’orario libero, il promemoria parte da solo.', 2],
  ['Leggere e smistare le email', 'Ogni email viene letta, divisa per tipo e girata alla persona giusta.', 2],
  ['Cercare documenti e informazioni', 'Chiedi «dov’è il contratto di Rossi?» e lo trovi in un secondo.', 2],
  ['Scrivere post, annunci e descrizioni', 'Testi nel tuo stile pronti in un minuto: tu li rileggi.', 2],
  ['Fare fatture e ricordare i pagamenti', 'Le fatture si preparano dagli ordini, i solleciti partono da soli.', 1.5],
  ['Inserire ordini e controllare il magazzino', 'Gli ordini entrano da soli e ti avvisa prima che un prodotto finisca.', 2],
  ['Fare report e riepiloghi', 'Il lunedì ti arriva il riepilogo della settimana, in parole semplici.', 1.5],
] : [
  ['Answering the same questions again and again', 'An assistant replies on its own on WhatsApp, email and your site, even at night.', 3],
  ['Copying data from emails and forms into Excel or your software', 'The data goes where it needs to on its own, no copy and paste.', 3],
  ['Preparing quotes', 'The draft writes itself with your prices: you check it and send it.', 2],
  ['Booking appointments and sending reminders', 'The client picks a free slot, the reminder goes out by itself.', 2],
  ['Reading and sorting emails', 'Every email is read, sorted by type and passed to the right person.', 2],
  ['Looking for documents and information', 'Ask "where is Rossi’s contract?" and find it in a second.', 2],
  ['Writing posts, ads and descriptions', 'Copy in your style ready in a minute: you read it over.', 2],
  ['Invoicing and chasing payments', 'Invoices are drawn up from orders, reminders go out on their own.', 1.5],
  ['Entering orders and checking stock', 'Orders come in by themselves and it warns you before a product runs out.', 2],
  ['Writing reports and summaries', 'Every Monday the week’s summary arrives, in plain words.', 1.5],
];

const waTesto = T('Ciao! Ho visto il sito di Desideri&Code e vorrei parlarvi di un progetto.', "Hi! I saw the Desideri&Code website and I'd like to talk to you about a project.");
const descrizione = T(
  'Siti web, e-commerce, software con intelligenza artificiale e pubblicità online progettati con psicologia e neuromarketing.',
  'Websites, e-commerce, AI software and online advertising designed with psychology and neuromarketing.',
);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: contatti.studio,
  founder: { '@type': 'Person', name: contatti.nome, jobTitle: T('Fondatore', 'Founder') },
  description: descrizione,
  url: new URL(url('home', lang), Astro.site).toString(),
  email: contatti.email,
  telephone: contatti.telefono,
  areaServed: ['IT', 'CH'],
  inLanguage: lang,
  address: { '@type': 'PostalAddress', addressLocality: 'Milano', addressCountry: 'IT' },
  sameAs: [contatti.linkedin],
};
---
<Base
  lang={lang}
  path={url('home', lang)}
  alt={url('home', it ? 'en' : 'it')}
  title={T('Desideri&Code · Siti web, AI e pubblicità che portano clienti', 'Desideri&Code · Websites, AI and ads that bring clients')}
  description={T(
    'Siti web, e-commerce, software con intelligenza artificiale e pubblicità online, progettati con la psicologia per portare le persone dal primo sguardo al «sì». Milano, Italia e Svizzera.',
    'Websites, e-commerce, AI software and online advertising, designed with psychology to take people from first glance to "yes". Based in Milan, working across Italy and Switzerland.',
  )}
  jsonLd={jsonLd}
>
  <!-- il percorso: linea di luce che collega i cinque capitoli (solo schermi larghi) -->
  <nav class="guida" aria-label={T('Capitoli', 'Chapters')} data-percorso>
    <span class="guida-luce" aria-hidden="true"></span>
    {(it
      ? [['inizio', 'Guarda'], ['servizi', 'Scegli'], ['metodo', 'Fidati'], ['prezzi', 'Chiedi'], ['azione', 'Scrivici']]
      : [['inizio', 'Look'], ['servizi', 'Choose'], ['metodo', 'Trust'], ['prezzi', 'Ask'], ['azione', 'Write to us']]
    ).map(([id, nome], i) => <a href={`#${id}`} data-capitolo={id}><span>{String(i + 1).padStart(2, '0')} · {nome}</span></a>)}
  </nav>

  <!-- 01 · ATTENZIONE -->
  <section class="hero" id="inizio" data-forma="0">
    <LogoGigante />
    <div class="griglia-magnetica" data-griglia-magnetica aria-hidden="true"></div>
    <div class="wrap">
      <div class="hero-testo">
        {/* a destra: il sito che nasce dal codice e, sotto, la citazione (sempre staccata, mai coperta) */}
        <div class="hero-spazio-occhio">
          <Bozza lang={lang} />
        <div class="didascalia">
          {/* una citazione: le virgolette grandi, la frase, e la seconda parte che chiude in grassetto */}
          <blockquote class="didascalia-testo">
            <p>{T("L'attenzione è la moneta più preziosa di oggi.", "Attention is today's most valuable currency.")} <b>{T('Chi la cattura, vince.', 'Whoever captures it, wins.')}</b></p>
          </blockquote>
        </div>
        </div>
        <span class="capitolo" data-appare>{T('01 · Guarda', '01 · Look')}</span>
        {it ? (
          <h1 data-righe>
            <span class="riga riga-nome" data-riga-nome hidden><span><span data-saluto></span><span data-nome></span>,</span></span>
            <span class="riga"><span data-minuscola>Trasformiamo</span></span>
            <span class="riga"><span>chi ti guarda</span></span>
            <span class="riga"><span>in chi ti <span class="sr-only">sceglie.</span><span class="parola-punto" data-scrive={scrive} aria-hidden="true"><span class="scrive-testo">sceglie</span><span class="quadratino"></span></span></span></span>
          </h1>
        ) : (
          <h1 data-righe>
            <span class="riga riga-nome" data-riga-nome hidden><span><span data-saluto></span><span data-nome></span>,</span></span>
            <span class="riga"><span>We turn</span></span>
            <span class="riga"><span>attention</span></span>
            <span class="riga"><span>into <span class="sr-only">clients.</span><span class="parola-punto" data-scrive={scrive} aria-hidden="true"><span class="scrive-testo">clients</span><span class="quadratino"></span></span></span></span>
          </h1>
        )}
        {it ? (
          <p class="lead" data-appare="0.25">
            <a class="parola-iride" href="#servizi">Siti web</a>, <a class="parola-iride" href="#servizi">negozi online</a>, <a class="parola-iride" href="#servizi">software con intelligenza artificiale</a> e <a class="parola-iride" href="#servizi">pubblicità</a>.
            Progettati con la psicologia per portare le persone <strong style="color:var(--latte);font-weight:600">dal primo sguardo al «sì»</strong>.
          </p>
        ) : (
          <p class="lead" data-appare="0.25">
            <a class="parola-iride" href="#servizi">Websites</a>, <a class="parola-iride" href="#servizi">online stores</a>, <a class="parola-iride" href="#servizi">AI software</a> and <a class="parola-iride" href="#servizi">advertising</a>.
            Designed with psychology to take people <strong style="color:var(--latte);font-weight:600">from first glance to "yes"</strong>.
          </p>
        )}
        <div class="hero-azioni" data-appare="0.4">
          <a class="btn btn-azione btn-grande" href={preventivo} data-azione>{T('Richiedi un preventivo', 'Request a quote')} <span class="freccia" aria-hidden="true">→</span></a>
          <a class="btn btn-vetro btn-grande" href="#metodo">{T('Guarda come funziona', 'See how it works')}</a>
        </div>
        <ul class="rassicura" data-appare="0.55">
          <li><MicroIcona nome="tempo" />{T('Preventivo scritto, su misura', 'Written, tailored quote')}</li>
          <li><MicroIcona nome="risposta" />{T('Risposta entro 24 ore', 'Reply within 24 hours')}</li>
          <li><MicroIcona nome="luogo" />{contatti.zona}</li>
        </ul>
      </div>
    </div>
    <a class="scorri" href="#problema" aria-label={T('Scorri', 'Scroll')}>
      <span class="mono">{T('Scorri', 'Scroll')}</span>
      <span class="scorri-linea"></span>
    </a>
  </section>

  <div class="cinetica" data-cinetica aria-hidden="true">
    {cinetica.map((riga, r) => (
      <div class={`cinetica-riga ${r === 1 ? 'cinetica-dx cinetica-vuota' : 'cinetica-sx'}`}>
        <div>{[0, 1].map(() => <span>{riga.map((p, k) => <>{r === 2 && k === 0 ? <span class="cinetica-rossa">{p}</span> : p}<span class="q"></span></>)}</span>)}</div>
      </div>
    ))}
  </div>

  <!-- IL PROBLEMA -->
  <section class="sezione" id="problema" data-forma="0">
    <div class="wrap">
      <div class="testa-sezione">
        <span class="capitolo" data-appare>{T('Il problema', 'The problem')}</span>
        {it ? (
          <h2 data-righe>
            <span class="riga"><span>Un sito bello non basta.</span></span>
            <span class="riga"><span>Deve far venire <span class="em">voglia</span></span></span>
            <span class="riga"><span>di sceglierti.</span></span>
          </h2>
        ) : (
          <h2 data-righe>
            <span class="riga"><span>A beautiful site isn't enough.</span></span>
            <span class="riga"><span>It has to make people <span class="em">want</span></span></span>
            <span class="riga"><span>to choose you.</span></span>
          </h2>
        )}
      </div>
      <!-- i tre problemi: la giornata di un cliente, due volte. «Oggi» ti perde, «Con noi» ti scrive (vita.js, giornata) -->
      <div class="giornata" data-giornata>
        <div class="gi-interruttore" role="group" aria-label={T('Scegli la giornata', 'Choose the day')}>
          <i aria-hidden="true"></i>
          <button type="button" class="on" aria-pressed="true" data-lato="oggi">{T('Oggi', 'Today')}</button>
          <button type="button" aria-pressed="false" data-lato="noi">{T('Con noi', 'With us')}</button>
        </div>
        <ol class="gi-momenti" role="list">
          {(it ? [
            ['09:12', 'Cerca', 'Trova prima un altro.', 'Sei a pagina 3 di Google.', 'Trova te, per primo.', 'In cima a Google, nella sua zona.'],
            ['09:14', 'Apre il sito', 'Lo chiude dopo 4 secondi.', 'Lento, e non si capisce cosa fai.', 'Capisce in 3 secondi.', 'Cosa fai, per chi e quanto costa.'],
            ['21:40', 'Ci ripensa', 'Non ti scrive.', 'Nessun bottone chiaro: rimanda.', 'Ti scrive su WhatsApp.', 'Un tocco, messaggio già pronto.'],
          ] : [
            ['09:12', 'Searches', 'Finds someone else first.', "You're on page 3 of Google.", 'Finds you, first.', 'Top of Google, in their area.'],
            ['09:14', 'Opens the site', 'Closes it after 4 seconds.', "Slow, and it's unclear what you do.", 'Gets it in 3 seconds.', 'What you do, for whom and what it costs.'],
            ['21:40', 'Thinks it over', "Doesn't write to you.", 'No clear button: puts it off.', 'Messages you on WhatsApp.', 'One tap, message already written.'],
          ]).map(([ora, cosa, oggi, oggiPerche, noi, noiPerche]) => (
            <li class="gi-momento">
              <span class="gi-ora">{ora} · {cosa}<span class="gi-esito" aria-hidden="true"></span></span>
              <span class="gi-stato gi-oggi"><b>{oggi}</b><span>{oggiPerche}</span></span>
              <span class="gi-stato gi-noi"><b>{noi}</b><span>{noiPerche}</span></span>
            </li>
          ))}
        </ol>
      </div>
      <div class="svolta-riga">
        <p class="svolta" data-appare>
          {T('Noi costruiamo quel percorso.', 'We build that path.')} <span class="em em-percorso">{T('Dal primo sguardo al sì.', 'From first glance to yes.')}</span>
        </p>
        <PrimaDopo lang={lang} />
      </div>
    </div>
  </section>

  <!-- 02 · INTERESSE -->
  <section class="sezione" id="servizi" data-forma="1">
    <div class="wrap">
      <div class="testa-sezione testa-riga">
        <span class="capitolo" data-appare>{T('02 · Scegli', '02 · Choose')}</span>
        <h2 data-righe>
          <span class="riga"><span>{T('Cosa facciamo,', 'What we do,')}</span></span>
          <span class="riga"><span><span class="em">{T('detto semplice.', 'in plain words.')}</span></span></span>
        </h2>
        <p class="lead" data-appare>{T(
          'Sei servizi che lavorano insieme. Puoi sceglierne uno solo o farli parlare tra loro: è lì che i risultati si moltiplicano.',
          "Six services that work together. Pick just one or let them talk to each other: that's where results multiply.",
        )}</p>
      </div>
      <!-- i servizi in movimento (servizi-vivi.js): sul computer l'indice e l'anteprima, sul telefono i nomi sopra e le schede da scorrere -->
      <div class="sv" data-servizi-vivi data-lang={lang}>
        <div class="sv-pc">
          <nav class="sv-lista" aria-label={T('Servizi', 'Services')}>
            {servizi.map((s) => (
              <a class="sv-voce" href={urlServizio(s.id, lang)} data-id={s.id} data-titolo={s.titolo} data-testo={s.semplice}>
                <span class="mono">{s.numero}</span><span class="servizio-icona"><Icona nome={s.icona} /></span><b>{s.titolo}</b><span class="freccia" aria-hidden="true">→</span>
              </a>
            ))}
          </nav>
          <div class="sv-anteprima" aria-hidden="true">
            <div class="sv-st" data-sv-palco></div>
            <div class="sv-info"><div><b data-sv-titolo></b><p data-sv-testo></p></div><a class="link-freccia" href={urlServizio(servizi[0].id, lang)} data-sv-scopri tabindex="-1">{T('Scopri', 'Discover')} <span class="freccia">→</span></a></div>
          </div>
        </div>
        <div class="sv-tel">
          <div class="sv-chips">{servizi.map((s, i) => <button class="sv-chip" type="button" aria-pressed={i === 0 ? 'true' : 'false'}><i></i>{s.titolo}</button>)}</div>
          <div class="sv-fila" data-sv-fila>
            {servizi.map((s) => (
              <article class="sv-scheda">
                <div class="sv-st" data-sv-scena={s.id} aria-hidden="true"></div>
                <div class="sv-corpo">
                  <div class="sv-riga1"><h3><a href={urlServizio(s.id, lang)}>{s.titolo}</a></h3><span class="mono">{s.numero} / 0{servizi.length}</span></div>
                  <p>{brevi[s.id] || s.semplice}</p>
                  <span class="link-freccia" aria-hidden="true">{T('Scopri', 'Discover')} <span class="freccia">→</span></span>
                </div>
              </article>
            ))}
          </div>
          <div class="sv-sotto"><span class="sv-hint">{T('Scorri o tocca un nome', 'Swipe or tap a name')} <i aria-hidden="true">→</i></span><span class="sv-conta" data-sv-conta><b>01</b> / 0{servizi.length}</span></div>
          <div class="sv-linea" data-sv-linea style={`--n:${servizi.length}`}><b></b></div>
        </div>
      </div>
    </div>
  </section>

  <!-- SOFTWARE CON AI: un assaggio che incuriosisce; il calcolo si fa in tre passi in una finestra -->
  <section class="sezione" id="risparmio" data-forma="1">
    <div class="wrap risparmio">
      <div class="testa-sezione" style="margin-bottom:0">
        <span class="capitolo" data-appare>{T('Automazioni e AI', 'AI & automation')}</span>
        {it ? (
          <h2 data-righe>
            <span class="riga"><span>Quante ore ti rubano</span></span>
            <span class="riga"><span>i lavori <span class="em">sempre uguali?</span></span></span>
          </h2>
        ) : (
          <h2 data-righe>
            <span class="riga"><span>How much time goes</span></span>
            <span class="riga"><span>on <span class="em">the same old jobs?</span></span></span>
          </h2>
        )}
        <p class="lead" data-appare>{T(
          'Rispondere alle stesse domande, copiare dati, preparare preventivi. Un software con l’intelligenza artificiale lo fa al posto tuo, anche di notte. Scopri in un minuto quanto tempo e quanti soldi ti restituisce.',
          'Answering the same questions, copying data, preparing quotes. Software with artificial intelligence does it for you, even at night. Find out in a minute how much time and money it gives back.',
        )}</p>
        <div class="hero-azioni" data-appare>
          <button class="btn btn-azione btn-grande" type="button" data-calcolo-apri>{T('Calcola quanto risparmi', 'Work out what you save')} <span class="freccia" aria-hidden="true">→</span></button>
          <a class="link-freccia" href={url('demo', lang)}>{T('Guarda le demo dal vivo', 'See the live demos')} <span class="freccia" aria-hidden="true">→</span></a>
        </div>
      </div>
      <!-- l'assaggio: cosa ha fatto da solo il software stanotte -->
      <div class="stanotte" data-stanotte>
        <!-- un telefono pieghevole: parte chiuso con le notifiche del mattino, poi si apre come un libro e a sinistra compare il sito del cliente (vita.js, notifiche) -->
        <!-- il telefono pieghevole in 3D: la metà destra è ferma; la metà sinistra è un'anta con due facce,
             fuori lo schermo esterno (la prima notifica), dentro il sito. Da chiuso l'anta sta piegata sopra la metà destra;
             dopo la prima notifica ruota sulla cerniera e il telefono si apre (vita.js, notifiche) -->
        <div class="st-fold" aria-hidden="true"><div class="sf-corpo">
          <i class="sf-strato sf-base" style="--z:1"></i><i class="sf-strato sf-base" style="--z:2"></i><i class="sf-strato sf-base" style="--z:3"></i><i class="sf-strato sf-base" style="--z:4"></i>
          <div class="sf-meta sf-destra"><div class="sf-vetro">
          <div class="sf-barra"><span class="sf-icone"><i class="sf-rete"><b></b><b></b><b></b><b></b></i><svg class="sf-wifi" viewBox="0 0 16 12" aria-hidden="true"><path d="M8 11.5 5.6 9a3.4 3.4 0 0 1 4.8 0Zm-4.3-4.3a6 6 0 0 1 8.6 0l-1.3 1.3a4.2 4.2 0 0 0-6 0ZM1 4.5a9.9 9.9 0 0 1 14 0l-1.3 1.3a8.1 8.1 0 0 0-11.4 0Z" fill="currentColor"/></svg><i class="sf-batteria"></i></span></div>
          <div class="sf-dx">
            <span class="st-ora-grande">06:00</span>
            <span class="st-giorno">{T('Lunedì · la sveglia suona', 'Monday · the alarm goes off')}</span>
            <ul class="st-notifiche">
              {(it ? [
                ['23:47', 'Risposto a Laura, che chiedeva un preventivo'],
                ['01:12', 'Copiato 12 ordini nel gestionale'],
                ['03:30', 'Preparato 3 preventivi da approvare'],
                ['06:00', 'Mandato i promemoria degli appuntamenti di oggi'],
              ] : [
                ['23:47', 'Replied to Laura, who asked for a quote'],
                ['01:12', 'Copied 12 orders into your software'],
                ['03:30', 'Drafted 3 quotes for you to approve'],
                ['06:00', 'Sent the reminders for today’s appointments'],
              ]).map(([ora, cosa], i) => <li style={`--i:${i}`}><i class="st-app"></i><b>{T('Il tuo software', 'Your software')}</b><small>{ora}</small><span>{cosa}</span></li>)}
            </ul>
          </div>
          <span class="sf-camera"><i></i></span>
          </div></div>
          <div class="sf-anta">
            <div class="sf-faccia sf-fronte"><div class="sf-vetro">
              <div class="sf-barra sf-barra-sito"></div>
          <!-- il sito del cliente: un vero sito di cucine, con la chat piccola nell'angolo che si apre da sola -->
          <div class="sf-sx">
            <div class="sf-sito-testa"><b>Arredi Conti<i></i></b><span class="sf-menu"><i></i><i></i></span></div>
            <div class="sf-foto con-foto">
              <span class="sf-chip">★ 4,9 · {T('312 cucine montate', '312 kitchens fitted')}</span>
              <b>{T('La cucina che hai in mente, in 30 giorni.', 'The kitchen you have in mind, in 30 days.')}</b>
              <span class="sf-btn">{T('Progettala con noi', 'Design it with us')} →</span>
            </div>
            <div class="sf-modelli">
              {(it ? [['Sole', 'da 6.800 €'], ['Brera', 'da 8.400 €'], ['Lago', 'da 9.900 €']] : [['Sole', 'from €6,800'], ['Brera', 'from €8,400'], ['Lago', 'from €9,900']]).map(([n, pz], k) => (
