            <!-- la chat: prima il bottoncino tondo, poi si apre, Laura scrive, il software scrive e risponde, il preventivo parte -->
            <div class="sf-chat" data-sf-chat>
              <span class="sf-lancia" aria-hidden="true"><i></i></span>
              <div class="sf-finestra">
                <small><i></i>{T('Arredi Conti · 23:46', 'Arredi Conti · 11:46 pm')}</small>
                <p class="sf-lei" data-sf-passo="900">{T('Quanto costa una cucina di 3 metri?', 'How much is a 3-metre kitchen?')}</p>
                <p class="sf-scrive" data-sf-passo="1600" data-sf-via="2500"><i></i><i></i><i></i></p>
                <p class="sf-lui" data-sf-passo="2500">{T('Ciao Laura! La Sole da 6.800 €, posa inclusa.', 'Hi Laura! The Sole from €6,800, fitting included.')}</p>
                <span class="sf-fatto" data-sf-passo="3400">✓ {T('Preventivo inviato', 'Quote sent')}</span>
              </div>
            </div>
          </div>
            </div></div>
            <div class="sf-faccia sf-retro"><div class="sf-vetro">
              <div class="sf-barra"><span class="sf-icone"><i class="sf-rete"><b></b><b></b><b></b><b></b></i><svg class="sf-wifi" viewBox="0 0 16 12" aria-hidden="true"><path d="M8 11.5 5.6 9a3.4 3.4 0 0 1 4.8 0Zm-4.3-4.3a6 6 0 0 1 8.6 0l-1.3 1.3a4.2 4.2 0 0 0-6 0ZM1 4.5a9.9 9.9 0 0 1 14 0l-1.3 1.3a8.1 8.1 0 0 0-11.4 0Z" fill="currentColor"/></svg><i class="sf-batteria"></i></span></div>
              <div class="sf-dx sf-esterno">
                <span class="st-ora-grande">06:00</span>
                <span class="st-giorno">{T('Lunedì · la sveglia suona', 'Monday · the alarm goes off')}</span>
                <ul class="st-notifiche"><li data-sf-esterna><i class="st-app"></i><b>{T('Il tuo software', 'Your software')}</b><small>23:47</small><span>{T('Risposto a Laura, che chiedeva un preventivo', 'Replied to Laura, who asked for a quote')}</span></li></ul>
              </div>
              <span class="sf-camera"><i></i></span>
            </div></div>
            <i class="sf-strato" style="--z:1"></i><i class="sf-strato" style="--z:2"></i><i class="sf-strato" style="--z:3"></i>
          </div>
        </div></div>
        <p class="sr-only">{T('Stanotte, mentre dormivi, il tuo software ha risposto a Laura che chiedeva un preventivo, copiato 12 ordini nel gestionale, preparato 3 preventivi da approvare e mandato i promemoria degli appuntamenti di oggi.', 'Last night, while you slept, your software replied to Laura who asked for a quote, copied 12 orders, drafted 3 quotes and sent today’s appointment reminders.')}</p>
        <button class="st-domanda" type="button" data-calcolo-apri>
          <span>{T('E a te quante ore restituirebbe?', 'And how many hours would it give you back?')}</span>
          <strong>{T('Calcolalo in 1 minuto', 'Work it out in 1 minute')} →</strong>
        </button>
      </div>
    </div>
  </section>

  <!-- Il calcolo in tre passi: cosa fai a mano, quanto vale, il preventivo -->
  <dialog class="calcolo" data-calcolo data-lang={lang} aria-labelledby="calcolo-titolo" data-lenis-prevent>
    <div class="cl-box">
      <div class="cl-testa">
        <span class="mono" id="calcolo-titolo">{T('Quanto ti fa risparmiare', 'What it saves you')}</span>
        <span class="cl-passi" aria-hidden="true"><i class="attivo"></i><i></i><i></i></span>
        <button class="cl-chiudi" type="button" data-calcolo-chiudi aria-label={T('Chiudi', 'Close')}>×</button>
      </div>

      <section class="cl-passo" data-cl-passo="1">
        <h3>{T('Cosa fai ancora a mano?', 'What do you still do by hand?')}</h3>
        <p class="cl-sotto">{T('Spunta i lavori che fai tu o il tuo team. Sotto ognuno, cosa farebbe l’AI al posto tuo.', 'Tick the jobs you or your team do. Under each one, what AI would do for you.')}</p>
        <fieldset class="ripetitivi">
          <legend class="sr-only">{T('Lavori ripetitivi', 'Repetitive jobs')}</legend>
          {ripetitivi.map(([titolo, ai, ore]) => (
            <label class="rip">
              <input type="checkbox" value={ore} data-rip data-titolo={titolo} />
              <span class="rip-spunta" aria-hidden="true"></span>
              <span class="rip-titolo">{titolo}</span>
              <span class="rip-ore">{String(ore).replace('.', it ? ',' : '.')} h</span>
              <span class="rip-ai">{ai}</span>
            </label>
          ))}
        </fieldset>
        <div class="cl-piede">
          <p class="cl-conto" aria-live="polite"><output data-out="ore">0</output> {T('ore a settimana, a persona', 'hours a week, per person')}</p>
          <button class="btn btn-azione" type="button" data-cl-vai="2" disabled>{T('Avanti', 'Next')} <span class="freccia" aria-hidden="true">→</span></button>
        </div>
      </section>

      <section class="cl-passo" data-cl-passo="2" hidden>
        <h3>{T('Quanto vale per te?', 'What is it worth to you?')}</h3>
        <p class="cl-sotto">{T('Due numeri e vedi quanto tempo e quanti soldi ti restituisce in un anno.', 'Two numbers and you see how much time and money it gives back in a year.')}</p>
        <div class="cursore-campo">
          <label for="r-persone">{T('Persone che fanno questi lavori', 'People doing these jobs')} <output data-out="persone">3</output></label>
          <input id="r-persone" type="range" min="1" max="30" value="3" data-in="persone" />
        </div>
        <div class="cursore-campo">
          <label for="r-costo">{T("Costo di un'ora di lavoro", 'Cost of one hour of work')} <output data-out="costo">{eur(25)}</output></label>
          <input id="r-costo" type="range" min="12" max="80" value="25" data-in="costo" />
        </div>
        <div class="risultati" aria-live="polite">
          <div class="risultato"><strong data-ris="ore">0</strong><span>{T('ore restituite in un anno', 'hours given back each year')}</span></div>
          <div class="risultato caldo"><strong data-ris="euro">{eur(0)}</strong><span>{T('di lavoro risparmiato ogni anno', 'of work saved every year')}</span></div>
        </div>
        <p class="nota">{T('Stima prudente: 46 settimane di lavoro e solo il 60% di quelle ore. Il numero vero lo misuriamo insieme nella Diagnosi AI.', 'A cautious estimate: 46 working weeks and only 60% of those hours. We measure the real number together in the AI diagnosis.')}</p>
        <div class="cl-piede">
          <button class="btn btn-vetro" type="button" data-cl-vai="1"><span aria-hidden="true">←</span> {T('Indietro', 'Back')}</button>
          <button class="btn btn-azione" type="button" data-cl-vai="3">{T('Voglio recuperarlo', 'I want it back')} <span class="freccia" aria-hidden="true">→</span></button>
        </div>
      </section>

      <section class="cl-passo cl-fine" data-cl-passo="3" hidden>
        <h3><span data-ris="ore-testo"></span> <span class="em em-firma">{T('di nuovo tue.', 'yours again.')}</span></h3>
        <p class="cl-sotto">{T('Ecco cosa automatizzeremmo per te. Lo trovi già scritto nella richiesta di preventivo: ti rispondiamo entro 24 ore.', 'Here is what we would automate for you. It is already written in the quote request: we reply within 24 hours.')}</p>
        <ul class="lista-check" data-cl-scelti></ul>
        <p class="cl-tuo">{T('Il software te lo consegniamo pronto e resta tuo, con i tuoi dati.', 'We hand the software over ready, and it stays yours, with your data.')}</p>
        <div class="cl-piede">
          <a class="btn btn-azione btn-grande" href={`${preventivo}?s=software`} data-azione>{T('Richiedi il preventivo', 'Request a quote')} <span class="freccia" aria-hidden="true">→</span></a>
          <a class="btn btn-vetro" href={`https://wa.me/${contatti.whatsapp}`} target="_blank" rel="noopener" data-cl-wa>{T('Scrivici su WhatsApp', 'Message us on WhatsApp')}</a>
        </div>
        <button class="cl-indietro" type="button" data-cl-vai="2">{T('Cambia i numeri', 'Change the numbers')}</button>
      </section>
    </div>
  </dialog>

  <!-- 03 · IL METODO: i cinque passi. Scorrendo si accende un numero alla volta (rosso) e a destra entra il suo passo (vita.js, metodoNumeri) -->
  <section class="sezione" id="metodo" data-forma="2">
    <div class="wrap">
      <div class="testa-sezione">
        <span class="capitolo">{T('03 · Fidati', '03 · Trust')}</span>
        {it ? (
          <h2 data-righe>
            <span class="riga"><span>Cinque passi nella testa</span></span>
            <span class="riga"><span>del <span class="em em-firma">tuo cliente.</span></span></span>
          </h2>
        ) : (
          <h2 data-righe>
            <span class="riga"><span>Five steps inside</span></span>
            <span class="riga"><span><span class="em em-firma">your client's mind.</span></span></span>
          </h2>
        )}
        <p class="lead">{T(
          'Le cinque tappe che ogni persona attraversa prima di comprare. Per ognuna usiamo tecniche studiate dalla psicologia e provate sul campo.',
          'The five stages everyone goes through before buying. For each one we use techniques studied by psychology and tested in the field.',
        )}</p>
      </div>
    </div>
    <div class="metodo-pista" data-metodo>
      <div class="metodo-palco wrap">
        <ol class="metodo-numeri" aria-hidden="true">
          {metodo.map((_, i) => <li class={i === 0 ? 'on' : ''}>{String(i + 1).padStart(2, '0')}</li>)}
        </ol>
        <div class="metodo-passi">
          {metodo.map((m, i) => (
            <article class={`passo${i === 0 ? ' on' : ''}`}>
              <span class="passo-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="capitolo">{String(i + 1).padStart(2, '0')} · {m.passo}</span>
              {/* il verbo del passo è sottolineato: la linea si allunga mentre scorri il passo (vita.js, metodoNumeri) */}
              <h3>{(() => { const k = m.verbo ? m.titolo.indexOf(m.verbo) : -1; return k < 0 ? m.titolo : <>{m.titolo.slice(0, k)}<span class="verbo">{m.verbo}</span>{m.titolo.slice(k + m.verbo.length)}</>; })()}</h3>
              <p class="passo-testa">{m.testa}</p>
              {/* il nome della tecnica si vede sempre; la spiegazione la apre solo chi è curioso */}
              <details class="passo-tecnica">
                <summary>
                  <span class="pt-nome mono">{T('Tecnica', 'Technique')} · <b>{m.tecnica}</b></span>
                  <span class="pt-vedi"><span class="pt-piu" aria-hidden="true"></span><span class="pt-apri">{T('Vedi la spiegazione', 'See the explanation')}</span><span class="pt-chiudi">{T('Chiudi', 'Close')}</span></span>
                </summary>
                <p class="pt-corpo">{m.spiega}</p>
              </details>
              {i === 0 && <Intruso lang={lang} />}
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PARLANO DI NOI: le recensioni dei clienti in una fila che scorre da sola (vita.js, data-fila).
       Cliccandone una si apre il progetto: il sito, cosa abbiamo fatto e il link per guardarlo dal vivo.
       Finché un cliente non ha scritto la sua recensione, al suo posto c'è la sfida del progetto (data/sito.js, lavori) -->
  <section class="sezione" id="lavori" data-forma="2">
    <div class="wrap">
      <div class="testa-sezione testa-riga">
        <span class="capitolo" data-appare>{T('Parlano di noi', 'What clients say')}</span>
        <h2 data-righe>
          <span class="riga"><span>{T('Clienti veri,', 'Real clients,')}</span></span>
          <span class="riga"><span><span class="em">{T('siti veri.', 'real websites.')}</span></span></span>
        </h2>
        <p class="lead" data-appare>{T(
          'Sono online e lavorano ogni giorno per loro. Tocca una scheda per vedere il progetto e aprire il sito dal vivo.',
          'They are live and working for them every day. Tap a card to see the project and open the live site.',
        )}</p>
      </div>
      <ul class="recensioni" role="list" data-fila data-recensioni data-appare>
        {lavori.map((l) => (
          <li>
            <button class="recensione" type="button" data-recensione={l.id} aria-haspopup="dialog">
              <span class="rc-testa">
                {l.voto
                  ? <span class="rc-stelle" role="img" aria-label={T(`${l.voto} stelle su 5`, `${l.voto} out of 5 stars`)}>{[1, 2, 3, 4, 5].map((n) => <i class={n <= l.voto ? 'piena' : ''}></i>)}</span>
                  : <span class="mono">{T('La sfida', 'The challenge')}</span>}
                <span class="rc-virgolette" aria-hidden="true">“</span>
              </span>
              <span class={l.recensione ? 'rc-testo' : 'rc-testo rc-sfida'}>{l.recensione ? `«${l.recensione}»` : l.sfida}</span>
              <span class="rc-firma">
                {l.logo
                  ? <img src={l.logo} alt="" width="42" height="42" loading="lazy" decoding="async" />
                  : <span class="cliente-iniziali" aria-hidden="true">{iniziali(l.cliente)}</span>}
                <span><strong>{l.cliente}</strong><small>{l.settore}</small></span>
              </span>
              <span class="rc-piede"><span class="pacchetto-tag">{l.pacchetto}</span><span class="rc-apri">{T('Vedi il progetto', 'See the project')} <span class="freccia" aria-hidden="true">→</span></span></span>
            </button>
          </li>
        ))}
      </ul>
    </div>
    {lavori.map((l) => {
      const dominio = new URL(l.url).hostname.replace(/^www\./, '');
      return (
        <dialog class="rc-dialogo" data-recensione-dialogo={l.id} aria-label={l.cliente} data-lenis-prevent>
          <div class="rc-box">
            <button class="cl-chiudi rc-chiudi" type="button" data-rc-chiudi aria-label={T('Chiudi', 'Close')}>×</button>
            <a class="cliente-anteprima" href={l.url} target="_blank" rel="noopener" aria-label={T(`Apri il sito di ${l.cliente}`, `Open ${l.cliente}'s website`)}>
              <span class="browser" aria-hidden="true"><i></i><i></i><i></i><span>{dominio}</span></span>
              <img src={l.img} alt={T(`La home del sito di ${l.cliente}`, `The home page of ${l.cliente}'s website`)} width="1440" height="900" loading="lazy" decoding="async" />
              <span class="cliente-guarda" aria-hidden="true">{T('Guarda il sito', 'View the site')} ↗</span>
            </a>
            <div class="rc-corpo">
              {l.voto && <span class="rc-stelle" role="img" aria-label={T(`${l.voto} stelle su 5`, `${l.voto} out of 5 stars`)}>{[1, 2, 3, 4, 5].map((n) => <i class={n <= l.voto ? 'piena' : ''}></i>)}</span>}
              {l.recensione
                ? <blockquote class="cliente-citazione">«{l.recensione}»</blockquote>
                : <p class="cliente-sfida"><span class="mono">{T('La sfida', 'The challenge')}</span>{l.sfida}</p>}
              <div class="cliente-firma">
                {l.logo
                  ? <img class="cliente-logo" src={l.logo} alt="" width="42" height="42" loading="lazy" decoding="async" />
                  : <span class="cliente-iniziali" aria-hidden="true">{iniziali(l.cliente)}</span>}
                <span><strong>{l.cliente}</strong><small>{l.settore}</small></span>
                <span class="pacchetto-tag">{l.pacchetto}</span>
              </div>
              <span class="mono rc-fatto-titolo">{T('Cosa abbiamo fatto', 'What we did')}</span>
              <ul class="cliente-fatto">{l.fatto.map((f) => <li>{f}</li>)}</ul>
              <a class="btn btn-azione" href={l.url} target="_blank" rel="noopener">{T('Visita', 'Visit')} {dominio} <span class="freccia" aria-hidden="true">↗</span></a>
            </div>
          </div>
        </dialog>
      );
    })}
  </section>

  <!-- CHI SIAMO, in breve: prima il metodo, poi chi dirige e chi stiamo cercando. Il resto è nella pagina /chi-siamo -->
  <section class="sezione" id="chi-sono" data-forma="2">
    <div class="wrap chi cs-home">
      <div class="chi-testo">
        <span class="capitolo" data-appare>{T('Chi siamo', 'About us')}</span>
        <h2 data-righe>
          <span class="riga"><span>{T('Prima studiamo.', 'First we study.')}</span></span>
          <span class="riga"><span><span class="em">{T('Poi costruiamo', 'Then we build')}</span><span class="quadratino" aria-hidden="true"></span></span></span>
        </h2>
        <p data-appare>{it
          ? <>Ogni progetto parte da una ricerca sul tuo mercato e sui tuoi concorrenti. Poi usiamo la psicologia della vendita per guidare chi visita verso una scelta. <strong>Niente è lasciato al caso.</strong></>
          : <>Every project starts with research into your market and your competitors. Then we use the psychology of selling to guide visitors towards a choice. <strong>Nothing is left to chance.</strong></>}</p>
        <div class="hero-azioni" data-appare>
          <a class="btn btn-azione" href={preventivo} data-azione>{T('Raccontami la tua', 'Tell me yours')} <span class="freccia" aria-hidden="true">→</span></a>
          <a class="link-freccia" href={url('chi', lang)}>{T('Come lavoriamo', 'How we work')} <span class="freccia" aria-hidden="true">→</span></a>
        </div>
        <p class="cs-cercando" data-appare><b><i class="cs-attivo" aria-hidden="true"></i>{T('Stiamo cercando', 'We’re hiring')}</b><span>{T('social media manager · ads manager · segreteria clienti', 'social media manager · ads manager · client coordinator')}</span><a class="link-freccia" href={`${url('chi', lang)}#lavora`}>{T('Candidati', 'Apply')} <span class="freccia" aria-hidden="true">→</span></a></p>
      </div>
      <div class="cs-scheda" data-appare="0.15">
        <ol class="cs-metodo">
          {metodoStudio[lang].map((m, i) => <li><i>{String(i + 1).padStart(2, '0')}</i><span><b>{m.titolo}</b><small>{m.breve}</small></span></li>)}
        </ol>
        <div class="cs-firma">
          <img class="cs-volto" src={volto.src} width="240" height="240" alt="" loading="lazy" decoding="async" />
          <span><b>{T('Diretto da Gabriele Desideri', 'Led by Gabriele Desideri')}</b><small>{T('Fondatore e direttore creativo', 'Founder and creative director')}</small></span>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 · DESIDERIO: IL PREVENTIVO. Niente listino: prima ci parliamo, poi arriva un preventivo scritto, su misura -->
  <section class="sezione" id="prezzi" data-forma="3">
    <div class="wrap">
      <div class="testa-sezione testa-riga">
        <span class="capitolo" data-appare>{T('04 · Il preventivo', '04 · The quote')}</span>
        <h2 data-righe>
          <span class="riga"><span>{T('Prima ti ascoltiamo.', 'First we listen.')}</span></span>
          <span class="riga"><span><span class="em">{T('Poi', 'Then')}</span> {T('il preventivo.', 'the quote.')}</span></span>
        </h2>
        <p class="lead" data-appare>{T(
          'Ogni azienda è diversa, per questo non trovi listini. Ci racconti cosa ti serve, ci sentiamo e ti mandiamo un preventivo scritto, voce per voce, fatto sul tuo caso.',
          'Every business is different, so you won’t find a price list. You tell us what you need, we talk, and we send you a written quote, line by line, built around your case.',
        )}</p>
      </div>
      <ol class="pv-tappe" data-sequenza>
        {(it ? [
          ['Ci racconti cosa ti serve', 'Due minuti: nome, contatti e due righe sul tuo lavoro.'],
          ['Ti chiamiamo per conoscerci', 'Venti minuti, gratis e senza impegno. Capiamo il tuo lavoro e i tuoi obiettivi.'],
          ['Ricevi il preventivo scritto', 'Fatto su misura, voce per voce, con i tempi. Decidi con calma.'],
        ] : [
          ['Tell us what you need', 'Two minutes: name, contact details and a couple of lines about your work.'],
          ['We call you to get to know you', 'Twenty minutes, free and with no commitment. We learn about your work and your goals.'],
          ['You get the written quote', 'Tailored, line by line, with timings. Take your time to decide.'],
        ]).map(([t, d], i) => <li><span class="mono">0{i + 1}</span><b>{t}</b><p>{d}</p></li>)}
      </ol>
      <div class="hero-azioni pv-tappe-azioni" data-appare>
        <a class="btn btn-azione btn-grande" href={preventivo} data-azione>{T('Richiedi un preventivo', 'Request a quote')} <span class="freccia" aria-hidden="true">→</span></a>
        <a class="link-freccia" href={`https://wa.me/${contatti.whatsapp}`} target="_blank" rel="noopener">{T('Oppure scrivici su WhatsApp', 'Or message us on WhatsApp')} <span class="freccia" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <!-- GARANZIE -->
  <section class="sezione" id="garanzie" data-forma="3" data-attaccata style="padding-top:0">
    <div class="wrap">
      <!-- le garanzie in piccolo: una fila di badge, icona e tre parole -->
      <ul class="garanzie-fila" role="list">
        {(it ? [
          ['revisioni', 'Ritocchi finché ti convince', 'prima di andare online'],
          ['chiave', 'Tutto è tuo', 'codice, dominio, account'],
          ['prezzo', 'Prezzo firmato', 'voce per voce, niente sorprese'],
        ] : [
          ['revisioni', "Tweaks until you're convinced", 'before going live'],
          ['chiave', 'Everything is yours', 'code, domain, accounts'],
          ['prezzo', 'Signed price', 'line by line, no surprises'],
        ]).map(([icona, titolo, sotto]) => (
          <li class="garanzia-badge">
            <span class="servizio-icona"><Icona nome={icona} /></span>
            <span><b>{titolo}</b><small>{sotto}</small></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- DOMANDE -->
  <section class="sezione" id="domande" data-forma="3">
    <div class="wrap">
      <div class="testa-sezione centro">
        <span class="capitolo" data-appare>{T('Domande frequenti', 'Frequently asked questions')}</span>
        {it
          ? <h2 data-righe><span class="riga"><span>Quello che <span class="em">tutti</span> ci chiedono.</span></span></h2>
          : <h2 data-righe><span class="riga"><span>What <span class="em">everyone</span> asks us.</span></span></h2>}
      </div>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.d}<span class="piu" aria-hidden="true"></span></summary>
            <p class="risposta">{f.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 · AZIONE -->
  <section class="sezione finale" id="azione" data-forma="4">
    <div class="wrap finale-testo">
      <span class="capitolo" data-appare>{T('05 · Scrivici', '05 · Write to us')}</span>
      <!-- qualcuno sta cercando adesso: la barra scrive da sola ricerche vere (vita.js, ricercaViva) -->
      <div class="cerca-viva" data-cerca-viva data-ricerche={JSON.stringify(it
        ? ['osteria milano stasera', 'dentista vicino a me', 'idraulico urgente milano', 'parrucchiere aperto sabato', 'cucina su misura preventivo']
        : ['restaurant near me tonight', 'dentist near me', 'emergency plumber', 'hairdresser open saturday', 'custom kitchen quote'])} aria-hidden="true" data-appare>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg>
        <span class="cv-q">{it ? 'osteria milano stasera' : 'restaurant near me tonight'}</span>
        <small class="cv-ora"><i></i>{T('adesso', 'right now')}</small>
      </div>
      <h2 data-righe>
        <span class="riga riga-nome" data-riga-nome hidden><span><span data-nome></span>,</span></span>
        <span class="riga"><span data-minuscola>{T('Il tuo prossimo cliente', 'Your next client')}</span></span>
        {/* tutto bianco: solo il punto finale è il quadratino rosso del logo */}
        <span class="riga"><span>{T('ti sta già cercando', 'is already looking for you')}<span class="quadratino" aria-hidden="true"></span></span></span>
      </h2>
      <p class="lead" data-appare>{T(
        'Raccontaci cosa ti serve: ti chiamiamo per conoscerci e ti mandiamo un preventivo scritto, fatto sul tuo caso. Ti rispondiamo entro 24 ore.',
        "Tell us what you need: we call you to get to know you and send you a written quote built around your case. We'll reply within 24 hours.",
      )}</p>
      <div class="hero-azioni" data-appare style="justify-content:center">
        <a class="btn btn-azione btn-grande" href={preventivo} data-azione>{T('Richiedi un preventivo', 'Request a quote')} <span class="freccia" aria-hidden="true">→</span></a>
        <a class="btn btn-vetro btn-grande" href={`https://wa.me/${contatti.whatsapp}?text=${encodeURIComponent(waTesto)}`} target="_blank" rel="noopener" data-wa data-wa-testo={waTesto}>{T('Scrivici su WhatsApp', 'Message us on WhatsApp')}</a>
      </div>
      <ul class="rassicura centro" data-appare>
        <li><MicroIcona nome="gratis" />{T('Preventivo gratuito', 'Free quote')}</li>
        <li><MicroIcona nome="libero" />{T('Nessun impegno', 'No commitment')}</li>
        <li><MicroIcona nome="chiamata" />{T('Chiamata conoscitiva di 20 minuti', '20-minute intro call')}</li>
      </ul>
    </div>
  </section>
</Base>

<script>
  import { serviziVivi } from '../scripts/servizi-vivi.js';
  serviziVivi();
</script>

<script>
  // Il calcolo in tre passi, in una finestra: lavori spuntati → ore ed euro in un anno → preventivo già compilato
  import { numero, euro } from '../data/formato.js';
  const box = document.querySelector<HTMLDialogElement>('[data-calcolo]');
  if (box) {
    const lang = box.dataset.lang === 'en' ? 'en' : 'it';
    const T = (a: string, b: string) => (lang === 'it' ? a : b);
    const ore1 = (n: number) => String(n).replace('.', lang === 'it' ? ',' : '.');
    const passi = [...box.querySelectorAll<HTMLElement>('[data-cl-passo]')];
    const puntini = [...box.querySelectorAll('.cl-passi i')];
    const val = (k: string) => Number((box.querySelector(`[data-in="${k}"]`) as HTMLInputElement).value);
    const scelti = () => [...box.querySelectorAll<HTMLInputElement>('[data-rip]:checked')];
    let anno = 0;

    function aggiorna() {
      box.querySelectorAll<HTMLInputElement>('input[type="range"]').forEach((i) => {
        i.style.setProperty('--p', `${((Number(i.value) - Number(i.min)) / (Number(i.max) - Number(i.min))) * 100}%`);
      });
      const ore = scelti().reduce((t, c) => t + Number(c.value), 0);
      const persone = val('persone'), costo = val('costo');
      anno = Math.round(ore * persone * 46 * 0.6);
      box.querySelector('[data-out="ore"]')!.textContent = ore1(ore);
      box.querySelector('[data-out="persone"]')!.textContent = String(persone);
      box.querySelector('[data-out="costo"]')!.textContent = euro(costo, lang);
      box.querySelector('[data-ris="ore"]')!.textContent = numero(anno, lang);
      box.querySelector('[data-ris="euro"]')!.textContent = euro(anno * costo, lang);
      (box.querySelector('[data-cl-vai="2"]') as HTMLButtonElement).disabled = ore === 0;
    }

    // il terzo passo: riepilogo, e la richiesta già scritta per il preventivo e per WhatsApp
    function riepilogo() {
      const lista = scelti().map((c) => c.dataset.titolo!);
      const euroAnno = euro(anno * val('costo'), lang);
      box.querySelector('[data-ris="ore-testo"]')!.textContent = T(`${numero(anno, lang)} ore all’anno,`, `${numero(anno, lang)} hours a year,`);
      const ul = box.querySelector('[data-cl-scelti]')!;
      ul.replaceChildren(...lista.map((t) => Object.assign(document.createElement('li'), { textContent: t })));
      const testo = T(
        `Vorrei automatizzare: ${lista.join(', ').toLowerCase()}. Siamo ${val('persone')} persone: dal calcolo sono circa ${numero(anno, lang)} ore all’anno (${euroAnno}).`,
        `I would like to automate: ${lista.join(', ').toLowerCase()}. We are ${val('persone')} people: the calculator says about ${numero(anno, lang)} hours a year (${euroAnno}).`,
      );
      try { localStorage.setItem('gd-calcolo', testo); } catch (_) {}
      const wa = box.querySelector<HTMLAnchorElement>('[data-cl-wa]')!;
      const u = new URL(wa.href); u.searchParams.set('text', T(`Ciao Desideri&Code! ${testo}`, `Hi Desideri&Code! ${testo}`)); wa.href = u.toString();
    }

    function vai(n: number) {
      if (n === 3) riepilogo();
      passi.forEach((p) => { p.hidden = Number(p.dataset.clPasso) !== n; });
      puntini.forEach((p, i) => { p.classList.toggle('attivo', i + 1 === n); p.classList.toggle('fatto', i + 1 < n); });
      box.querySelector('.cl-box')!.scrollTop = 0;
      const primo = passi[n - 1].querySelector<HTMLElement>('h3');
      primo?.setAttribute('tabindex', '-1'); primo?.focus({ preventScroll: true });
      (window as any).gdTrack?.('calcolo_passo', { passo: n });
    }
    box.querySelectorAll<HTMLButtonElement>('[data-cl-vai]').forEach((b) => b.addEventListener('click', () => vai(Number(b.dataset.clVai))));

    function apri() {
      if (box.open) return;
      box.showModal();
      (window as any).gdLenis?.stop();
      vai(1);
      (window as any).gdTrack?.('calcolo_aperto');
    }
    function chiudi() { box.close(); }
    box.addEventListener('close', () => { (window as any).gdLenis?.start(); });
    box.addEventListener('click', (e) => { if (e.target === box) chiudi(); }); // clic sullo sfondo
    box.querySelector('[data-calcolo-chiudi]')!.addEventListener('click', chiudi);
    document.querySelectorAll('[data-calcolo-apri]').forEach((b) => b.addEventListener('click', apri));
    box.addEventListener('input', aggiorna);
    box.addEventListener('change', aggiorna);
    aggiorna();
    if (location.hash === '#calcola') apri();
  }

  // Parlano di noi: una scheda (anche una delle copie della fila infinita) apre il suo progetto.
  // Un trascinamento della fila non vale come clic (vita.js lo segna con preventDefault).
  const fila = document.querySelector('[data-recensioni]');
  if (fila) {
    let ultima: HTMLElement | null = null;
    fila.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-recensione]');
      if (!b || e.defaultPrevented) return;
      const d = document.querySelector<HTMLDialogElement>(`[data-recensione-dialogo="${b.dataset.recensione}"]`);
      if (!d) return;
      ultima = b;
      d.showModal();
      (window as any).gdLenis?.stop();
      (window as any).gdTrack?.('recensione_aperta', { cliente: b.dataset.recensione });
    });
    document.querySelectorAll<HTMLDialogElement>('[data-recensione-dialogo]').forEach((d) => {
      d.addEventListener('close', () => { (window as any).gdLenis?.start(); ultima?.focus({ preventScroll: true }); });
      d.addEventListener('click', (e) => { if (e.target === d) d.close(); }); // clic sullo sfondo
      d.querySelector('[data-rc-chiudi]')?.addEventListener('click', () => d.close());
    });
  }
</script>
