<style>
  .nastro { position: relative; z-index: 2; border-block: 1px solid var(--linea); background: rgba(var(--notte-rgb),.55); overflow: hidden; padding: 1.1rem 0; -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .nastro-traccia { display: flex; width: max-content; animation: nastro 38s linear infinite; }
  .nastro-gruppo { display: flex; }
  .nastro span { display: inline-flex; align-items: center; gap: 2.2rem; padding-right: 2.2rem; font-family: var(--f-titolo); font-size: clamp(1.1rem, 2vw, 1.6rem); font-weight: 600; letter-spacing: -0.01em; white-space: nowrap; color: var(--nebbia); }
  .nastro i { font-style: normal; color: var(--viola); font-size: .8em; }
  @keyframes nastro { to { transform: translateX(-50%); } }
  .recensione { margin: 0; padding: 1rem 1.2rem; border-left: 2px solid var(--ambra); font-family: var(--f-emozione); font-style: italic; letter-spacing: .012em; font-size: 1.38rem; }
</style>

<script>
  // Calcolatore del tempo risparmiato
  import { numero, euro } from '../data/formato.js';
  const box = document.querySelector<HTMLElement>('[data-risparmio]');
  if (box) {
    const lang = box.dataset.lang === 'en' ? 'en' : 'it';
    const val = (k: string) => Number((box.querySelector(`[data-in="${k}"]`) as HTMLInputElement).value);
    const aggiorna = () => {
      box.querySelectorAll<HTMLInputElement>('input[type="range"]').forEach((i) => {
        const p = ((Number(i.value) - Number(i.min)) / (Number(i.max) - Number(i.min))) * 100;
        i.style.setProperty('--p', `${p}%`);
      });
      const ore = val('ore'), persone = val('persone'), costo = val('costo');
      const anno = Math.round(ore * persone * 46 * 0.6);
      box.querySelector('[data-out="ore"]')!.textContent = String(ore);
      box.querySelector('[data-out="persone"]')!.textContent = String(persone);
      box.querySelector('[data-out="costo"]')!.textContent = euro(costo, lang);
      box.querySelector('[data-ris="ore"]')!.textContent = numero(anno, lang);
      box.querySelector('[data-ris="euro"]')!.textContent = euro(anno * costo, lang);
    };
    box.addEventListener('input', aggiorna);
    aggiorna();
  }
</script>
