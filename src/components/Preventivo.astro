---
// La richiesta di preventivo (/preventivo e /en/quote). Niente prezzi online: chi scrive lascia nome, cognome,
// email e telefono e racconta cosa gli serve; Gabriele lo chiama e poi manda un preventivo scritto, su misura.
// La richiesta va allo script di Google (apps-script/Code.gs); senza script si apre WhatsApp con il testo già scritto.
import Base from '../layouts/Base.astro';
import Icona from './Icona.astro';
import { dati } from '../i18n/dati.js';
import { url } from '../i18n/ui.js';
import '../styles/preventivo.css';

interface Props { lang?: 'it' | 'en' }
const { lang = 'it' } = Astro.props;
const it = lang === 'it';
const T = (a: string, b: string) => (it ? a : b);
const { servizi, contatti } = dati(lang);
const scelte = [
  ...servizi.map((s: any) => ({ id: s.id, nome: s.titolo, icona: s.icona })),
  { id: 'consulenza', nome: T('Consulenza · non so ancora', 'Advice · not sure yet'), icona: 'chat' },
];
const tempi = it ? ['Il prima possibile', 'Entro 1-3 mesi', 'Sto ancora valutando'] : ['As soon as possible', 'Within 1-3 months', 'Still deciding'];
const passi = it
  ? [['Ci racconti cosa ti serve', 'Due minuti, qui sotto.'], ['Ti chiamiamo per conoscerci', '20 minuti, gratis: capiamo il tuo lavoro e i tuoi obiettivi.'], ['Ricevi il preventivo scritto', 'Fatto su misura, voce per voce. Decidi con calma.']]
  : [['Tell us what you need', 'Two minutes, below.'], ['We call you to get to know you', '20 minutes, free: we learn about your work and your goals.'], ['You get a written quote', 'Tailored, line by line. Take your time to decide.']];
---
<Base
  lang={lang}
  title={T('Richiedi un preventivo · Desideri&Code', 'Request a quote · Desideri&Code')}
  description={T(
    'Raccontaci cosa ti serve: automazioni AI, gestionale, sito, negozio online o pubblicità. Ti chiamiamo per conoscerci e ti mandiamo un preventivo scritto, su misura.',
    'Tell us what you need: AI automation, custom software, website, online store or advertising. We call you to get to know you and send a written, tailored quote.',
  )}
  path={url('preventivo', lang)}
  alt={url('preventivo', it ? 'en' : 'it')}
>
  <section class="pv" data-forma="1">
    <div class="wrap pv-griglia">
      <header class="pv-testa">
        <span class="capitolo">{T('Richiedi un preventivo', 'Request a quote')}</span>
        <h1 data-righe>
          <span class="riga"><span><span data-nome-prefisso hidden><span data-nome></span>, </span><span data-minuscola>{T('Prima ti ascoltiamo.', 'First we listen.')}</span></span></span>
          <span class="riga"><span class="em">{T('Poi il preventivo', 'Then the quote')}<span class="quadratino" aria-hidden="true"></span></span></span>
        </h1>
        <p class="lead">{T(
          'Ogni azienda è diversa, per questo non trovi listini. Raccontaci cosa ti serve: ti chiamiamo, capiamo il tuo lavoro e ti mandiamo un preventivo scritto, fatto a modo.',
          'Every business is different, so you won’t find a price list. Tell us what you need: we call you, learn how you work and send you a proper written quote.',
        )}</p>
        <ol class="pv-passi">
          {passi.map(([t, d], i) => <li><b><i>{i + 1}</i>{t}</b><span>{d}</span></li>)}
        </ol>
        <div class="pv-altro">
          <span class="mono">{T('Preferisci scriverci?', 'Prefer to write?')}</span>
          <a class="link-freccia" href={`https://wa.me/${contatti.whatsapp}`} target="_blank" rel="noopener">WhatsApp {contatti.telefono} <span class="freccia" aria-hidden="true">↗</span></a>
          <a class="link-freccia" href={`mailto:${contatti.email}`}>{contatti.email} <span class="freccia" aria-hidden="true">↗</span></a>
        </div>
      </header>

      <form class="pv-form" data-preventivo data-lang={lang} data-wa={contatti.whatsapp} data-email={contatti.email} novalidate>
        <fieldset class="pv-largo pv-servizi">
          <legend>{T('Di cosa hai bisogno?', 'What do you need?')} <span class="facolt">{T('anche più di uno', 'pick one or more')}</span></legend>
          <div class="pv-scelte">
            {scelte.map((s) => (
              <label class="pv-scelta">
                <input type="checkbox" name="servizi" value={s.id} data-nome-servizio={s.nome} />
                <span class="pv-icona"><Icona nome={s.icona} /></span>
                <span>{s.nome}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <label>{T('Nome', 'First name')}<input name="nome" required autocomplete="given-name" placeholder={T('es. Laura', 'e.g. Laura')} /></label>
        <label>{T('Cognome', 'Last name')}<input name="cognome" required autocomplete="family-name" placeholder={T('es. Bianchi', 'e.g. Smith')} /></label>
        <label>Email<input name="email" type="email" required autocomplete="email" placeholder="nome@azienda.it" /></label>
        <label>{T('Telefono', 'Phone')}<input name="telefono" type="tel" required autocomplete="tel" inputmode="tel" placeholder="+39 …" /></label>
        <label><span>{T('Azienda o attività', 'Company or business')} <span class="facolt">{T('facoltativo', 'optional')}</span></span><input name="azienda" autocomplete="organization" placeholder={T('es. Studio Bianchi', 'e.g. Smith & Co')} /></label>
        <label><span>{T('Sito o profilo attuale', 'Current site or profile')} <span class="facolt">{T('facoltativo', 'optional')}</span></span><input name="sito" inputmode="url" autocomplete="url" placeholder="www.iltuosito.it" /></label>
        <label class="pv-largo">{T('Raccontaci il progetto', 'Tell us about the project')}<textarea name="messaggio" rows="5" placeholder={T('Cosa fai, cosa vorresti ottenere, cosa ti fa perdere più tempo oggi…', 'What you do, what you want to achieve, what wastes most of your time today…')}></textarea></label>
        <fieldset class="pv-largo pv-righe">
          <legend>{T('Quando vorresti partire?', 'When would you like to start?')}</legend>
          <div>{tempi.map((t, i) => <label><input type="radio" name="tempi" value={t} checked={i === 0} /><span>{t}</span></label>)}</div>
        </fieldset>
        <fieldset class="pv-largo pv-righe">
          <legend>{T('Come preferisci essere ricontattato?', 'How should we get back to you?')}</legend>
          <div>{['WhatsApp', T('Chiamata', 'Call'), 'Email'].map((c, i) => <label><input type="radio" name="canale" value={c} checked={i === 0} /><span>{c}</span></label>)}</div>
        </fieldset>
        <input class="sr-only" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
        {it
          ? <label class="pv-privacy pv-largo"><input type="checkbox" name="privacy" required /><span>Ho letto l'<a href="/privacy" target="_blank">informativa privacy</a> e acconsento a essere ricontattato per questa richiesta.</span></label>
          : <label class="pv-privacy pv-largo"><input type="checkbox" name="privacy" required /><span>I have read the <a href="/en/privacy" target="_blank">privacy notice</a> and agree to be contacted about this request.</span></label>}
        <p class="pv-errore pv-largo" data-errore role="alert" hidden></p>
        <div class="pv-largo pv-invio">
          <button class="btn btn-azione btn-grande" type="submit" data-invia>{T('Invia la richiesta', 'Send the request')} <span class="freccia" aria-hidden="true">→</span></button>
          <small>{T('Gratis e senza impegno. Ti rispondiamo entro 24 ore.', 'Free, no commitment. We reply within 24 hours.')}</small>
        </div>
        <div class="pv-fatto pv-largo" data-fatto hidden tabindex="-1">
          <span class="pv-fatto-spunta" aria-hidden="true"></span>
          <p data-fatto-testo></p>
          <div data-fatto-azioni></div>
        </div>
      </form>
    </div>
  </section>
</Base>

<script>
  import '../scripts/preventivo.js';
</script>
