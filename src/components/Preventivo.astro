---
// Il preventivo automatico in italiano (/preventivo) e in inglese (/en/quote).
import Base from '../layouts/Base.astro';
import Icona from './Icona.astro';
import Cursore from './Cursore.astro';
import Cubo from './Cubo.astro';
import { dati } from '../i18n/dati.js';
import { url } from '../i18n/ui.js';
import '../styles/preventivo.css';
import { euro } from '../data/formato.js';

interface Props { lang?: 'it' | 'en' }
const { lang = 'it' } = Astro.props;
const it = lang === 'it';
const T = (a: string, b: string) => (it ? a : b);
const { categorie, tempi, incontri, cambio, contatti } = dati(lang);
const tasso = it ? String(cambio.CHF).replace('.', ',') : String(cambio.CHF);
const icone: Record<string, string> = { sito: 'finestra', ecommerce: 'borsa', software: 'chip', gestionale: 'gestionale', ads: 'onda', cura: 'scudo' };
const prezzoLivello = (l: { una?: number; mese?: number }) =>
  [l.una ? euro(l.una, lang) : '', l.mese ? `${euro(l.mese, lang)}${T('/mese', '/month')}` : ''].filter(Boolean).join(' + ');
// prezzi con gli importi negli attributi: lo script li riscrive in franchi se il visitatore lo chiede
const attrPrezzo = (l: { una?: number; mese?: number }) => ({ 'data-prezzo': '', 'data-una': l.una || 0, 'data-mese': l.mese || 0 });
// tre passi: cosa ti serve, il pacchetto (con gli extra facoltativi chiusi), i contatti
const passi = it ? ['Servizi', 'Pacchetto', 'Contatti'] : ['Services', 'Package', 'Contact'];
const passoDi = (n: number) => T(`Passo ${n} di 3`, `Step ${n} of 3`);
---
<Base
  lang={lang}
  title={T('Calcola il tuo preventivo · Desideri & Code', 'Get your quote · Desideri & Code')}
  description={T(
    'Componi il tuo progetto: sito web, negozio online, automazioni e AI, gestionale su misura, pubblicità. Vedi subito il prezzo e invia la richiesta in 2 minuti.',
    'Build your project: website, online store, AI & automation, custom software, advertising. See the price instantly and send your request in 2 minutes.',
  )}
  path={url('preventivo', lang)}
  alt={url('preventivo', it ? 'en' : 'it')}
  barra={false}
>
  <section class="pv" data-forma="4" data-lato="destra" data-luce="0.22" data-scala="1.3">
    <div class="wrap">
      <header class="pv-testa">
        <span class="capitolo">{T('Preventivo automatico', 'Instant quote')}</span>
        <h1 data-righe>
          <span class="riga"><span>{T('Componi il tuo', 'Build your')}</span></span>
          <span class="riga"><span><span class="em em-firma">{T('progetto.', 'project.')}</span></span></span>
        </h1>
        <p class="lead">{T(
          'Tre passi, due minuti, nessun impegno. Il prezzo si aggiorna mentre scegli.',
          'Three steps, two minutes, no commitment. The price updates as you choose.',
        )}</p>
        <p class="pv-varianti">{T('Anche il tuo sito può avere più versioni di colore, come questo:', 'Your website can also come in several colour versions, like this one:')} <button type="button" data-personalizza aria-controls="pannello-tema">{T('prova a cambiarlo', 'try changing it')}</button>.</p>
        <p class="pv-svizzera" data-svizzera hidden>
          {T('Sei in Svizzera?', 'Are you in Switzerland?')} <button type="button" data-valuta-scegli="CHF">{T('Mostra i prezzi anche in franchi', 'Show prices in Swiss francs too')}</button>
        </p>
      </header>
      <div class="pv-cubo"><Cubo lang={lang} /></div>

      <noscript>
        {it
          ? <p class="pv-noscript">Per usare il preventivo automatico serve JavaScript. Puoi scriverci direttamente su <a href={`https://wa.me/${contatti.whatsapp}`}>WhatsApp</a> o a <a href={`mailto:${contatti.email}`}>{contatti.email}</a>.</p>
          : <p class="pv-noscript">The instant quote needs JavaScript. You can write to us directly on <a href={`https://wa.me/${contatti.whatsapp}`}>WhatsApp</a> or at <a href={`mailto:${contatti.email}`}>{contatti.email}</a>.</p>}
      </noscript>

      <ol class="pv-passi" data-passi aria-label={T('Passaggi', 'Steps')}>
        {passi.map((p, i) => <li data-passo-ind={i + 1} class={i === 0 ? 'attivo' : ''}><span>{i + 1}</span>{p}</li>)}
      </ol>
      <div class="pv-barra" aria-hidden="true"><span data-barra-progresso></span></div>

      <div class="pv-griglia">
        <form class="pv-form" data-preventivo data-lang={lang} novalidate>
          <!-- PASSO 1 · cosa ti serve -->
          <fieldset class="pv-passo" data-passo="1">
            <legend><span class="mono">{passoDi(1)}</span>{T('Cosa ti serve?', 'What do you need?')}</legend>
            <p class="pv-aiuto">{T('Puoi sceglierne più di uno: con 2 servizi hai il 5% di sconto, con 3 il 10%.', 'You can pick more than one: 5% off with 2 services, 10% with 3.')}</p>
            <div class="pv-cat">
              {categorie.map((c) => (
                <label class="pv-cat-card" data-iride={c.id}>
                  <input type="checkbox" name="cat" value={c.id} />
                  <span class="pv-cat-icona"><Icona nome={icone[c.id]} /></span>
                  <span class="pv-cat-testo"><span class="pv-cat-nome">{c.nome}</span><span class="pv-cat-riga">{c.riga}</span></span>
                  <span class="pv-cat-da">{T('da', 'from')} <span {...attrPrezzo(c.livelli[0])}>{prezzoLivello(c.livelli[0])}</span></span>
                  <span class="pv-spunta" aria-hidden="true"></span>
                </label>
              ))}
            </div>
            <p class="pv-errore" data-errore="1" hidden>{T('Scegli almeno un servizio per continuare.', 'Choose at least one service to continue.')}</p>
            <div class="pv-nav">
              <span></span>
              <button class="btn btn-azione" type="button" data-avanti>{T('Continua', 'Continue')} <span class="freccia" aria-hidden="true">→</span></button>
            </div>
          </fieldset>

          <!-- PASSO 2 · il pacchetto di ogni servizio; extra, tempi e incontri sono facoltativi e chiusi -->
          <fieldset class="pv-passo" data-passo="2" hidden>
            <legend><span class="mono">{passoDi(2)}</span>{T('Scegli il pacchetto', 'Pick your package')}</legend>
            <p class="pv-aiuto">{T('Abbiamo già scelto il più richiesto: cambialo se vuoi.', 'We have already picked the most popular one: change it if you like.')}</p>
            {categorie.map((c) => (
              <div class="pv-blocco" data-blocco={c.id} hidden>
                <div class="pv-blocco-testa">
                  <span class="pv-cat-icona"><Icona nome={icone[c.id]} /></span>
                  <h2>{c.nome}</h2>
                </div>
                <div class="pv-livelli" role="radiogroup" aria-label={`${T('Pacchetto', 'Package')} ${c.nome}`}>
                  {c.livelli.map((l, i) => (
                    <label class={`pv-livello${l.top ? ' top' : ''}`}>
                      <input type="radio" name={`liv-${c.id}`} value={l.id} checked={l.top || (i === 0 && !c.livelli.some((x) => x.top))} />
                      <span class="pv-livello-riga"><span class="pv-livello-nome">{l.nome}</span>{l.top && <span class="pv-badge">{T('Il più scelto', 'Most popular')}</span>}</span>
                      <span class="pv-livello-prezzo" {...attrPrezzo(l)}>{prezzoLivello(l)}</span>
                      <span class="pv-livello-spiega">{l.spiega}</span>
                      <span class="pv-include-titolo">{T('Cosa include', "What's included")}</span>
                      <ul class="pv-include">{l.include.map((x) => <li>{x}</li>)}</ul>
                    </label>
                  ))}
                </div>
                {c.extra.length > 0 && (
                  <details class="pv-extra" data-extra-box>
                    <summary>{T('Aggiungi extra', 'Add extras')} <span class="facolt">{T('(facoltativo)', '(optional)')}</span><span class="pv-extra-conta" data-extra-conta></span></summary>
                    {c.extra.map((e) => (
                      <div class="pv-extra-riga" data-extra={`${c.id}.${e.id}`} data-max={e.max || 1}>
                        <div class="pv-extra-testo">
                          <span class="pv-extra-nome">{e.nome}</span>
                          <span class="pv-extra-spiega">{e.spiega}</span>
                        </div>
                        <span class="pv-extra-prezzo"><span {...attrPrezzo(e)}>{prezzoLivello(e)}</span>{e.max ? T(' cad.', ' each') : ''}</span>
                        {e.max ? (
                          <div class="pv-stepper">
                            <button type="button" data-meno aria-label={`${T('Togli', 'Remove')} ${e.nome}`}>−</button>
                            <output data-q>0</output>
                            <button type="button" data-piu aria-label={`${T('Aggiungi', 'Add')} ${e.nome}`}>+</button>
                          </div>
                        ) : (
                          <label class="pv-interruttore">
                            <input type="checkbox" data-toggle aria-label={`${T('Aggiungi', 'Add')} ${e.nome}`} />
                            <span></span>
                          </label>
                        )}
                      </div>
                    ))}
                  </details>
                )}
                {c.nota && <p class="pv-nota">{c.nota}</p>}
              </div>
            ))}
            <details class="pv-extra pv-altro" data-extra-box>
              <summary><span class="pv-legend-ico"><Icona nome="tempi" /></span>{T('Tempi e incontri di persona', 'Timing and in-person meetings')} <span class="facolt">{T('(facoltativo)', '(optional)')}</span><span class="pv-extra-conta" data-extra-conta></span></summary>
              <div class="pv-tempi" role="radiogroup" aria-label={T('Tempi', 'Timing')}>
                {tempi.map((t, i) => (
                  <label class="pv-scelta">
                    <input type="radio" name="tempi" value={t.id} checked={i === 0} />
                    <span><strong>{t.nome}</strong><small>{t.riga}</small></span>
                  </label>
                ))}
              </div>
              <p class="pv-aiuto pv-aiuto-piccolo">{T('Videochiamate sempre incluse; a Milano città gli incontri sono gratuiti.', 'Video calls always included; meetings in Milan city are free.')}</p>
              {incontri.map((e) => (
                <div class="pv-extra-riga" data-incontro={e.id} data-max={e.max}>
                  <div class="pv-extra-testo">
                    <span class="pv-extra-nome">{e.nome}</span>
                    <span class="pv-extra-spiega">{e.spiega}</span>
                  </div>
                  <span class="pv-extra-prezzo"><span {...attrPrezzo(e)}>{prezzoLivello(e)}</span>{T(' a incontro', ' per meeting')}</span>
                  <div class="pv-stepper">
                    <button type="button" data-meno aria-label={`${T('Togli', 'Remove')} ${e.nome}`}>−</button>
                    <output data-q>0</output>
                    <button type="button" data-piu aria-label={`${T('Aggiungi', 'Add')} ${e.nome}`}>+</button>
                  </div>
                </div>
              ))}
            </details>
            <div class="pv-nav">
              <button class="btn btn-vetro" type="button" data-indietro>← {T('Indietro', 'Back')}</button>
              <button class="btn btn-azione" type="button" data-avanti>{T('Ultimo passo', 'Last step')} <span class="freccia" aria-hidden="true">→</span></button>
            </div>
          </fieldset>

          <!-- PASSO 3 · i contatti, solo l'essenziale -->
          <fieldset class="pv-passo" data-passo="3" hidden>
            <legend><span class="mono">{passoDi(3)}</span>{T('Dove ti mandiamo il preventivo?', 'Where should we send the quote?')}</legend>
            <p class="pv-aiuto">{T('Ti rispondiamo entro 24 ore con il prezzo definitivo.', 'We reply within 24 hours with the final price.')}</p>
            <div class="pv-campi">
              <div class="pv-campo pv-largo"><label for="pv-nome">{T('Come ti chiami?', 'Your name')}</label><input id="pv-nome" name="nome" required autocomplete="name" /></div>
              <div class="pv-campo"><label for="pv-email">Email</label><input id="pv-email" name="email" type="email" autocomplete="email" /></div>
              <div class="pv-campo"><label for="pv-tel">{T('Telefono', 'Phone')}</label><input id="pv-tel" name="telefono" type="tel" autocomplete="tel" inputmode="tel" /></div>
              <p class="pv-suggerimento pv-largo">{T('Basta uno dei due.', 'One of the two is enough.')}</p>
              <fieldset class="pv-campo pv-largo pv-canale">
                <legend>{T('Ti ricontattiamo con', 'We get back to you by')}</legend>
                <div>
                  <label><input type="radio" name="canale" value="WhatsApp" checked /><span>WhatsApp</span></label>
                  <label><input type="radio" name="canale" value={T('Chiamata', 'Call')} /><span>{T('Chiamata', 'Call')}</span></label>
                  <label><input type="radio" name="canale" value="Email" /><span>Email</span></label>
                </div>
              </fieldset>
              <div class="pv-campo pv-largo"><label for="pv-msg">{T('Vuoi dirci qualcosa?', 'Anything to add?')} <span class="facolt">{T('(facoltativo)', '(optional)')}</span></label><textarea id="pv-msg" name="messaggio" rows="3" placeholder={T('es. Vorrei più richieste per i miei lavori a Milano', 'e.g. I would like more enquiries for my work in Milan')}></textarea></div>
              <input class="pv-trappola" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
              {it
                ? <label class="pv-privacy pv-largo"><input type="checkbox" name="privacy" required /> Ho letto l'<a href="/privacy" target="_blank">informativa privacy</a> e acconsento a essere ricontattato per questa richiesta.</label>
                : <label class="pv-privacy pv-largo"><input type="checkbox" name="privacy" required /> I have read the <a href="/en/privacy" target="_blank">privacy notice</a> and agree to be contacted about this request.</label>}
            </div>
            <p class="pv-errore" data-errore="3" hidden>{T(
              'Ci mancano il tuo nome, un modo per risponderti (email o telefono) e il consenso privacy.',
              'We need your name, a way to reply (email or phone) and the privacy consent.',
            )}</p>
            <div class="pv-nav">
              <button class="btn btn-vetro" type="button" data-indietro>← {T('Indietro', 'Back')}</button>
              <span class="pv-attesa" aria-hidden="true"><Cursore stato="pensa" /></span>
              <div class="pv-invio">
                <button class="btn btn-azione btn-grande" type="submit" data-invia>{T('Invia la richiesta', 'Send request')} <span class="freccia" aria-hidden="true">→</span></button>
              </div>
            </div>
            <p class="pv-rassicura">{T('Nessun impegno · Usiamo i tuoi dati solo per risponderti', 'No commitment · We only use your details to reply to you')}</p>
          </fieldset>

          <!-- FATTO -->
          <div class="pv-passo pv-fatto" data-passo="4" hidden tabindex="-1">
            <Cursore stato="festa" class="pv-fatto-occhio" />
            <h2>{T('Ricevuto.', 'Received.')} <span class="em em-firma">{T('Grazie!', 'Thank you!')}</span></h2>
            <p class="lead" data-fatto-testo>{T(
              'Abbiamo ricevuto il tuo progetto. Ti scriviamo entro 24 ore con il preventivo definitivo.',
              "We've received your project. We'll write to you within 24 hours with the final quote.",
            )}</p>
            <div class="hero-azioni" data-fatto-azioni></div>
            <a class="link-freccia" href={url('home', lang)}>{T('Torna alla home', 'Back to home')} <span class="freccia" aria-hidden="true">→</span></a>
          </div>
        </form>

        <!-- RIEPILOGO -->
        <aside class="pv-riepilogo" data-riepilogo aria-label={T('Riepilogo del progetto', 'Project summary')}>
          <span class="scia" aria-hidden="true"></span>
          <button class="pv-riep-mobile" type="button" data-riep-toggle aria-expanded="false">
            <span><span class="mono">{T('Il tuo progetto', 'Your project')}</span><strong data-tot-breve>{euro(0, lang)}</strong></span>
            <span class="pv-riep-freccia" aria-hidden="true">▴</span>
          </button>
          <div class="pv-riep-corpo">
            <div class="pv-riep-testa">
              <h2 class="mono">{T('Il tuo progetto', 'Your project')}</h2>
              <div class="pv-valuta" role="group" aria-label={T('Valuta', 'Currency')}>
                <button type="button" data-valuta-scegli="EUR" aria-pressed="true">€</button>
                <button type="button" data-valuta-scegli="CHF" aria-pressed="false">CHF</button>
              </div>
            </div>
            <ul class="pv-righe" data-righe-riep><li class="pv-vuoto">{T('Scegli un servizio per iniziare.', 'Choose a service to get started.')}</li></ul>
            <p class="pv-sconto" data-sconto><span data-sconto-testo></span></p>
            <div class="pv-totale">
              <span class="pv-totale-et">{T('Totale', 'Total')}</span>
              <strong data-tot-una>{euro(0, lang)}</strong>
              <span class="pv-totale-mese" data-tot-mese-riga hidden>+ <span data-tot-mese>{euro(0, lang)}</span> {T('al mese', 'a month')}</span>
            </div>
            <p class="pv-voucher" data-voucher hidden></p>
            <p class="pv-nota-tot" data-valuta-nota hidden>{T(
              `Stessi prezzi per tutti, convertiti in franchi al cambio indicativo di 1 € = ${tasso} CHF. In fattura vale l’importo concordato.`,
              `Same prices for everyone, converted to Swiss francs at an indicative rate of €1 = CHF ${tasso}. The invoice shows the agreed amount.`,
            )}</p>
            <p class="pv-nota-tot">{T('Prezzi indicativi, IVA esclusa.', 'Indicative prices, excl. VAT.')}</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script>
  import { avviaPreventivo } from '../scripts/preventivo.js';
  avviaPreventivo();
</script>
