---
// 05 · Il sito si compila: a sinistra si scrive il codice, a destra il sito prende forma nello stesso istante.
// vita.js scrive le righe ([data-riga]) una alla volta e accende i pezzi ([data-pezzo] = numero della riga).
interface Props { lang?: 'it' | 'en' }
const { lang = 'it' } = Astro.props;
const T = (a: string, b: string) => (lang === 'it' ? a : b);
---
<div class="compila" data-scrittura="24" role="img" aria-label={T('Animazione: il codice del sito di un’osteria si scrive riga per riga e accanto il sito appare pezzo per pezzo, fino a quando è online.', 'Animation: the code of a website is written line by line and next to it the site appears piece by piece, until it is online.')}>
  <div class="compila-codice" aria-hidden="true">
    <span class="mono">osteria-navigli.astro</span>
    <span data-riga>&lt;header logo="Osteria Navigli" /&gt;</span>
    <span data-riga>&lt;h1&gt;{T('Il tuo tavolo è pronto', 'Your table is ready')}&lt;/h1&gt;</span>
    <span data-riga class="g">&lt;p&gt;{T('Cucina milanese dal 1972', 'Milanese cooking since 1972')}&lt;/p&gt;</span>
    <span data-riga class="r">&lt;button rosso&gt;{T('Prenota un tavolo', 'Book a table')}&lt;/button&gt;</span>
    <span data-riga class="g">&lt;foto src="ossobuco.jpg" /&gt;</span>
    <span data-riga class="r">&lt;ai risponde="whatsapp" /&gt;</span>
    <span data-riga>$ deploy → online ✓</span>
  </div>
  <div class="compila-sito" aria-hidden="true">
    <div class="cs-barra" data-pezzo="0"><i></i>Osteria Navigli</div>
    <div class="cs-titolo" data-pezzo="1">{T('Il tuo tavolo', 'Your table')}<br>{T('è pronto.', 'is ready.')}</div>
    <div class="cs-testo" data-pezzo="2">{T('Cucina milanese dal 1972', 'Milanese cooking since 1972')}</div>
    <div class="cs-bottone" data-pezzo="3">{T('Prenota un tavolo', 'Book a table')}</div>
    <div class="cs-foto" data-pezzo="4"></div>
    <div class="cs-chat" data-pezzo="5"><b>{T('Assistente', 'Assistant')}:</b> {T('Ciao! Stasera alle 20 ho un tavolo per 4. Te lo tengo?', 'Hi! I have a table for 4 tonight at 8pm. Shall I hold it?')}</div>
    <div class="cs-online" data-pezzo="6"><i></i>{T('ONLINE', 'LIVE')} · osterianavigli.it</div>
  </div>
</div>
