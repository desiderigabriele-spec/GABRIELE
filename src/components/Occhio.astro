---
// «Occhio», la mascotte: le stesse forme del logo Eclisse, con un'espressione per ogni momento del sito.
// La palpebra prende il colore del tema, la fessura il colore del fondo. Animazioni in global.css (.mascotte).
type Espressione = 'curioso' | 'innamorato' | 'sorpreso' | 'occhiolino' | 'pensieroso' | 'festa' | 'perso' | 'ok';
// apertura: iride e pupilla dentro una «palpebra» che lo script può aprire (l'intro della prima visita)
interface Props { espressione?: Espressione; class?: string; apertura?: boolean }
const { espressione = 'curioso', class: classe = '', apertura = false } = Astro.props;

const C = { cx: 70, cy: 54, rot: -35 }; // centro dell'iride e inclinazione dello sguardo
// arco di un'ellisse ruotata attorno all'iride (gradi)
function arco(rx: number, ry: number, da: number, a: number, passi = 28) {
  const r = (C.rot * Math.PI) / 180;
  const pts: string[] = [];
  for (let i = 0; i <= passi; i++) {
    const t = ((da + (a - da) * (i / passi)) * Math.PI) / 180;
    const x = Math.cos(t) * rx, y = Math.sin(t) * ry;
    pts.push(`${(C.cx + x * Math.cos(r) - y * Math.sin(r)).toFixed(1)} ${(C.cy + x * Math.sin(r) + y * Math.cos(r)).toFixed(1)}`);
  }
  return 'M' + pts.join(' L');
}
const cuore = (x: number, y: number, s: number, fill: string, cls = '') =>
  `<path class="${cls}" fill="${fill}" d="M${x} ${y + s * 0.9}C${x - s * 1.6} ${y - s * 0.1} ${x - s * 0.9} ${y - s * 1.3} ${x} ${y - s * 0.45}C${x + s * 0.9} ${y - s * 1.3} ${x + s * 1.6} ${y - s * 0.1} ${x} ${y + s * 0.9}Z"/>`;
const stella = (x: number, y: number, s: number, fill: string, cls = '') =>
  `<path class="${cls}" fill="${fill}" d="M${x} ${y - s}Q${x + s * 0.18} ${y - s * 0.18} ${x + s} ${y}Q${x + s * 0.18} ${y + s * 0.18} ${x} ${y + s}Q${x - s * 0.18} ${y + s * 0.18} ${x - s} ${y}Q${x - s * 0.18} ${y - s * 0.18} ${x} ${y - s}Z"/>`;

interface Forma {
  pupilla?: { dx?: number; dy?: number; rx?: number; ry?: number };
  palpebra?: number; chiuso?: boolean; cuore?: boolean; sorriso?: boolean; vivace?: boolean;
  punto?: boolean; puntoR?: number; extra?: string;
}
const ROSSO = '#FF3347', AMBRA = '#FFB547', AZZURRO = '#5CC8FF';
const FORME: Record<Espressione, Forma> = {
  curioso: { vivace: true },
  innamorato: { cuore: true, punto: false, extra: cuore(110, 16, 6.5, ROSSO, 'm-battito') + cuore(98, 6, 3.4, '#FF6A8A', 'm-sale') + cuore(116, 4, 2.6, '#FF6A8A', 'm-sale') },
  sorpreso: { pupilla: { dx: 4, dy: -5, rx: 5, ry: 6 }, palpebra: 5, puntoR: 8, extra: `<path d="M104 2.5 103 -2M115 3 118.5 -1M121 13h4.5" stroke="${ROSSO}" stroke-width="2.5" stroke-linecap="round"/>` },
  occhiolino: { chiuso: true, punto: false, extra: stella(110, 15, 9, AMBRA, 'm-brilla') },
  pensieroso: { pupilla: { dx: -5, dy: -8 }, palpebra: -3, punto: false, extra: `<circle class="m-pensa" cx="40" cy="20" r="3.4" fill="#9CC0FF"/><circle class="m-pensa" cx="30" cy="12" r="4.2" fill="#9CC0FF"/><circle class="m-pensa" cx="18" cy="6" r="5" fill="${ROSSO}"/>` },
  festa: { pupilla: { dx: 2, dy: -3 }, vivace: true, extra: stella(16, 18, 6, AMBRA, 'm-brilla') + stella(118, 44, 5, AZZURRO, 'm-brilla') + `<rect x="90" y="96" width="6" height="3" rx="1.5" fill="#3D7BFF" transform="rotate(30 93 97)"/><rect x="8" y="88" width="6" height="3" rx="1.5" fill="${ROSSO}" transform="rotate(-25 11 89)"/><circle cx="100" cy="112" r="2.4" fill="${AMBRA}"/><circle cx="4" cy="52" r="2" fill="${AZZURRO}"/>` },
  perso: { pupilla: { dx: -4, dy: 7, rx: 6, ry: 7 }, palpebra: -2, puntoR: 4.5, extra: `<path d="M106 26c0-6 9-6 9 0 0 4-4.5 4.5-4.5 8.5" fill="none" stroke="${AZZURRO}" stroke-width="3.4" stroke-linecap="round"/><circle cx="110.5" cy="41" r="2.1" fill="${AZZURRO}"/>` },
  ok: { sorriso: true, pupilla: { dx: 2, dy: -5 }, punto: false, extra: `<circle class="m-punto" cx="110" cy="15" r="8.5" fill="${ROSSO}"/><path d="m106 15 3 3 5.5-6" fill="none" stroke="#F2F4F8" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>` },
};

const o = FORME[espressione];
const p = { dx: 3, dy: -4, rx: 9, ry: 11, ...o.pupilla };
const palp = o.palpebra ?? 0;
let s = `<circle cx="54" cy="68" r="44" fill="#F2F4F8"/>`;
s += `<ellipse cx="${C.cx}" cy="${C.cy}" rx="28.5" ry="33.5" transform="rotate(${C.rot} ${C.cx} ${C.cy})" class="m-fondo"/>`;
if (o.chiuso) {
  s += `<path d="${arco(23, 27, 200, 340)}" fill="none" class="m-palpebra" stroke-width="6.5" stroke-linecap="round"/>`;
  s += `<path d="${arco(15, 17, 15, 165)}" fill="none" stroke="${AMBRA}" stroke-width="5.5" stroke-linecap="round"/>`;
} else {
  if (apertura) s += `<defs><clipPath id="m-apertura"><ellipse class="m-apertura" cx="${C.cx}" cy="${C.cy}" rx="28.5" ry="33.5" transform="rotate(${C.rot} ${C.cx} ${C.cy})"/></clipPath></defs><g clip-path="url(#m-apertura)">`;
  s += `<ellipse cx="${C.cx}" cy="${C.cy}" rx="21" ry="26" transform="rotate(${C.rot} ${C.cx} ${C.cy})" fill="${AMBRA}"/>`;
  s += `<g class="m-pupilla${o.vivace && !apertura ? ' m-vivace' : ''}">`;
  s += o.cuore
    ? cuore(C.cx + p.dx, C.cy + p.dy - 1, 10, ROSSO, 'm-battito')
    : `<ellipse cx="${C.cx + p.dx}" cy="${C.cy + p.dy}" rx="${p.rx}" ry="${p.ry}" transform="rotate(${C.rot} ${C.cx + p.dx} ${C.cy + p.dy})" class="m-fondo"/>`;
  s += `<circle cx="${C.cx + p.dx + p.rx * 0.45}" cy="${C.cy + p.dy - p.ry * 0.55}" r="${o.cuore ? 2 : 2.6}" fill="#F2F4F8"/></g>`;
  if (apertura) s += `</g>`;
  if (o.sorriso) s += `<path d="${arco(26, 31, 25, 160)}" fill="none" class="m-fondo-tratto" stroke-width="9"/><path d="${arco(24, 29, 30, 150)}" fill="none" class="m-palpebra" stroke-width="4" stroke-linecap="round"/>`;
  s += `<path d="${arco(25.5 + palp, 30.5 + palp, 205, 375)}" fill="none" class="m-palpebra" stroke-width="6.5" stroke-linecap="round"/>`;
}
s += o.extra || '';
if (o.punto !== false) s += `<circle class="m-punto" cx="110" cy="15" r="${o.puntoR || 6.5}" fill="${ROSSO}"/>`;
---
<svg class={`mascotte mascotte-${espressione} ${classe}`} viewBox="-4 -6 132 132" aria-hidden="true" set:html={s} />
