---
// Le anteprime dei servizi (hero delle pagine servizio e sezione servizi della home): una schermata vera di quello che
// il cliente ottiene, in piccolo, con un movimento lento che racconta il risultato (un ordine, una richiesta, un
// messaggio gestito). Tutto è in unità del contenitore (cqw): l'anteprima si rimpicciolisce intera, come una foto.
// Le parti «degli altri» (il negozio, Instagram, il gestionale del cliente) hanno il loro stile; le parti dell'AI
// sono nere con il quadratino rosso. Gli stili sono in styles/anteprime.css.
import tazza from '../assets/img/prodotto-tazza.webp';
import palestra from '../assets/img/annuncio-palestra.webp';
import piatto from '../assets/img/bozza-piatto.webp';
import '../styles/anteprime.css';
// lazy: in home le anteprime sono sei, le foto si scaricano solo quando servono
interface Props { id: string; lang?: 'it' | 'en'; lazy?: boolean }
const { id, lang = 'it', lazy = false } = Astro.props;
const carica = lazy ? 'lazy' : 'eager';
const it = lang === 'it';
const T = (a: string, b: string) => (it ? a : b);
const descr: Record<string, [string, string]> = {
  sito: ['Anteprima: il sito di un’osteria, sul computer e sul telefono; un cliente prenota un tavolo e la prenotazione arriva al ristorante.', 'Preview: a restaurant website on desktop and phone; a guest books a table and the booking reaches the restaurant.'],
  ecommerce: ['Anteprima: la pagina prodotto di un negozio online di ceramiche; il carrello si riempie e arriva un nuovo ordine.', 'Preview: the product page of an online ceramics shop; the basket fills up and a new order arrives.'],
  ads: ['Anteprima: un post sponsorizzato su Instagram di una palestra e i numeri della campagna: richieste e costo per richiesta.', 'Preview: a sponsored Instagram post for a gym and the campaign numbers: enquiries and cost per enquiry.'],
  software: ['Anteprima: di notte una paziente scrive su WhatsApp a uno studio dentistico; l’assistente AI risponde, propone gli orari liberi e segna l’appuntamento in agenda.', 'Preview: at night a patient messages a dental practice on WhatsApp; the AI assistant replies, offers free slots and books the appointment in the calendar.'],
  gestionale: ['Anteprima: il gestionale di un’impresa con incassi, ordini e preventivi; l’AI propone tre solleciti da approvare.', 'Preview: a company’s management software with payments, orders and quotes; AI proposes three reminders to approve.'],
  cura: ['Anteprima: il report del mese di un sito: velocità, accessibilità, SEO, sicurezza, richieste in crescita e backup.', 'Preview: a website’s monthly report: speed, accessibility, SEO, security, growing enquiries and backups.'],
};
const d = descr[id] || descr.ecommerce;
const anello = (v: number) => `stroke-dasharray:${v} 100`;
---
<div class={`ap ap-${id}`} role="img" aria-label={T(d[0], d[1])}>
<div class="ap-dentro">
  {id === 'ecommerce' && (
    <Fragment>
      <div class="ap-fin ap-vero">
        <div class="ap-barra"><i></i><i></i><i></i><span>terraceramiche.it/tazza-alba</span></div>
        <div class="shop-nav">
          <b>terra<em>.</em></b>
          <span>{T('Tazze · Piatti · Vasi', 'Mugs · Plates · Vases')}</span>
          <span class="shop-carrello"><svg viewBox="0 0 24 24"><path d="M3 4h3l2.5 11h10L21 7H7" /><circle cx="10" cy="19" r="1.4" /><circle cx="17" cy="19" r="1.4" /></svg><em class="ap-da">2</em><em class="ap-a">3</em></span>
        </div>
        <div class="shop-corpo">
          <div class="shop-foto"><img src={tazza.src} width="720" height="720" alt="" loading={carica} decoding="async" /><span>{T('Nuovo', 'New')}</span></div>
          <div class="shop-info">
            <small>{T('Fatta a mano a Montelupo', 'Handmade in Montelupo')}</small>
            <h5>{T('Tazza Alba', 'Alba mug')}</h5>
            <span class="stelle">★★★★★ <small>{T('48 recensioni', '48 reviews')}</small></span>
            <b class="prezzo">{T('49 €', '€49')}</b>
            <span class="colori"><i></i><i></i><i></i></span>
            <span class="shop-btn">{T('Aggiungi al carrello', 'Add to basket')}</span>
            <span class="shop-paga"><b> Pay</b><b>G Pay</b><small>{T('o in 3 rate', 'or in 3 instalments')}</small></span>
            <small class="shop-sped">✓ {T('Spedizione gratuita da 60 €', 'Free shipping over €60')}</small>
          </div>
        </div>
      </div>
      <i class="ap-cursore"></i>
      <div class="ap-notifica ap-vero">
        <span class="ap-icona shop-ic">t.</span>
        <span><b>{T('Nuovo ordine · 64 €', 'New order · €64')}</b><small>{T('N. 1284 · 2 articoli · da spedire', 'No. 1284 · 2 items · to ship')}</small></span>
        <time>{T('adesso', 'now')}</time>
      </div>
    </Fragment>
  )}

  {id === 'ads' && (
    <Fragment>
      <div class="ap-tel ap-vero">
        <div class="ig-stato"><span>9:41</span><i></i></div>
        <div class="ig-testa"><span class="ig-avatar">F</span><span><b>forma.milano</b><small>{T('Sponsorizzato', 'Sponsored')}</small></span><i>···</i></div>
        <img class="ig-foto" src={palestra.src} width="720" height="720" alt="" loading={carica} decoding="async" />
        <div class="ig-cta"><span>{T('Prenota la prova gratuita', 'Book a free trial')}</span><span>›</span></div>
        <div class="ig-azioni"><svg viewBox="0 0 24 24"><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z" /></svg><svg viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-3-6.2L21 4l-1 4.5A8 8 0 0 1 20 12z" /></svg><svg viewBox="0 0 24 24"><path d="M21 4 3 11l7 2 2 7z" /></svg><svg class="dx" viewBox="0 0 24 24"><path d="M6 3h12v18l-6-4-6 4z" /></svg></div>
        <small class="ig-like"><b>{T('128 Mi piace', '128 likes')}</b></small>
        <small class="ig-testo"><b>forma.milano</b> {T('La prima settimana è gratis. Zona Navigli.', 'Your first week is free. Navigli area.')}</small>
      </div>
      <div class="ap-pannello ads-gestione">
        <span class="ap-mono"><i class="ads-attiva"></i>{T('Campagna · Prova gratuita', 'Campaign · Free trial')}</span>
        <dl class="ads-numeri">
          <div><dt>{T('Persone raggiunte', 'People reached')}</dt><dd>18.420</dd></div>
          <div class="forte"><dt>{T('Richieste', 'Enquiries')}</dt><dd>38</dd></div>
          <div><dt>{T('Costo a richiesta', 'Cost per enquiry')}</dt><dd>{T('9,20 €', '€9.20')}</dd></div>
          <div><dt>{T('Spesa del mese', 'Spend this month')}</dt><dd>{T('350 €', '€350')}</dd></div>
        </dl>
        <svg class="ads-linea" viewBox="0 0 100 30" preserveAspectRatio="none"><path pathLength="100" d="M0 27 L14 24 L28 25 L42 18 L56 16 L70 10 L84 8 L100 3" /></svg>
        <ul class="ads-canali">
          <li><span>Instagram</span><i style="--v:.62"></i><b>62%</b></li>
          <li><span>Google</span><i style="--v:.28"></i><b>28%</b></li>
          <li><span>TikTok</span><i style="--v:.1"></i><b>10%</b></li>
        </ul>
      </div>
      <div class="ap-notifica ap-vero">
        <span class="ap-icona ig-ic"></span>
        <span><b>{T('Nuova richiesta da Instagram', 'New enquiry from Instagram')}</b><small>{T('Laura · prova giovedì alle 18:00', 'Laura · trial on Thursday at 6 pm')}</small></span>
        <time>{T('adesso', 'now')}</time>
      </div>
    </Fragment>
  )}

  {id === 'sito' && (
    <Fragment>
      <div class="ap-fin sito-fin ap-vero">
        <div class="ap-barra"><i></i><i></i><i></i><span>osterianavigli.it</span></div>
        <div class="sito-vista"><div class="sito-pagina">
          <div class="sito-nav"><b>Osteria <em>Navigli</em></b><span>{T('Menù', 'Menu')}</span><span>{T('La storia', 'Our story')}</span><span>{T('Dove siamo', 'Find us')}</span><span class="sito-nav-btn">{T('Prenota', 'Book')}</span></div>
          <div class="sito-hero">
            <div class="sito-hero-testo">
              <small>{T('Cucina milanese dal 1972', 'Milanese cooking since 1972')}</small>
              <h5>{T('Il tuo tavolo', 'Your table')}<br />{T('è pronto.', 'is ready.')}</h5>
              <p>{T('Risotto, ossobuco e cotoletta come una volta, a due passi dalla Darsena.', 'Risotto, ossobuco and cotoletta like they used to be, by the Darsena.')}</p>
              <div class="sito-azioni"><span class="sito-bott">{T('Prenota un tavolo', 'Book a table')}<i class="sito-cur c1"></i></span><span class="sito-bott2">{T('Vedi il menù', 'See the menu')}</span></div>
              <span class="sito-google"><b>G</b> 4,8 <em>★★★★★</em> <small>{T('312 recensioni', '312 reviews')}</small></span>
            </div>
            <div class="sito-foto"><img src={piatto.src} width="600" height="400" alt="" loading={carica} decoding="async" /><span>{T('Il piatto del giorno', 'Today’s dish')}</span></div>
          </div>
          <div class="sito-menu">
            <small>{T('Il menù della settimana', 'This week’s menu')}</small>
            <div>{[[T('Risotto giallo', 'Saffron risotto'), T('con midollo', 'with bone marrow')], [T('Ossobuco', 'Ossobuco'), T('con gremolada', 'with gremolata')], [T('Cotoletta', 'Cotoletta'), T('alla milanese', 'Milanese style')]].map(([n, d]) => <span><b>{n}</b><small>{d}</small></span>)}</div>
          </div>
          <div class="sito-prenota">
            <b>{T('Prenota il tuo tavolo', 'Book your table')}</b>
            <div class="sito-campi">
              <span><small>{T('Giorno', 'Day')}</small><em class="sc1">{T('Venerdì 24', 'Friday 24')}</em></span>
              <span><small>{T('Ora', 'Time')}</small><em class="sc2">20:30</em></span>
              <span><small>{T('Persone', 'Guests')}</small><em class="sc3">4</em></span>
            </div>
            <span class="sito-conferma"><span class="sito-conf-a">{T('Conferma la prenotazione', 'Confirm booking')}</span><span class="sito-conf-b">✓ {T('Prenotato', 'Booked')}</span><i class="sito-cur c2"></i></span>
          </div>
        </div></div>
      </div>
      <div class="ap-tel sito-tel ap-vero">
        <div class="ig-stato"><span>9:41</span><i></i></div>
        <div class="sito-tel-nav"><b>Osteria <em>Navigli</em></b><i></i></div>
        <div class="sito-tel-foto"><img src={piatto.src} width="600" height="400" alt="" loading={carica} decoding="async" /></div>
        <div class="sito-tel-testo"><small>{T('Cucina milanese dal 1972', 'Milanese cooking since 1972')}</small><b>{T('Il tuo tavolo è pronto.', 'Your table is ready.')}</b><span class="sito-google"><b>G</b> 4,8 <em>★★★★★</em></span></div>
        <div class="sito-tel-azioni"><span>{T('Prenota un tavolo', 'Book a table')}</span></div>
        <div class="sito-tel-lista">{[T('Risotto giallo', 'Saffron risotto'), T('Ossobuco', 'Ossobuco'), T('Cotoletta', 'Cotoletta')].map((n) => <span><b>{n}</b><i></i></span>)}</div>
        <div class="sito-tel-barra"><span>{T('Chiama', 'Call')}</span><span class="wa">WhatsApp</span></div>
      </div>
      <div class="ap-notifica ap-vero sito-notifica">
        <span class="ap-icona ok-ic">✓</span>
        <span><b>{T('Nuova prenotazione dal sito', 'New booking from the website')}</b><small>{T('Tavolo per 4 · venerdì 24 · 20:30', 'Table for 4 · Friday 24 · 8:30 pm')}</small></span>
        <time>{T('adesso', 'now')}</time>
      </div>
    </Fragment>
  )}

  {id === 'software' && (
    <Fragment>
      <div class="ap-tel wap-tel ap-vero">
        <div class="wap-testa"><span class="wap-indietro">‹</span><span class="wap-av">S</span><span><b>{T('Studio Dentistico Sorriso', 'Smile Dental Practice')}</b><small>online</small></span></div>
        <div class="wap-chat">
          <span class="wap-giorno">{T('Oggi', 'Today')}</span>
          <p class="wap-b wap-in wap-t1">{T('Buonasera! Avete posto sabato mattina per una pulizia dei denti?', 'Good evening! Any free slot on Saturday morning for a teeth cleaning?')}<time>23:47</time></p>
          <p class="wap-scrive">{T('sta scrivendo…', 'typing…')}</p>
          <p class="wap-b wap-out wap-t2">{T('Ciao Giulia! Sabato ho libero alle 10:00 o alle 11:30. Quale preferisci?', 'Hi Giulia! On Saturday I have 10:00 or 11:30 free. Which one suits you?')}<time>23:47</time></p>
          <div class="wap-scelte wap-t2"><span class="wap-sc">10:00<i class="wap-dito"></i></span><span>11:30</span></div>
          <p class="wap-b wap-out wap-t3">{T('Perfetto, ti ho segnata sabato alle 10:00 ✓ Venerdì ti mando un promemoria.', 'Done, you’re booked for Saturday at 10:00 ✓ I’ll send you a reminder on Friday.')}<time>23:48</time></p>
        </div>
        <div class="wap-scrivi"><span>{T('Messaggio', 'Message')}</span><i></i></div>
      </div>
      <div class="ap-pannello wap-ai ap-ia">
        <span class="ap-mono"><i class="wap-ai-q"></i>{T('Assistente AI', 'AI assistant')}</span>
        <b>{T('Risponde al posto tuo,', 'Replies for you,')}<br />{T('anche alle 23:47.', 'even at 11:47 pm.')}</b>
      </div>
      <div class="ap-fin wap-cal ap-vero">
        <div class="wap-cal-testa"><span class="wap-cal-ic">31</span><span><b>{T('Sabato 18 ottobre', 'Saturday 18 October')}</b><small>{T('Agenda dello studio', 'Practice calendar')}</small></span></div>
        <div class="wap-cal-ore">
          {['9:00', '10:00', '11:00', '12:00'].map((h) => <span><small>{h}</small><i></i></span>)}
          <div class="wap-ev wap-ev1"><b>Marco R.</b><small>{T('Controllo', 'Check-up')}</small></div>
          <div class="wap-ev wap-ev2"><b>Giulia F.</b><small>{T('Pulizia dei denti · fissato dall’AI', 'Teeth cleaning · booked by AI')}</small></div>
        </div>
      </div>
      <div class="ap-notifica ap-ia wap-notte">
        <span class="ap-icona luna-ic"></span>
        <span><b>{T('Mentre dormivi', 'While you slept')}</b><small>{T('3 appuntamenti fissati · 5 domande risposte', '3 appointments booked · 5 questions answered')}</small></span>
      </div>
    </Fragment>
  )}

  {id === 'gestionale' && (
    <Fragment>
      <div class="ap-fin gest ap-vero">
        <aside class="gest-menu">
          <b>RI</b>
          {[T('Panoramica', 'Overview'), T('Clienti', 'Clients'), T('Preventivi', 'Quotes'), T('Ordini', 'Orders'), T('Magazzino', 'Stock'), T('Fatture', 'Invoices')].map((v, i) => <span class={i === 0 ? 'on' : ''}><i></i>{v}</span>)}
        </aside>
        <div class="gest-main">
          <div class="gest-testa"><b>{T('Buongiorno, Marco', 'Good morning, Marco')}</b><small>Rossi Impianti · {T('martedì 14 ottobre', 'Tuesday 14 October')}</small></div>
          <div class="gest-kpi">
            <div class="rosso"><small>{T('Da incassare', 'To collect')}</small><b>{T('12.400 €', '€12,400')}</b><em>{T('3 fatture scadute', '3 overdue invoices')}</em></div>
            <div><small>{T('Ordini aperti', 'Open orders')}</small><b>18</b><em>{T('5 da spedire oggi', '5 to ship today')}</em></div>
            <div><small>{T('Scorte basse', 'Low stock')}</small><b>3</b><em>{T('da riordinare', 'to reorder')}</em></div>
          </div>
          <div class="gest-tab">
            <span class="gest-tab-tit">{T('Preventivi in corso', 'Open quotes')}</span>
            {[
              [T('Condominio Verdi', 'Verdi building'), T('8.400 €', '€8,400'), T('Accettato', 'Accepted'), 'ok'],
              [T('Bar Duomo', 'Duomo café'), T('2.150 €', '€2,150'), T('Inviato', 'Sent'), 'inv'],
              [T('Studio Neri', 'Neri practice'), T('3.900 €', '€3,900'), T('Da firmare', 'To sign'), 'att'],
              [T('Villa Corti', 'Corti villa'), T('12.600 €', '€12,600'), T('Bozza', 'Draft'), 'boz'],
            ].map(([c, v, s, k]) => <div><span>{c}</span><b>{v}</b><em class={k}>{s}</em></div>)}
          </div>
        </div>
      </div>
      <div class="ap-notifica ap-ia gest-ai">
        <span class="ap-icona ai-ic"></span>
        <span><b>{T('Ho preparato 3 solleciti per le fatture scadute.', 'I drafted 3 reminders for the overdue invoices.')}</b><small>{T('Li mando?', 'Shall I send them?')}</small>
          <span class="gest-bottoni"><em>{T('Approva', 'Approve')}</em><em>{T('Vedi', 'View')}</em></span></span>
      </div>
    </Fragment>
  )}

  {id === 'cura' && (
    <Fragment>
      <div class="ap-fin report ap-vero">
        <div class="rep-testa"><span class="rep-logo">D&amp;C<em></em></span><span><b>{T('Il report di ottobre', 'Your October report')}</b><small>osteriablu.it · {T('dal tuo referente, Gabriele', 'from Gabriele, your contact')}</small></span></div>
        <div class="rep-punti">
          {[[98, T('Velocità', 'Speed')], [100, T('Accessibilità', 'Accessibility')], [100, 'SEO'], [100, T('Sicurezza', 'Security')]].map(([v, n], i) => (
            <div><svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15.9" pathLength="100" /><circle class="pieno" cx="18" cy="18" r="15.9" pathLength="100" style={anello(Number(v))} /></svg><b>{i === 3 ? '✓' : v}</b><small>{n}</small></div>
          ))}
        </div>
        <div class="rep-grafico">
          <span><small>{T('Richieste dal sito', 'Enquiries from the site')}</small><b>+32%</b></span>
          <div class="rep-barre">{[34, 41, 38, 52, 49, 63, 71].map((h, i) => <i style={`--h:${h}%;--i:${i}`} class={i === 6 ? 'ora' : ''}></i>)}</div>
        </div>
        <ul class="rep-lista">
          <li>{T('Backup ogni notte · l’ultimo alle 03:00', 'Backup every night · latest at 3 am')}</li>
          <li>{T('6 aggiornamenti installati', '6 updates installed')}</li>
          <li>{T('Online il 99,98% del tempo', 'Online 99.98% of the time')}</li>
        </ul>
      </div>
      <div class="ap-notifica ap-vero">
        <span class="ap-icona ok-ic">✓</span>
        <span><b>{T('Modifica fatta', 'Change done')}</b><small>{T('Orari estivi aggiornati sul sito e su Google', 'Summer hours updated on the site and on Google')}</small></span>
        <time>{T('2 ore fa', '2 h ago')}</time>
      </div>
    </Fragment>
  )}
</div>
</div>
