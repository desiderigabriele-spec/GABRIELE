</Base>

<script>
  import { leggiProfilo } from '../scripts/profilo.js';
  const ridotto = document.documentElement.classList.contains('ridotto');

  // ---------- Esempi per settore: schede, frecce da tastiera, settore scelto nel benvenuto ----------
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-settore-tab]')];
  const pannelli = [...document.querySelectorAll<HTMLElement>('[data-settore-pannello]')];
  function scegli(id: string, focus = false) {
    tabs.forEach((t) => {
      const on = t.dataset.settoreTab === id;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    });
    pannelli.forEach((p) => { p.hidden = p.dataset.settorePannello !== id; });
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => scegli(t.dataset.settoreTab!));
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const j = (i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
      scegli(tabs[j].dataset.settoreTab!, true);
    });
  });
  const settore = leggiProfilo().settore;
  if (settore && tabs.some((t) => t.dataset.settoreTab === settore)) scegli(settore);

  // ---------- L'esempio animato: legge, capisce, scrive ----------
  const demo = document.querySelector<HTMLElement>('[data-demo-ai]');
  if (demo) {
    const campi = [...demo.querySelectorAll<HTMLElement>('[data-demo-campo]')];
    const risposta = demo.querySelector<HTMLElement>('[data-demo-risposta]')!;
    const testoRisposta = risposta.dataset.testo || '';
    const fine = demo.querySelector<HTMLElement>('[data-demo-fine]')!;
    const email = demo.querySelector<HTMLElement>('[data-demo-testo]')!;
    let timer: number[] = [];
    const dopo = (ms: number, f: () => void) => timer.push(window.setTimeout(f, ms));
    function avvia() {
      timer.forEach(clearTimeout); timer = [];
      demo!.classList.remove('fatto');
      if (ridotto) { demo!.classList.add('fatto'); campi.forEach((c) => c.classList.add('visto')); risposta.textContent = testoRisposta; fine.classList.add('visto'); return; }
      campi.forEach((c) => c.classList.remove('visto'));
      fine.classList.remove('visto');
      risposta.textContent = '';
      email.classList.add('lettura');
      dopo(1400, () => email.classList.remove('lettura'));
      campi.forEach((c, i) => dopo(1500 + i * 380, () => c.classList.add('visto')));
      const parole = testoRisposta.split(' ');
      const inizio = 1500 + campi.length * 380 + 300;
      parole.forEach((_, i) => dopo(inizio + i * 70, () => { risposta.textContent = parole.slice(0, i + 1).join(' '); }));
      dopo(inizio + parole.length * 70 + 300, () => { fine.classList.add('visto'); demo!.classList.add('fatto'); });
    }
    demo.querySelector('[data-demo-ripeti]')!.addEventListener('click', avvia);
    // parte quando l'esempio entra nello schermo
    const io = new IntersectionObserver((v) => { if (v.some((x) => x.isIntersecting)) { avvia(); io.disconnect(); } }, { threshold: 0.35 });
    io.observe(demo);
  }
</script>
