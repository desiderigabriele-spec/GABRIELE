  <!-- Prezzi e invito -->
  <section class="sezione finale" id="azione" data-forma="4" data-luce="0.7" data-luce-mobile="0.45" data-scala="1.15">
    <div class="wrap finale-testo">
      <span class="capitolo" data-appare>{T('Quanto costa', 'What it costs')}</span>
      <h2 data-righe>
        <span class="riga"><span>{T('Il primo lavoro', 'The first job')}</span></span>
        <span class="riga"><span>{T('che ti togli', 'off your')}</span></span>
        <span class="riga"><span class="em em-firma">{T('di dosso.', 'plate.')}</span></span>
      </h2>
      <div class="altri-prezzi prezzi-ai" data-appare>
        <div><span>{T('Un collegamento tra due programmi', 'One connection between two programs')}</span><strong>{T('da', 'from')} {eur(pCollegamento.una!)}</strong></div>
        <div><span>{T('Un assistente per i clienti', 'A customer assistant')}</span><strong><span class="intero">{T('da', 'from')} {eur(pAssistente.una!)}</span> <span class="intero">+ {eur(pAssistente.mese!)}{T('/mese', '/month')}</span></strong></div>
        <div><span>{T('Un programma interno su misura', 'A custom internal program')}</span><strong>{T('da', 'from')} {eur(pMisura.una!)}</strong></div>
      </div>
      <p class="lead" data-appare>{T(
        `In Lombardia il Voucher Doppia Transizione può coprire fino al ${voucher.percentuale * 100}% dei progetti con AI da almeno ${eur(voucher.soglia)}. Verifichiamo insieme se è ancora disponibile.`,
        `In Lombardy the "Doppia Transizione" voucher can cover up to ${voucher.percentuale * 100}% of AI projects from ${eur(voucher.soglia)}. We check together whether it’s still available.`,
      )}</p>
      <div class="hero-azioni" data-appare style="justify-content:center">
        <a class="btn btn-azione btn-grande" href={`${preventivo}?s=software`} data-azione>{T('Calcola il tuo preventivo', 'Get your quote')} <span class="freccia" aria-hidden="true">→</span></a>
        <a class="btn btn-vetro btn-grande" href={`https://wa.me/${contatti.whatsapp}`} target="_blank" rel="noopener" data-wa>{T('Dimmi cosa ti fa perdere tempo', 'Tell me what wastes your time')}</a>
      </div>
    </div>
