---
// Il sito che nasce dal codice (hero): prima la finestra si riempie di codice che scorre, poi il codice si raccoglie
// in rettangoli che disegnano il sito di un'osteria pezzo per pezzo ([data-bz]),
// poi la bozza prende vita in 3D: sei tasselli si girano e compongono la foto del piatto, e davanti galleggiano
// il voto, il messaggio WhatsApp e il grafico. Logica in vita.js (bozza), stili in vita.css.
// La foto è public/img/bozza-piatto.webp (3:2): finché non c'è, i tasselli restano color crema.
import fs from 'node:fs';
import path from 'node:path';
interface Props { lang?: 'it' | 'en' }
const { lang = 'it' } = Astro.props;
const T = (a: string, b: string) => (lang === 'it' ? a : b);
const conFoto = fs.existsSync(path.join(process.cwd(), 'public/img/bozza-piatto.webp'));
---
<div class="bozza" data-bozza aria-hidden="true">
  <div class="bz-scena">
    <div class="bz-pioggia"></div>
    <div class="bz-finestra" data-bz>
      <div class="bz-barra" data-bz><i></i><i></i><i></i><span>osterianavigli.it</span></div>
      <div class="bz-testa" data-bz><b>Osteria Navigli<span class="bz-q"></span></b><span class="bz-nav"><i></i><i></i><i></i></span></div>
      <div class="bz-hero">
        <div class="bz-sx">
          <span class="bz-occhiello" data-bz>{T('Cucina milanese · dal 1972', 'Milanese cooking · since 1972')}</span>
          <b class="bz-titolo" data-bz>{T('Il tuo tavolo', 'Your table')}<br>{T('è pronto', 'is ready')}<span class="bz-q"></span></b>
          <span class="bz-btn" data-bz>{T('Prenota un tavolo', 'Book a table')} →</span>
        </div>
        <div class={`bz-foto${conFoto ? ' con-foto' : ''}`} data-bz>{Array.from({ length: 6 }, (_, i) => <i style={`--k:${i};--c:${i % 3};--r:${Math.floor(i / 3)}`}></i>)}</div>
      </div>
      <div class="bz-schede">
        {[0, 1, 2].map((i) => <span class="bz-scheda" data-bz style={`--k:${i}`}><i></i><b></b><b></b></span>)}
      </div>
    </div>
    <div class="bz-voto" data-bz><b>4,8</b><span>★★★★★</span><small>Google</small></div>
    <div class="bz-chat" data-bz><small>WHATSAPP · {T('ORA', 'NOW')}</small>{T('Avete un tavolo per 4 stasera alle 20?', 'Do you have a table for 4 tonight at 8?')}</div>
    <div class="bz-grafico" data-bz><small>{T('PRENOTAZIONI', 'BOOKINGS')} <b>+38%</b></small><span>{[40, 55, 48, 70, 64, 88, 100].map((h, k) => <i style={`--h:${h}%;--k:${k}`}></i>)}</span></div>
  </div>
  <svg class="bz-linee"></svg>
</div>
