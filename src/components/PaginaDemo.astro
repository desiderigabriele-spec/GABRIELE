---
// La pagina delle demo guidate (/demo e /en/demo): tre esempi completi da far avanzare un passo alla volta.
import Base from '../layouts/Base.astro';
import Icona from './Icona.astro';
import Demo from './Demo.astro';
import Terminale from './Terminale.astro';
import Cursori from './Cursori.astro';
import { dati } from '../i18n/dati.js';
import { url } from '../i18n/ui.js';
import { demo, tempi, ORDINE_DEMO } from '../data/demo.js';

interface Props { lang?: 'it' | 'en' }
const { lang = 'it' } = Astro.props;
const it = lang === 'it';
const T = (a: string, b: string) => (it ? a : b);
const { contatti } = dati(lang);
const preventivo = url('preventivo', lang);
const waTesto = T('Ciao! Ho visto le demo di Desideri&Code e vorrei capire cosa si può fare nella mia attività.', 'Hi! I saw the Desideri&Code demos and I’d like to know what could work in my business.');
---
<Base
  lang={lang}
  path={url('demo', lang)}
  alt={url('demo', it ? 'en' : 'it')}
  title={T('Demo dal vivo: l’AI al lavoro · Desideri&Code', 'Live demos: AI at work · Desideri&Code')}
  description={T(
    'Tre demo guidate passo per passo: un messaggio WhatsApp che finisce da solo in agenda, un preventivo da una foto, un assistente che risponde ai clienti. Con spiegazioni semplici.',
    'Three step-by-step guided demos: a WhatsApp message that lands in the calendar on its own, a quote from a photo, an assistant that answers customers. Explained simply.',
  )}
>
  <section class="hero demo-hero" data-forma="1">
    <div class="wrap">
      <div class="demo-hero-riga">
      <div class="hero-testo">
        <span class="capitolo" data-appare>{T('Demo dal vivo', 'Live demos')}</span>
        <h1 data-righe>
          <span class="riga"><span>{T('Non fidarti sulla parola:', 'Don’t take our word for it:')}</span></span>
          <span class="riga"><span>{T('guardalo lavorare', 'watch it work')}<span class="quadratino" aria-hidden="true"></span></span></span>
        </h1>
        <p class="lead" data-appare="0.2">{T(
          'Tre esempi completi di quello che costruiamo con l’intelligenza artificiale, come brevi video: partono da soli e puoi fermarli, andare avanti o tornare indietro quando vuoi.',
          'Three complete examples of what we build with artificial intelligence, as short videos: they play on their own and you can pause, skip ahead or go back whenever you like.',
        )}</p>
      </div>
      <div class="demo-terminale" data-appare="0.3"><Terminale lang={lang} /></div>
      </div>
      <ol class="demo-indice" data-sequenza>
        {ORDINE_DEMO.map((id, i) => {
          const d = demo[lang][id];
          return (
            <li>
              <a class="card demo-voce" href={`#demo-${id}`}>
                <span class="servizio-icona"><Icona nome={d.icona} /></span>
                <span class="demo-voce-testo">
                  <span class="mono">Demo {i + 1} · {d.etichetta}</span>
                  <strong>{d.breve}</strong>
                  <small>{T('Video', 'Video')} · {tempi[id].fine} {T('secondi', 'seconds')}</small>
                </span>
                <span class="freccia" aria-hidden="true">↓</span>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  {ORDINE_DEMO.map((id, i) => <Demo id={id as 'whatsapp'} lang={lang} numero={i + 1} forma={String(i + 1)} />)}

  <section class="sezione finale" id="azione" data-forma="4">
    <div class="wrap finale-testo">
      <span class="capitolo" data-appare>{T('E nella tua attività?', 'And in your business?')}</span>
      <h2 data-righe>
        <span class="riga"><span>{T('La prossima demo', 'The next demo')}</span></span>
        <span class="riga"><span>{T('la facciamo con te', 'we build with you')}<span class="quadratino" aria-hidden="true"></span></span></span>
      </h2>
      <p class="lead" data-appare>{T(
        `Nella Diagnosi AI guardiamo insieme il lavoro che ti ruba più tempo e ti mostriamo come funzionerebbe da te, con i tuoi programmi.`,
        `In the AI Diagnosis we look together at the job that eats most of your time and show you how it would work for you, with your programs.`,
      )}</p>
      <div class="demo-cursori" data-appare><Cursori lang={lang} /></div>
      <div class="hero-azioni" data-appare style="justify-content:center">
        <a class="btn btn-azione btn-grande" href={`${preventivo}?s=software`} data-azione>{T('Richiedi un preventivo', 'Request a quote')} <span class="freccia" aria-hidden="true">→</span></a>
        <a class="btn btn-vetro btn-grande" href={`https://wa.me/${contatti.whatsapp}?text=${encodeURIComponent(waTesto)}`} target="_blank" rel="noopener" data-wa data-wa-testo={waTesto}>{T('Scrivici su WhatsApp', 'Message us on WhatsApp')}</a>
      </div>
    </div>
  </section>
</Base>
