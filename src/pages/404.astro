---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina non trovata · Desideri Studio" description="Questa pagina non esiste." path="/404">
  <section class="sezione finale" data-forma="0" data-luce="1" data-y="0.22" data-scala="0.45" data-y-mobile="0.25" data-scala-mobile="0.45" data-luce-mobile="1">
    <div class="wrap finale-testo">
      <div style="height:30vh" aria-hidden="true"></div>
      <span class="capitolo">Errore 404</span>
      <h2>Questa pagina si è persa. <span class="em em-firma">L'attenzione no.</span></h2>
      <p class="lead">La pagina che cerchi non esiste o è stata spostata.</p>
      <div class="hero-azioni" style="justify-content:center">
        <a class="btn btn-azione btn-grande" href="/" data-sguardo-meta>Torna alla home</a>
        <a class="btn btn-vetro btn-grande" href="/preventivo">Calcola il preventivo</a>
      </div>
    </div>
  </section>
</Base>
