---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina non trovata · Gabriele Desideri" description="Questa pagina non esiste." path="/404">
  <section class="sezione finale" data-forma="0" data-luce="0.8">
    <div class="wrap finale-testo">
      <span class="capitolo">Errore 404</span>
      <h2>Ti ho visto, ma qui <span class="em em-firma">non c'è niente.</span></h2>
      <p class="lead">La pagina che cerchi non esiste o è stata spostata.</p>
      <div class="hero-azioni" style="justify-content:center">
        <a class="btn btn-azione btn-grande" href="/">Torna alla home</a>
        <a class="btn btn-vetro btn-grande" href="/preventivo">Calcola il preventivo</a>
      </div>
    </div>
  </section>
</Base>
