---
import Base from '../layouts/Base.astro';
import Cursore from '../components/Cursore.astro';
---
<Base title="Pagina non trovata · Desideri&Code" description="Questa pagina non esiste." path="/404">
  <section class="sezione finale pagina-404" data-forma="4" data-luce="0.25" data-scala="1.3" data-luce-mobile="0.2">
    <div class="wrap finale-testo">
      <Cursore stato="perso" />
      <span class="capitolo">Errore 404</span>
      <h2>Questa pagina si è persa. L'attenzione no<span class="quadratino" aria-hidden="true"></span></h2>
      <p class="lead">La pagina che cerchi non esiste o è stata spostata.</p>
      <div class="hero-azioni" style="justify-content:center">
        <a class="btn btn-azione btn-grande" href="/" data-sguardo-meta>Torna alla home</a>
        <a class="btn btn-vetro btn-grande" href="/preventivo">Calcola il preventivo</a>
      </div>
    </div>
  </section>
</Base>
