---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import { dati } from '../i18n/dati.js';
import { ui, url, urlServizio } from '../i18n/ui.js';
import marchio from '../assets/marchio.svg?raw';
import Occhio from '../components/Occhio.astro';
import Icona from '../components/Icona.astro';
import { euro } from '../data/formato.js';

interface Props {
  title: string;
  description: string;
  path?: string;
  scena?: boolean;
  barra?: boolean;
  jsonLd?: Record<string, unknown> | null;
  lang?: 'it' | 'en';
  // la stessa pagina nell'altra lingua (null = non esiste)
  alt?: string | null;
}

const { title, description, path = '/', scena = true, barra = true, jsonLd = null, lang = 'it' } = Astro.props;
const t = ui[lang];
const altLang = lang === 'it' ? 'en' : 'it';
const alt = Astro.props.alt === undefined ? url('home', altLang) : Astro.props.alt;
const { contatti, servizi } = dati(lang);
const home = url('home', lang);
const preventivo = url('preventivo', lang);
const canonical = new URL(path, Astro.site).toString();
const current = Astro.url.pathname.replace(/\.html$/, '');
const isCurrent = (href: string) => (current === href ? 'page' : undefined);
// '@pagina' = un'altra pagina del sito, altrimenti una sezione della home
const voci = t.nav.map(([id, testo]) => ({ id, href: id.startsWith('@') ? url(id.slice(1), lang) : `${home}#${id}`, testo }));
// la voce attiva: la pagina AI, una pagina servizio («Servizi») o, in home, la sezione in vista (site.js)
const suServizio = current.startsWith(lang === 'en' ? '/en/services/' : '/servizi/');
const prezzoDa = (s: { da: number; mese?: boolean }) => `${t.da} ${euro(s.da, lang)}${s.mese ? t.mese : ''}`;
const colori = [
  { id: 'blu', c: '#3D7BFF', nome: t.colori[0] },
  { id: 'rosso', c: '#FF3347', nome: t.colori[1] },
  { id: 'viola', c: '#8B6CFF', nome: t.colori[2] },
  { id: 'verde', c: '#22D47E', nome: t.colori[3] },
];
const hrefIt = lang === 'it' ? path : alt;
const hrefEn = lang === 'en' ? path : alt;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#05070F" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/img/icona-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.locale} />
    {alt && hrefIt && hrefEn && (
      <>
        <link rel="alternate" hreflang="it" href={new URL(hrefIt, Astro.site).toString()} />
        <link rel="alternate" hreflang="en" href={new URL(hrefEn, Astro.site).toString()} />
        <link rel="alternate" hreflang="x-default" href={new URL(hrefIt, Astro.site).toString()} />
      </>
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(lang === 'en' ? '/img/og-en.jpg' : '/img/og.jpg', Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) h.classList.add('ridotto');
        // colore scelto in «Personalizza» (il blu è quello predefinito)
        try {
          var p = JSON.parse(localStorage.getItem('gd-profilo') || 'null');
          if (p && ['rosso', 'viola', 'verde'].indexOf(p.tema) > -1) h.dataset.tema = p.tema;
          if (p && p.nome) h.classList.add('ha-nome');
        } catch (e) {}
        // Intro col punto di luce: solo alla prima pagina della visita
        try { if (!sessionStorage.getItem('gd-intro')) h.classList.add('intro-attiva'); } catch (e) {}
        try { if (!sessionStorage.getItem('gd-stelle') && !h.classList.contains('ridotto')) h.classList.add('stelle-titolo'); } catch (e) {}
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="intro" aria-hidden="true">
      <Occhio espressione="curioso" apertura class="intro-occhio" />
    </div>
    <script is:inline>
      // Intro della prima visita: l'occhio si apre, sbatte le palpebre, ti guarda e si gira verso il titolo
      (function () {
        var h = document.documentElement;
        if (!h.classList.contains('intro-attiva')) return;
        var t0 = performance.now(), chiusa = false;
        var ridotto = h.classList.contains('ridotto'), minimo = ridotto ? 200 : 2000;
        var svg = document.querySelector('.intro-occhio');
        var ap = svg && svg.querySelector('.m-apertura'), pup = svg && svg.querySelector('.m-pupilla'), palp = svg && svg.querySelectorAll('.m-palpebra');
        var liscia = function (x) { return x <= 0 ? 0 : x >= 1 ? 1 : x * x * (3 - 2 * x); };
        function anima(ora) {
          if (chiusa || !ap) return;
          var t = (ora - t0) / 1000;
          var a = ridotto ? 1 : liscia((t - 0.25) / 0.6);
          if (!ridotto && t > 1.05 && t < 1.33) a *= Math.abs(Math.cos(((t - 1.05) / 0.28) * Math.PI));
          ap.setAttribute('ry', (0.5 + a * 33).toFixed(2));
          for (var i = 0; i < palp.length; i++) palp[i].setAttribute('transform', 'translate(' + ((1 - a) * -3).toFixed(2) + ' ' + ((1 - a) * 9).toFixed(2) + ')');
          var g = liscia((t - 1.45) / 0.45);
          if (pup) pup.setAttribute('transform', 'translate(' + (-3 - g * 6).toFixed(2) + ' ' + (4 + g * 1).toFixed(2) + ')');
          requestAnimationFrame(anima);
        }
        requestAnimationFrame(anima);
        function chiudi() {
          if (chiusa) return; chiusa = true;
          h.classList.add('intro-fine');
          try { sessionStorage.setItem('gd-intro', '1'); } catch (e) {}
          setTimeout(function () { h.classList.remove('intro-attiva', 'intro-fine'); window.dispatchEvent(new Event('gd-intro-fine')); }, ridotto ? 30 : 700);
        }
        function pronta() { setTimeout(chiudi, Math.max(0, minimo - (performance.now() - t0))); }
        if (document.readyState === 'complete') pronta(); else window.addEventListener('load', pronta);
        setTimeout(chiudi, 3500); // mai bloccare chi ha una connessione lenta
      })();
    </script>

    <a class="skip-link" href="#contenuto">{t.vaiContenuto}</a>

    {scena && <div class="scena" aria-hidden="true"><canvas data-scena></canvas></div>}
    <div class="velo" aria-hidden="true"></div>
    <div class="grana" aria-hidden="true"></div>

    <header class="site-header" data-header>
      <div class="wrap header-bar">
        <a class="brand" href={home} aria-label={t.home}>
          <span class="brand-mark" set:html={marchio} />
          <span class="brand-testo">
            <span class="brand-nome-piccolo">Studio</span>
            <span class="brand-nome">Desideri</span>
          </span>
        </a>
        <nav class="nav" aria-label={t.navEtichetta} data-nav>
          <span class="nav-luce" aria-hidden="true"></span>
          {voci.map((v) => v.id === 'servizi' ? (
            <div class="nav-mega" data-mega>
              <button class={`nav-voce${suServizio ? ' attiva' : ''}`} type="button" aria-expanded="false" aria-controls="mega-servizi" data-mega-btn>
                {v.testo}<svg class="nav-freccia" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg>
              </button>
              <div class="mega" id="mega-servizi" data-mega-pannello hidden>
                <div class="mega-griglia">
                  <span class="mono mega-titolo">{t.megaTitolo}</span>
                  {servizi.map((s) => (
                    <a class="mega-voce" href={urlServizio(s.id, lang)} aria-current={isCurrent(urlServizio(s.id, lang))} data-iride={s.id}>
                      <span class="servizio-icona"><Icona nome={s.icona} /></span>
                      <span class="mega-testo"><strong>{s.titolo}</strong><small>{s.semplice}</small></span>
                      <span class="mega-prezzo">{prezzoDa(s)}</span>
                    </a>
                  ))}
                </div>
                <a class="mega-ai" href={url('ai', lang)}>
                  <Occhio espressione="curioso" />
                  <strong>{t.megaAi}</strong>
                  <span>{t.megaAiTesto}</span>
                  <span class="link-freccia">{t.megaVai} <span class="freccia" aria-hidden="true">→</span></span>
                </a>
              </div>
            </div>
          ) : (
            <a class={`nav-voce${v.id === '@ai' ? ' nav-ai' : ''}${isCurrent(v.href) ? ' attiva' : ''}`} href={v.href} aria-current={isCurrent(v.href)} data-sezione={v.id.startsWith('@') ? undefined : v.id}>{v.testo}</a>
          ))}
        </nav>
        <div class="header-strumenti">
          <button class="personalizza-btn" type="button" data-personalizza aria-expanded="false" aria-controls="pannello-tema" title={t.personalizza}>
            <span class="tavolozza" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span class="sr-only">{t.personalizza}</span>
          </button>
          {alt && (
            <a class="lingua" href={alt} hreflang={altLang} lang={altLang} data-lingua={altLang} title={t.cambiaLingua}>
              <span class="lingua-attiva" aria-hidden="true">{t.questaLinguaBreve}</span><span class="lingua-sep" aria-hidden="true">/</span><span>{t.altraLinguaBreve}</span>
              <span class="sr-only">{t.cambiaLingua}</span>
            </a>
          )}
        </div>
        <a class="btn btn-azione btn-piccolo header-cta" href={preventivo} data-magnete data-azione>{t.ctaPreventivo}</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-mobile" data-menu-toggle>
          <span></span><span></span><span class="sr-only">{t.menu}</span>
        </button>
      </div>
    </header>

    <!-- Personalizza: nome e colore, cambiano subito mentre scegli -->
    <div class="pannello-tema" id="pannello-tema" data-pannello-tema hidden role="dialog" aria-labelledby="pt-titolo">
      <div class="pt-testa">
        <Occhio espressione="curioso" />
        <span class="mono" id="pt-titolo">{t.ptTitolo}</span>
        <button class="pt-chiudi" type="button" data-pt-chiudi aria-label={t.chiudi}>×</button>
      </div>
      <label class="pt-domanda" for="pt-nome">{t.ptNome}</label>
      <input id="pt-nome" type="text" autocomplete="given-name" maxlength="24" placeholder={t.ptNomeSegnaposto} enterkeyhint="done" data-pt-nome />
      <p class="pt-domanda" id="pt-colore">{t.ptColore}</p>
      <div class="pt-colori" role="radiogroup" aria-labelledby="pt-colore">
        {colori.map((c) => (
          <button class="pt-colore" type="button" role="radio" aria-checked="false" data-tema-scelta={c.id} style={`--c:${c.c}`}>
            <i aria-hidden="true"></i><span>{c.nome}</span>
          </button>
        ))}
      </div>
      <p class="pt-nota">{t.ptNota}</p>
    </div>
    <div class="pt-invito" data-pt-invito hidden role="status">
      <span>{t.ptInvito}</span>
      <button type="button" aria-label={t.chiudi} data-pt-invito-chiudi>×</button>
    </div>

    <div class="menu-mobile" id="menu-mobile" data-menu inert data-lenis-prevent>
      <ul class="mm-voci" role="list">
        {voci.map((v, i) => <li style={`--i:${i}`}><a href={v.href}><span class="mm-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{v.testo}<span class="mm-freccia" aria-hidden="true">→</span></a></li>)}
      </ul>
      <div class="mm-servizi">
        <span class="mono">{t.menuServizi}</span>
        <div>
          {servizi.map((s) => (
            <a href={urlServizio(s.id, lang)}><span class="servizio-icona"><Icona nome={s.icona} /></span><span>{s.titolo}<small>{prezzoDa(s)}</small></span></a>
          ))}
        </div>
      </div>
      <div class="mm-azioni">
        <p class="mono">{contatti.zona}</p>
        <a class="btn btn-azione btn-grande" href={preventivo}>{t.ctaPreventivo}</a>
        <a class="btn btn-vetro" href={`https://wa.me/${contatti.whatsapp}`} target="_blank" rel="noopener" data-wa>{t.whatsapp}</a>
        <button class="btn btn-vetro" type="button" data-personalizza aria-controls="pannello-tema">
          <span class="tavolozza" aria-hidden="true"><i></i><i></i><i></i><i></i></span> {t.personalizza}
        </button>
      </div>
    </div>

    <main id="contenuto">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand" href={home} aria-label={t.home}>
              <span class="brand-mark" set:html={marchio} />
              <span class="brand-testo">
                <span class="brand-nome-piccolo">Studio</span>
                <span class="brand-nome">Desideri</span>
              </span>
            </a>
            <span class="brand-ruolo">{t.ruolo}</span>
            <p class="footer-claim">{t.footerClaim}</p>
          </div>
          <div>
            <h2>{t.footerServizi}</h2>
            <ul role="list">
              {servizi.map((s) => <li><a href={urlServizio(s.id, lang)}>{s.titolo}</a></li>)}
              <li><a href={url('ai', lang)}>{t.footerAi}</a></li>
              <li><a href={preventivo}>{t.footerPreventivo}</a></li>
            </ul>
          </div>
          <div>
            <h2>{t.footerParliamone}</h2>
            <ul role="list">
              <li><a href={`https://wa.me/${contatti.whatsapp}`} target="_blank" rel="noopener" data-wa>WhatsApp</a></li>
              <li><a href={`tel:${contatti.telefono.replace(/\s/g, '')}`}>{contatti.telefono}</a></li>
              <li><a href={`mailto:${contatti.email}`}>{contatti.email}</a></li>
              <li><a href={contatti.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
              <li>{contatti.zona}</li>
            </ul>
          </div>
        </div>
        <div class="footer-legale">
          <span>© {new Date().getFullYear()} {contatti.studio} di {contatti.nome}{contatti.piva ? ` · P.IVA ${contatti.piva}` : ''}</span>
          <span><a href={url('privacy', lang)}>{t.privacy}</a> · <button type="button" data-cookie-apri style="background:none;border:0;padding:0;color:inherit;text-decoration:underline;cursor:pointer;font-size:inherit">{t.preferenzeCookie}</button>{alt && <> · <a href={alt} hreflang={altLang} lang={altLang}>{t.altraLingua}</a></>}</span>
        </div>
      </div>
    </footer>

    {barra && (
      <div class="barra-pollice" data-barra>
        <a class="btn btn-azione" href={preventivo}>{t.ctaPreventivo}</a>
        <a class="btn btn-vetro" href={`https://wa.me/${contatti.whatsapp}`} target="_blank" rel="noopener" aria-label={t.whatsapp} data-wa>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.4-.3Z"/></svg>
        </a>
      </div>
    )}

    <div class="cookie" data-cookie hidden role="dialog" aria-label="Cookie">
      <p>{t.cookie} <a href={url('privacy', lang)}>{t.dettagli}</a></p>
      <div class="cookie-azioni">
        <button class="btn btn-vetro btn-piccolo" type="button" data-cookie-no>{t.cookieNo}</button>
        <button class="btn btn-vetro btn-piccolo" type="button" data-cookie-si>{t.cookieSi}</button>
      </div>
    </div>

    <div class="ritorno" data-ritorno hidden role="status">
      <Occhio espressione="innamorato" />
      <p><strong data-ritorno-titolo>{t.bentornato}!</strong> <span data-ritorno-testo>{t.bentornatoTesto}</span></p>
      <a class="link-freccia" href={preventivo} data-ritorno-link>{t.ctaPreventivo} <span class="freccia" aria-hidden="true">→</span></a>
      <button class="ritorno-chiudi" type="button" aria-label={t.chiudi} data-ritorno-chiudi>×</button>
    </div>

    {alt && (
      <div class="avviso-lingua" data-avviso-lingua data-per={altLang} hidden role="status" lang={altLang}>
        <span>{t.avvisoLingua}</span>
        <a href={alt} hreflang={altLang} data-lingua={altLang}>{t.avvisoLinguaLink} <span class="freccia" aria-hidden="true">→</span></a>
        <button type="button" aria-label={t.chiudi} data-avviso-chiudi>×</button>
      </div>
    )}


    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
