---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import { contatti } from '../data/sito.js';
import marchio from '../assets/marchio.svg?raw';

interface Props {
  title: string;
  description: string;
  path?: string;
  scena?: boolean;
  barra?: boolean;
  uscita?: boolean;
  jsonLd?: Record<string, unknown> | null;
}

const { title, description, path = '/', scena = true, barra = true, uscita = true, jsonLd = null } = Astro.props;
const canonical = new URL(path, Astro.site).toString();
const current = Astro.url.pathname.replace(/\.html$/, '');
const isCurrent = (href: string) => (current === href ? 'page' : undefined);
const voci = [
  { href: '/#servizi', testo: 'Servizi' },
  { href: '/#metodo', testo: 'Metodo' },
  { href: '/#lavori', testo: 'Lavori' },
  { href: '/#prezzi', testo: 'Prezzi' },
  { href: '/#chi-sono', testo: 'Chi sono' },
];
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0B0807" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/img/og.jpg', Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) h.classList.add('ridotto');
        // Intro col punto di luce: solo alla prima pagina della visita
        try { if (!sessionStorage.getItem('gd-intro')) h.classList.add('intro-attiva'); } catch (e) {}
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="intro" aria-hidden="true">
      <div class="intro-punto"></div>
      <div class="intro-testo"><span class="intro-num" data-intro-num>000</span></div>
    </div>
    <script is:inline>
      (function () {
        var h = document.documentElement;
        if (!h.classList.contains('intro-attiva')) return;
        var t0 = Date.now(), chiusa = false, num = document.querySelector('[data-intro-num]');
        var ridotto = h.classList.contains('ridotto'), minimo = ridotto ? 200 : 1100;
        var conta = setInterval(function () {
          var p = Math.min(100, Math.round(((Date.now() - t0) / minimo) * 100));
          if (num) num.textContent = ('00' + p).slice(-3);
        }, 40);
        function chiudi() {
          if (chiusa) return; chiusa = true; clearInterval(conta);
          if (num) num.textContent = '100';
          h.classList.add('intro-fine');
          try { sessionStorage.setItem('gd-intro', '1'); } catch (e) {}
          setTimeout(function () { h.classList.remove('intro-attiva', 'intro-fine'); window.dispatchEvent(new Event('gd-intro-fine')); }, ridotto ? 30 : 700);
        }
        function pronta() { setTimeout(chiudi, Math.max(0, minimo - (Date.now() - t0))); }
        if (document.readyState === 'complete') pronta(); else window.addEventListener('load', pronta);
        setTimeout(chiudi, 3000); // mai bloccare chi ha una connessione lenta
      })();
    </script>

    <a class="skip-link" href="#contenuto">Vai al contenuto</a>

    {scena && <div class="scena" aria-hidden="true"><canvas data-scena></canvas></div>}
    <div class="velo" aria-hidden="true"></div>
    <div class="grana" aria-hidden="true"></div>

    <header class="site-header" data-header>
      <div class="wrap header-bar">
        <a class="brand" href="/" aria-label="Gabriele Desideri, home">
          <span class="brand-mark" set:html={marchio} />
          <span class="brand-testo">
            <span class="brand-nome-piccolo">Gabriele</span>
            <span class="brand-nome">desideri</span>
          </span>
        </a>
        <nav class="nav" aria-label="Principale">
          {voci.map((v) => <a href={v.href} aria-current={isCurrent(v.href)}>{v.testo}</a>)}
        </nav>
        <a class="btn btn-azione btn-piccolo header-cta" href="/preventivo" data-magnete data-azione>Calcola il preventivo</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-mobile" data-menu-toggle>
          <span></span><span></span><span class="sr-only">Menu</span>
        </button>
      </div>
    </header>

    <div class="menu-mobile" id="menu-mobile" data-menu inert>
      <ul role="list">
        {voci.map((v) => <li><a href={v.href}>{v.testo}</a></li>)}
      </ul>
      <div style="display:grid;gap:1rem">
        <p class="mono">{contatti.zona}</p>
        <a class="btn btn-azione btn-grande" href="/preventivo">Calcola il preventivo</a>
        <a class="btn btn-vetro" href={`https://wa.me/${contatti.whatsapp}`} target="_blank" rel="noopener">Scrivimi su WhatsApp</a>
      </div>
    </div>

    <main id="contenuto">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand" href="/" aria-label="Gabriele Desideri, home">
              <span class="brand-mark" set:html={marchio} />
              <span class="brand-testo">
                <span class="brand-nome-piccolo">Gabriele</span>
                <span class="brand-nome">desideri</span>
              </span>
            </a>
            <p class="footer-claim">Di cognome faccio Desideri. Di lavoro, li creo.</p>
          </div>
          <div>
            <h2>Servizi</h2>
            <ul role="list">
              <li><a href="/#servizi">Siti web</a></li>
              <li><a href="/#servizi">Negozi online</a></li>
              <li><a href="/#servizi">Software e collegamenti AI</a></li>
              <li><a href="/#servizi">Pubblicità online</a></li>
              <li><a href="/preventivo">Preventivo automatico</a></li>
            </ul>
          </div>
          <div>
            <h2>Parliamone</h2>
            <ul role="list">
              <li><a href={`https://wa.me/${contatti.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a></li>
              <li><a href={`tel:${contatti.telefono.replace(/\s/g, '')}`}>{contatti.telefono}</a></li>
              <li><a href={`mailto:${contatti.email}`}>{contatti.email}</a></li>
              <li><a href={contatti.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
              <li>{contatti.zona}</li>
            </ul>
          </div>
        </div>
        <div class="footer-legale">
          <span>© {new Date().getFullYear()} {contatti.nome}{contatti.piva ? ` · P.IVA ${contatti.piva}` : ''}</span>
          <span><a href="/privacy">Privacy e cookie</a> · <button type="button" data-cookie-apri style="background:none;border:0;padding:0;color:inherit;text-decoration:underline;cursor:pointer;font-size:inherit">Preferenze cookie</button></span>
        </div>
      </div>
    </footer>

    {barra && (
      <div class="barra-pollice" data-barra>
        <a class="btn btn-azione" href="/preventivo">Calcola il preventivo</a>
        <a class="btn btn-vetro" href={`https://wa.me/${contatti.whatsapp}`} target="_blank" rel="noopener" aria-label="Scrivimi su WhatsApp">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.4-.3Z"/></svg>
        </a>
      </div>
    )}

    <div class="cookie" data-cookie hidden role="dialog" aria-label="Cookie">
      <p>Uso cookie di statistica e pubblicità solo se mi dai il permesso: servono a capire cosa funziona e a non sprecare annunci. Il sito funziona benissimo anche senza. <a href="/privacy">Dettagli</a></p>
      <div class="cookie-azioni">
        <button class="btn btn-vetro btn-piccolo" type="button" data-cookie-no>No, grazie</button>
        <button class="btn btn-vetro btn-piccolo" type="button" data-cookie-si>Va bene</button>
      </div>
    </div>

    {uscita && (
      <div class="uscita" data-uscita hidden role="dialog" aria-modal="true" aria-labelledby="uscita-titolo">
        <div class="uscita-box">
          <span class="capitolo">Un'ultima cosa</span>
          <h2 id="uscita-titolo">Prima di andare, <span class="em em-firma">guarda qui.</span></h2>
          <p>In 2 minuti vedi quanto costa il tuo progetto. Gratis, senza impegno, senza lasciare l'email per forza.</p>
          <div class="uscita-azioni">
            <a class="btn btn-azione btn-grande" href="/preventivo" data-azione data-uscita-si>Fammi vedere quanto costa <span class="freccia" aria-hidden="true">→</span></a>
            <button class="btn btn-vetro" type="button" data-uscita-chiudi>No grazie, ci penso</button>
          </div>
        </div>
      </div>
    )}

    <div class="ritorno" data-ritorno hidden role="status">
      <span class="ritorno-occhio" aria-hidden="true">◉</span>
      <p><strong>Bentornato!</strong> <span data-ritorno-testo>Riprendiamo da dove eravamo?</span></p>
      <a class="link-freccia" href="/preventivo" data-ritorno-link>Calcola il preventivo <span class="freccia" aria-hidden="true">→</span></a>
      <button class="ritorno-chiudi" type="button" aria-label="Chiudi" data-ritorno-chiudi>×</button>
    </div>

    <div class="cursore" aria-hidden="true"></div>
    <div class="cursore-punto" aria-hidden="true"></div>

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
