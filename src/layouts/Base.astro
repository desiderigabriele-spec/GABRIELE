---
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/vita.css';
import '../styles/assistente.css';
import { dati } from '../i18n/dati.js';
import { ui, url, urlServizio } from '../i18n/ui.js';
import logoScritta from '../assets/logo-scritta.svg?raw';
import logoIcona from '../assets/logo-icona.svg?raw';
import Cursore from '../components/Cursore.astro';
import Icona from '../components/Icona.astro';
import Assistente from '../components/Assistente.astro';
import { euro } from '../data/formato.js';

interface Props {
  title: string;
  description: string;
  path?: string;
  scena?: boolean;
  barra?: boolean;
  jsonLd?: Record<string, unknown> | null;
  lang?: 'it' | 'en';
  // la stessa pagina nell'altra lingua (null = non esiste)
  alt?: string | null;
}

const { title, description, path = '/', scena = true, barra = true, jsonLd = null, lang = 'it' } = Astro.props;
const t = ui[lang];
const altLang = lang === 'it' ? 'en' : 'it';
const alt = Astro.props.alt === undefined ? url('home', altLang) : Astro.props.alt;
const { contatti, servizi } = dati(lang);
const home = url('home', lang);
const preventivo = url('preventivo', lang);
const canonical = new URL(path, Astro.site).toString();
const current = Astro.url.pathname.replace(/\.html$/, '');
const isCurrent = (href: string) => (current === href ? 'page' : undefined);
// '@pagina' = un'altra pagina del sito, altrimenti una sezione della home
const voci = t.nav.map(([id, testo]) => ({ id, href: id.startsWith('@') ? url(id.slice(1), lang) : `${home}#${id}`, testo }));
// la voce attiva: la pagina AI, una pagina servizio («Servizi») o, in home, la sezione in vista (site.js)
const suServizio = current.startsWith(lang === 'en' ? '/en/services/' : '/servizi/');
const prezzoDa = (s: { da: number; mese?: boolean }) => `${t.da} ${euro(s.da, lang)}${s.mese ? t.mese : ''}`;
const hrefIt = lang === 'it' ? path : alt;
const hrefEn = lang === 'en' ? path : alt;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/img/icona-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.locale} />
    {alt && hrefIt && hrefEn && (
      <>
        <link rel="alternate" hreflang="it" href={new URL(hrefIt, Astro.site).toString()} />
        <link rel="alternate" hreflang="en" href={new URL(hrefEn, Astro.site).toString()} />
        <link rel="alternate" hreflang="x-default" href={new URL(hrefIt, Astro.site).toString()} />
      </>
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(lang === 'en' ? '/img/og-en.jpg' : '/img/og.jpg', Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        // .at() per Safari prima della 15.4 (iPhone vecchi): lo usa la scena 3D
        var at = function (n) { n = Math.trunc(n) || 0; if (n < 0) n += this.length; return this[n]; };
        [Array, String, Float32Array, Uint8Array, Uint16Array, Uint32Array, Int32Array].forEach(function (C) { if (C && !C.prototype.at) Object.defineProperty(C.prototype, 'at', { value: at, writable: true, configurable: true }); });
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) h.classList.add('ridotto');
        // il nome scelto all'ingresso o in «Aa»
        try {
          var p = JSON.parse(localStorage.getItem('gd-profilo') || 'null') || {};
          if (p.nome) h.classList.add('ha-nome');
        } catch (e) {}
        // Intro col cursore rosso: solo alla prima pagina della visita
        try { if (!sessionStorage.getItem('gd-intro')) h.classList.add('intro-attiva'); } catch (e) {}
        // arrivo da un'altra pagina del sito: la tendina rossa copre la pagina e poi si richiude (vita.js)
        try { if (sessionStorage.getItem('gd-tendina')) h.classList.add('tendina-arrivo'); } catch (e) {}
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="intro" aria-hidden="true">
      <span class="intro-marchio"><span class="intro-ic" set:html={logoIcona} /><span class="intro-sc" set:html={logoScritta} /></span>
      <span class="intro-occhio"><span class="io-iride"></span><span class="io-palpebra su"></span><span class="io-palpebra giu"></span></span>
    </div>
    <script is:inline>
      // Avvio della prima visita: compare il logo; dal suo quadratino rosso nasce l'occhio di Focus, che si apre,
      // si guarda intorno e fa l'occhiolino. Poi il logo vola al suo posto nell'header e l'occhio nel tondino in basso a destra.
      (function () {
        var h = document.documentElement;
        if (!h.classList.contains('intro-attiva')) return;
        var ridotto = h.classList.contains('ridotto'), chiusa = false, caricata = false, pronto = false, partito = false;
        var intro = document.querySelector('.intro'), marchio = intro.querySelector('.intro-marchio'), ic = intro.querySelector('.intro-ic');
        var occhio = intro.querySelector('.intro-occhio'), iride = occhio.querySelector('.io-iride'), palpebre = [].slice.call(occhio.querySelectorAll('.io-palpebra'));
        var EASE = 'cubic-bezier(.7,0,.2,1)', LATO = 60, su = 0, cx = 0, cy = 0;
        function fine(occhioArrivato) {
          if (chiusa) return; chiusa = true;
          try { sessionStorage.setItem('gd-intro', '1'); } catch (e) {}
          h.classList.remove('intro-attiva');
          window.dispatchEvent(new CustomEvent('gd-intro-fine', { detail: { occhio: !!occhioArrivato } }));
        }
        function vola() {
          if (chiusa || partito || !pronto || !caricata) return;
          partito = true;
          var mobile = innerWidth <= 900, lato = mobile ? 64 : 68, bordo = mobile ? 16 : 20;
          var tx = innerWidth - bordo - lato / 2, ty = innerHeight - bordo - lato / 2;
          var viaggio = occhio.animate([
            { transform: 'translateY(' + (-su) + 'px) scale(1.1)' },
            { transform: 'translate(' + (tx - cx) + 'px,' + (ty - cy) + 'px) scale(' + (lato / LATO) + ')' }
          ], { duration: 650, easing: EASE, fill: 'forwards' });
          var brand = document.querySelector('.site-header .brand-icona');
          if (brand) {
            var a = brand.getBoundingClientRect(), d = ic.getBoundingClientRect(), m = marchio.getBoundingClientRect(), k = a.height / d.height;
            var dx = a.left + a.width / 2 - (d.left + d.width / 2), dy = a.top + a.height / 2 - (d.top + d.height / 2);
            marchio.style.transformOrigin = (d.left + d.width / 2 - m.left) + 'px ' + (d.top + d.height / 2 - m.top) + 'px';
            marchio.animate([
              { transform: 'none', opacity: 1 },
              { transform: 'translate(' + dx + 'px,' + dy + 'px) scale(' + k + ')', opacity: 1, offset: .82 },
              { transform: 'translate(' + dx + 'px,' + dy + 'px) scale(' + k + ')', opacity: 0 }
            ], { duration: 650, easing: EASE, fill: 'forwards' });
          }
          intro.animate([{ backgroundColor: 'rgb(10,10,10)' }, { backgroundColor: 'rgba(10,10,10,0)' }], { duration: 650, easing: 'ease-in', fill: 'forwards' });
          viaggio.onfinish = function () { fine(true); };
        }
        if (ridotto || !intro.animate) { setTimeout(fine, 200); return; }
        if (document.readyState === 'complete') caricata = true;
        else window.addEventListener('load', function () { caricata = true; vola(); });
        setTimeout(function () { caricata = true; vola(); }, 3200); // mai bloccare chi ha una connessione lenta
        setTimeout(fine, 6000);
        var dopo = function (anim, fn) { anim.onfinish = fn; return anim; };
        // 1 · il logo
        marchio.animate([{ opacity: 0, transform: 'scale(.92)' }, { opacity: 1, transform: 'none' }], { duration: 320, easing: 'ease-out', fill: 'both' });
        setTimeout(function () {
          // 2 · l'occhio nasce dal quadratino rosso del logo e sale sopra di lui
          var r = ic.getBoundingClientRect();
          cx = r.left + r.width * .494; cy = r.top + r.height * .813; su = r.height * .813 + 46; // sopra il logo, staccato
          occhio.style.left = (cx - LATO / 2) + 'px'; occhio.style.top = (cy - LATO / 2) + 'px';
          dopo(occhio.animate([{ transform: 'translateY(0) scale(0)', opacity: 1 }, { transform: 'translateY(' + (-su) + 'px) scale(1.1)', opacity: 1 }], { duration: 440, easing: 'cubic-bezier(.3,1.4,.5,1)', fill: 'forwards' }), function () {
            // 3 · si apre, si guarda intorno, occhiolino
            palpebre.forEach(function (p) { p.animate([{ transform: 'scaleY(1)' }, { transform: 'scaleY(0)' }], { duration: 260, easing: 'ease-out', fill: 'forwards' }); });
            setTimeout(function () {
              dopo(iride.animate([{ transform: 'translate(0,0)' }, { transform: 'translate(-9px,1px)', offset: .3 }, { transform: 'translate(9px,1px)', offset: .7 }, { transform: 'translate(0,0)' }], { duration: 700, easing: 'ease-in-out', fill: 'forwards' }), function () {
                palpebre.forEach(function (p) { p.animate([{ transform: 'scaleY(0)' }, { transform: 'scaleY(1)', offset: .5 }, { transform: 'scaleY(0)' }], { duration: 220, fill: 'forwards' }); });
                setTimeout(function () { pronto = true; vola(); }, 240);
              });
            }, 260);
          });
        }, 340);
      })();
    </script>

    <a class="skip-link" href="#contenuto">{t.vaiContenuto}</a>

    {scena && <div class="scena" aria-hidden="true"><canvas data-scena></canvas></div>}
    <div class="velo" aria-hidden="true"></div>
    <div class="grana" aria-hidden="true"></div>

    <header class="site-header" data-header>
      <div class="wrap header-bar">
        <a class="brand" href={home} aria-label={t.home}>
          <span class="brand-icona" set:html={logoIcona} />
          <span class="brand-logo" set:html={logoScritta} />
        </a>
        <nav class="nav" aria-label={t.navEtichetta} data-nav>
          <span class="nav-luce" aria-hidden="true"></span>
          {voci.map((v) => v.id === 'servizi' ? (
            <div class="nav-mega" data-mega>
              <button class={`nav-voce${suServizio ? ' attiva' : ''}`} type="button" aria-expanded="false" aria-controls="mega-servizi" data-mega-btn>
                {v.testo}<svg class="nav-freccia" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg>
              </button>
              <div class="mega" id="mega-servizi" data-mega-pannello hidden>
                <div class="mega-griglia">
                  <span class="mono mega-titolo">{t.megaTitolo}</span>
                  {servizi.map((s) => (
                    <a class="mega-voce" href={urlServizio(s.id, lang)} aria-current={isCurrent(urlServizio(s.id, lang))} data-iride={s.id}>
                      <span class="servizio-icona"><Icona nome={s.icona} /></span>
                      <span class="mega-testo"><strong>{s.titolo}</strong><small>{s.semplice}</small></span>
                      <span class="mega-prezzo">{prezzoDa(s)}</span>
                    </a>
                  ))}
                </div>
                <a class="mega-ai" href={url('ai', lang)}>
                  <Cursore stato="pensa" />
                  <strong>{t.megaAi}</strong>
                  <span>{t.megaAiTesto}</span>
                  <span class="link-freccia">{t.megaVai} <span class="freccia" aria-hidden="true">→</span></span>
                </a>
              </div>
            </div>
          ) : (
            <a class={`nav-voce${v.id === '@ai' ? ' nav-ai' : ''}${isCurrent(v.href) ? ' attiva' : ''}`} href={v.href} aria-current={isCurrent(v.href)} data-sezione={v.id.startsWith('@') ? undefined : v.id}>{v.testo}</a>
          ))}
        </nav>
        <div class="header-strumenti">
          {alt && (
            <a class="lingua" href={alt} hreflang={altLang} lang={altLang} data-lingua={altLang} title={t.cambiaLingua}>
              <span aria-hidden="true">{t.altraLinguaBreve}</span>
              <span class="sr-only">{t.cambiaLingua}</span>
            </a>
          )}
        </div>
        <a class="btn btn-azione btn-piccolo header-cta" href={preventivo} data-magnete data-azione>{t.ctaPreventivo}</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-mobile" data-menu-toggle>
          <span></span><span></span><span class="sr-only">{t.menu}</span>
        </button>
      </div>
    </header>

    <!-- All'ingresso: il nome, chiesto una volta sola. Poi compare solo nei punti che contano (titolo, preventivo, finale, messaggi). -->
    <dialog class="chiedi-nome" data-chiedi-nome aria-labelledby="cn-titolo">
      <form method="dialog" class="cn-box" data-cn-form>
        <Cursore stato="aspetta" />
        <h2 id="cn-titolo">{t.cnTitolo}</h2>
        <p>{t.cnTesto}</p>
        <label class="sr-only" for="cn-nome">{t.ptNome}</label>
        <input id="cn-nome" name="nome" type="text" autocomplete="given-name" maxlength="24" placeholder={t.ptNomeSegnaposto} enterkeyhint="go" data-cn-nome autofocus />
        <div class="cn-azioni">
          <button class="btn btn-azione" type="submit" value="si" data-cn-si>{t.cnEntra} <span class="freccia" aria-hidden="true">→</span></button>
        </div>
        <!-- dopo i bottoni: così Invio nel campo vale «Entra» -->
        <button class="cn-chiudi" type="submit" value="no" formnovalidate aria-label={t.cnChiudi}><span aria-hidden="true">×</span></button>
      </form>
    </dialog>

    <div class="menu-mobile" id="menu-mobile" data-menu inert data-lenis-prevent>
      <ul class="mm-voci" role="list">
        {voci.map((v, i) => <li style={`--i:${i}`}><a href={v.href}><span class="mm-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{v.testo}<span class="mm-freccia" aria-hidden="true">→</span></a></li>)}
      </ul>
      <div class="mm-servizi">
        <span class="mono">{t.menuServizi}</span>
        <div>
          {servizi.map((s) => (
            <a href={urlServizio(s.id, lang)}><span class="servizio-icona"><Icona nome={s.icona} /></span><span>{s.titolo}<small>{prezzoDa(s)}</small></span></a>
          ))}
        </div>
      </div>
      <div class="mm-azioni">
        <p class="mono">{contatti.zona}</p>
        <a class="btn btn-azione btn-grande" href={preventivo}>{t.ctaPreventivo}</a>
        <a class="btn btn-vetro" href={`https://wa.me/${contatti.whatsapp}`} target="_blank" rel="noopener" data-wa>{t.whatsapp}</a>
      </div>
    </div>

    <main id="contenuto">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand brand-impilato" href={home} aria-label={t.home}>
              <span class="brand-icona" set:html={logoIcona} />
              <span class="brand-logo" set:html={logoScritta} />
            </a>
            <span class="brand-ruolo">{t.ruolo}</span>
            <p class="footer-claim">{t.footerClaim}</p>
          </div>
          <div>
            <h2>{t.footerServizi}</h2>
            <ul role="list">
              {servizi.map((s) => <li><a href={urlServizio(s.id, lang)}>{s.titolo}</a></li>)}
              <li><a href={url('ai', lang)}>{t.footerAi}</a></li>
              <li><a href={url('demo', lang)}>{t.footerDemo}</a></li>
              <li><a href={preventivo}>{t.footerPreventivo}</a></li>
            </ul>
          </div>
          <div>
            <h2>{t.footerParliamone}</h2>
            <ul role="list">
              <li><a href={`https://wa.me/${contatti.whatsapp}`} target="_blank" rel="noopener" data-wa>WhatsApp</a></li>
              <li><a href={`tel:${contatti.telefono.replace(/\s/g, '')}`}>{contatti.telefono}</a></li>
              <li><a href={`mailto:${contatti.email}`}>{contatti.email}</a></li>
              <li><a href={contatti.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
              <li>{contatti.zona}</li>
            </ul>
          </div>
        </div>
        <div class="footer-legale">
          <span>© {new Date().getFullYear()} {contatti.studio} di {contatti.nome}{contatti.piva ? ` · P.IVA ${contatti.piva}` : ''}</span>
          <span><a href={url('privacy', lang)}>{t.privacy}</a> · <button type="button" data-cookie-apri style="background:none;border:0;padding:0;color:inherit;text-decoration:underline;cursor:pointer;font-size:inherit">{t.preferenzeCookie}</button>{alt && <> · <a href={alt} hreflang={altLang} lang={altLang}>{t.altraLingua}</a></>}</span>
        </div>
      </div>
    </footer>

    <!-- su telefono niente barra in basso: c'è solo Focus, e dentro la chat il preventivo e WhatsApp -->

    <Assistente lang={lang} />

    <div class="cookie" data-cookie hidden role="dialog" aria-label="Cookie">
      <p>{t.cookie} <a href={url('privacy', lang)}>{t.dettagli}</a></p>
      <div class="cookie-azioni">
        <button class="btn btn-vetro btn-piccolo" type="button" data-cookie-no>{t.cookieNo}</button>
        <button class="btn btn-vetro btn-piccolo" type="button" data-cookie-si>{t.cookieSi}</button>
      </div>
    </div>

    <div class="ritorno" data-ritorno hidden role="status">
      <Cursore stato="saluta" />
      <p><strong data-ritorno-titolo>{t.bentornato}!</strong> <span data-ritorno-testo>{t.bentornatoTesto}</span></p>
      <a class="link-freccia" href={preventivo} data-ritorno-link>{t.ctaPreventivo} <span class="freccia" aria-hidden="true">→</span></a>
      <button class="ritorno-chiudi" type="button" aria-label={t.chiudi} data-ritorno-chiudi>×</button>
    </div>

    {alt && (
      <div class="avviso-lingua" data-avviso-lingua data-per={altLang} hidden role="status" lang={altLang}>
        <span>{t.avvisoLingua}</span>
        <a href={alt} hreflang={altLang} data-lingua={altLang}>{t.avvisoLinguaLink} <span class="freccia" aria-hidden="true">→</span></a>
        <button type="button" aria-label={t.chiudi} data-avviso-chiudi>×</button>
      </div>
    )}


    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
