---
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/vita.css';
import '../styles/assistente.css';
import { dati } from '../i18n/dati.js';
import { ui, url, urlServizio } from '../i18n/ui.js';
import logoScritta from '../assets/logo-scritta.svg?raw';
import logoIcona from '../assets/logo-icona.svg?raw';
import Cursore from '../components/Cursore.astro';
import Icona from '../components/Icona.astro';
import Assistente from '../components/Assistente.astro';
import { euro } from '../data/formato.js';

interface Props {
  title: string;
  description: string;
  path?: string;
  scena?: boolean;
  barra?: boolean;
  jsonLd?: Record<string, unknown> | null;
  lang?: 'it' | 'en';
  // la stessa pagina nell'altra lingua (null = non esiste)
  alt?: string | null;
}

const { title, description, path = '/', scena = true, barra = true, jsonLd = null, lang = 'it' } = Astro.props;
const t = ui[lang];
const altLang = lang === 'it' ? 'en' : 'it';
const alt = Astro.props.alt === undefined ? url('home', altLang) : Astro.props.alt;
const { contatti, servizi } = dati(lang);
const home = url('home', lang);
const preventivo = url('preventivo', lang);
const canonical = new URL(path, Astro.site).toString();
const current = Astro.url.pathname.replace(/\.html$/, '');
const isCurrent = (href: string) => (current === href ? 'page' : undefined);
// '@pagina' = un'altra pagina del sito, altrimenti una sezione della home
const voci = t.nav.map(([id, testo]) => ({ id, href: id.startsWith('@') ? url(id.slice(1), lang) : `${home}#${id}`, testo }));
// la voce attiva: la pagina AI, una pagina servizio («Servizi») o, in home, la sezione in vista (site.js)
const suServizio = current.startsWith(lang === 'en' ? '/en/services/' : '/servizi/');
const prezzoDa = (s: { da: number; mese?: boolean }) => `${t.da} ${euro(s.da, lang)}${s.mese ? t.mese : ''}`;
const hrefIt = lang === 'it' ? path : alt;
const hrefEn = lang === 'en' ? path : alt;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/img/icona-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.locale} />
    {alt && hrefIt && hrefEn && (
      <>
        <link rel="alternate" hreflang="it" href={new URL(hrefIt, Astro.site).toString()} />
        <link rel="alternate" hreflang="en" href={new URL(hrefEn, Astro.site).toString()} />
        <link rel="alternate" hreflang="x-default" href={new URL(hrefIt, Astro.site).toString()} />
      </>
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(lang === 'en' ? '/img/og-en.jpg' : '/img/og.jpg', Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        // .at() per Safari prima della 15.4 (iPhone vecchi): lo usa la scena 3D
        var at = function (n) { n = Math.trunc(n) || 0; if (n < 0) n += this.length; return this[n]; };
        [Array, String, Float32Array, Uint8Array, Uint16Array, Uint32Array, Int32Array].forEach(function (C) { if (C && !C.prototype.at) Object.defineProperty(C.prototype, 'at', { value: at, writable: true, configurable: true }); });
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) h.classList.add('ridotto');
        // il nome scelto all'ingresso o in «Aa»
        try {
          var p = JSON.parse(localStorage.getItem('gd-profilo') || 'null') || {};
          if (p.nome) h.classList.add('ha-nome');
        } catch (e) {}
        // lo sfondo chiaro o scuro scelto col bottone nell'header (prima del disegno, così non lampeggia)
        try { if (localStorage.getItem('gd-tema') === 'chiaro') h.dataset.tema = 'chiaro'; } catch (e) {}
        // Intro col cursore rosso: solo alla prima pagina della visita
        try { if (!sessionStorage.getItem('gd-intro')) h.classList.add('intro-attiva'); } catch (e) {}
        // arrivo da un'altra pagina del sito con il salto tra le stelle: la pagina nasce nascosta e appare mentre le stelle rallentano (vita.js)
        try { if (sessionStorage.getItem('gd-salto')) h.classList.add('salto-arrivo'); } catch (e) {}
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="intro" aria-hidden="true">
      <span class="intro-marchio"><span class="intro-ic" set:html={logoIcona} /><span class="intro-sc" set:html={logoScritta} /></span>
      <span class="intro-bolla"></span>
    </div>
    <script is:inline>
      // Avvio della prima visita: l'animazione è in scripts/intro.js (l'occhio vero di Focus).
      // Qui solo la rete di sicurezza: se per qualche motivo non parte, dopo 7 secondi la pagina si apre lo stesso.
      (function () {
        var h = document.documentElement;
        if (!h.classList.contains('intro-attiva')) return;
        setTimeout(function () {
          if (!h.classList.contains('intro-attiva')) return;
          try { sessionStorage.setItem('gd-intro', '1'); } catch (e) {}
          h.classList.remove('intro-attiva');
          window.dispatchEvent(new CustomEvent('gd-intro-fine', { detail: { occhio: false } }));
        }, 7000);
      })();
    </script>

    <a class="skip-link" href="#contenuto">{t.vaiContenuto}</a>

    {scena && <div class="scena" aria-hidden="true"><canvas data-scena></canvas></div>}
    <div class="velo" aria-hidden="true"></div>
    <div class="grana" aria-hidden="true"></div>

    <header class="site-header" data-header>
      <div class="wrap header-bar">
        <a class="brand" href={home} aria-label={t.home}>
          <span class="brand-icona" set:html={logoIcona} />
          <span class="brand-logo" set:html={logoScritta} />
        </a>
        <nav class="nav" aria-label={t.navEtichetta} data-nav>
          <span class="nav-luce" aria-hidden="true"></span>
          {voci.map((v) => v.id === 'servizi' ? (
            <div class="nav-mega" data-mega>
              <button class={`nav-voce${suServizio ? ' attiva' : ''}`} type="button" aria-expanded="false" aria-controls="mega-servizi" data-mega-btn>
                {v.testo}<svg class="nav-freccia" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg>
              </button>
              <div class="mega" id="mega-servizi" data-mega-pannello hidden>
                <div class="mega-griglia">
                  <span class="mono mega-titolo">{t.megaTitolo}</span>
                  {servizi.map((s) => (
                    <a class="mega-voce" href={urlServizio(s.id, lang)} aria-current={isCurrent(urlServizio(s.id, lang))} data-iride={s.id}>
                      <span class="servizio-icona"><Icona nome={s.icona} /></span>
                      <span class="mega-testo"><strong>{s.titolo}</strong><small>{s.semplice}</small></span>
                      <span class="mega-prezzo">{prezzoDa(s)}</span>
                    </a>
                  ))}
                </div>
                <a class="mega-ai" href={url('ai', lang)}>
                  <Cursore stato="pensa" />
                  <strong>{t.megaAi}</strong>
                  <span>{t.megaAiTesto}</span>
                  <span class="link-freccia">{t.megaVai} <span class="freccia" aria-hidden="true">→</span></span>
                </a>
              </div>
            </div>
          ) : (
            <a class={`nav-voce${v.id === '@ai' ? ' nav-ai' : ''}${isCurrent(v.href) ? ' attiva' : ''}`} href={v.href} aria-current={isCurrent(v.href)} data-sezione={v.id.startsWith('@') ? undefined : v.id}>{v.testo}</a>
          ))}
        </nav>
        <div class="header-strumenti">
          <button class="tema-btn" type="button" data-tema-btn aria-label={t.temaChiaro} data-testi={JSON.stringify([t.temaChiaro, t.temaScuro])}>
            <svg class="sole" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M21.5 12h-2.2M4.7 12H2.5M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6M18.7 18.7l-1.6-1.6M6.9 6.9 5.3 5.3"/></svg>
            <svg class="luna" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
          </button>
          {/* il nome: NO sopra e ME sotto (NA/ME in inglese), lettere a linee dritte che insieme fanno un quadrato */}
          <div class="nome-pop-box">
            <button class="nome-btn" type="button" data-nome-btn aria-label={t.nomeBtn} aria-expanded="false" aria-controls="nome-pop">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M1.2 10V1.2L8.8 8.8V0" />
                {lang === 'en'
                  ? <path d="M15.2 10V1.2H22.8V10M15.2 5.4H22.8" />
                  : <rect class="nome-o" x="15.2" y="1.2" width="7.6" height="7.6" />}
                <path d="M1.2 24V15.2L5 19.6L8.8 15.2V24" />
                <path d="M24 15.2H15.2V22.8H24M15.2 19H22" />
              </svg>
            </button>
            <form class="nome-pop" id="nome-pop" data-nome-pop hidden>
              <label for="nome-pop-campo">{t.bvTitolo}</label>
              <div><input id="nome-pop-campo" name="nome" type="text" autocomplete="given-name" maxlength="24" placeholder={t.bvSegnaposto} enterkeyhint="done" autocapitalize="words" spellcheck="false"><button class="btn btn-azione" type="submit">{t.nomeSalva}</button></div>
              <small>{t.bvPerche}</small>
            </form>
          </div>
          {alt && (
            <a class="lingua" href={alt} hreflang={altLang} lang={altLang} data-lingua={altLang} title={t.cambiaLingua}>
              <span aria-hidden="true">{t.altraLinguaBreve}</span>
              <span class="sr-only">{t.cambiaLingua}</span>
            </a>
          )}
        </div>
        <a class="btn btn-azione btn-piccolo header-cta" href={preventivo} data-magnete data-azione>{t.ctaPreventivo}</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-mobile" data-menu-toggle>
          <span></span><span></span><span class="sr-only">{t.menu}</span>
        </button>
      </div>
    </header>


    <div class="menu-mobile" id="menu-mobile" data-menu inert data-lenis-prevent>
      <ul class="mm-voci" role="list">
        {voci.map((v, i) => <li style={`--i:${i}`}><a href={v.href}><span class="mm-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{v.testo}<span class="mm-freccia" aria-hidden="true">→</span></a></li>)}
      </ul>
      <div class="mm-servizi">
        <span class="mono">{t.menuServizi}</span>
        <div>
          {servizi.map((s) => (
            <a href={urlServizio(s.id, lang)}><span class="servizio-icona"><Icona nome={s.icona} /></span><span>{s.titolo}<small>{prezzoDa(s)}</small></span></a>
          ))}
        </div>
      </div>
      <div class="mm-azioni">
        <p class="mono">{contatti.zona}</p>
        <a class="btn btn-azione btn-grande" href={preventivo}>{t.ctaPreventivo}</a>
        <a class="btn btn-vetro" href={`https://wa.me/${contatti.whatsapp}`} target="_blank" rel="noopener" data-wa>{t.whatsapp}</a>
      </div>
    </div>

    <main id="contenuto">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand brand-impilato" href={home} aria-label={t.home}>
              <span class="brand-icona" set:html={logoIcona} />
              <span class="brand-logo" set:html={logoScritta} />
            </a>
            <span class="brand-ruolo">{t.ruolo}</span>
            <p class="footer-claim">{t.footerClaim}</p>
          </div>
          <div>
            <h2>{t.footerServizi}</h2>
            <ul role="list">
              {servizi.map((s) => <li><a href={urlServizio(s.id, lang)}>{s.titolo}</a></li>)}
              <li><a href={url('ai', lang)}>{t.footerAi}</a></li>
              <li><a href={url('demo', lang)}>{t.footerDemo}</a></li>
              <li><a href={preventivo}>{t.footerPreventivo}</a></li>
            </ul>
          </div>
          <div>
            <h2>{t.footerParliamone}</h2>
            <ul role="list">
              <li><a href={`https://wa.me/${contatti.whatsapp}`} target="_blank" rel="noopener" data-wa>WhatsApp</a></li>
              <li><a href={`tel:${contatti.telefono.replace(/\s/g, '')}`}>{contatti.telefono}</a></li>
              <li><a href={`mailto:${contatti.email}`}>{contatti.email}</a></li>
              <li><a href={contatti.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
              <li>{contatti.zona}</li>
            </ul>
          </div>
        </div>
        <div class="footer-legale">
          <span>© {new Date().getFullYear()} {contatti.studio} di {contatti.nome}{contatti.piva ? ` · P.IVA ${contatti.piva}` : ''}</span>
          <span><a href={url('privacy', lang)}>{t.privacy}</a> · <button type="button" data-cookie-apri style="background:none;border:0;padding:0;color:inherit;text-decoration:underline;cursor:pointer;font-size:inherit">{t.preferenzeCookie}</button>{alt && <> · <a href={alt} hreflang={altLang} lang={altLang}>{t.altraLingua}</a></>}</span>
        </div>
      </div>
    </footer>

    <!-- su telefono niente barra in basso: c'è solo Focus, e dentro la chat il preventivo e WhatsApp -->

    <Assistente lang={lang} />

    <!-- Il benvenuto, in basso e piccolo: il nome e i cookie con una sola conferma. Il nome si chiede una volta sola;
         i cookie finché non scegli. «Accetta ed entra» e «Solo necessari» sono grandi uguali.
         Logica in scripts/benvenuto.js. -->
    <div class="benvenuto" data-benvenuto hidden role="dialog" aria-labelledby="bv-titolo">
      <form class="bv-box" data-bv-form>
        <!-- lo sfondo si sceglie anche qui: cambia subito, così vedi come ti piace -->
        <div class="bv-sfondo" role="group" aria-label={t.bvSfondo}>
          <span class="mono bv-prima">{t.bvSfondo}</span>
          <button type="button" data-bv-tema="scuro" aria-pressed="true"><i class="bv-campione scuro"></i>{t.bvScuro}</button>
          <button type="button" data-bv-tema="chiaro" aria-pressed="false"><i class="bv-campione chiaro"></i>{t.bvChiaro}</button>
        </div>
        <div class="bv-nome" data-bv-nome-parte>
          <span class="mono bv-prima">{t.bvPrima}</span>
          <label class="bv-titolo" id="bv-titolo" for="bv-nome">{t.bvTitolo}</label>
          <span class="bv-perche">{t.bvPerche}</span>
          <input id="bv-nome" name="nome" type="text" autocomplete="given-name" maxlength="24" placeholder={t.bvSegnaposto} enterkeyhint="done" data-bv-nome />
        </div>
        <div class="bv-cookie" data-bv-cookie-parte>
          <span class="mono bv-prima" data-bv-cookie-titolo hidden>{t.bvCookieTitolo}</span>
          <p>{t.bvCookie} <span data-bv-nome-resta>{t.bvNomeResta}</span> <a href={url('privacy', lang)}>{t.dettagli}</a></p>
        </div>
        <!-- «Personalizza» apre le scelte qui dentro, al posto del testo: tutte spente tranne i necessari -->
        <fieldset class="bv-scelte" data-bv-scelte hidden>
          <legend class="mono bv-prima">{t.bvScelte}</legend>
          {t.bvCat.map(([id, nome, cosa]) => (
            <label class="bv-cat">
              <span><b>{nome}</b><small>{cosa}</small></span>
              <input type="checkbox" name={id} data-bv-cat={id} checked={id === 'necessari'} disabled={id === 'necessari'} />
              <i class="bv-tog" aria-hidden="true"></i>
            </label>
          ))}
        </fieldset>
        <div class="bv-azioni">
          <!-- a sinistra «Personalizza» (poi «Salva le mie scelte»), a destra «Accetta», l'unico pieno, dove va il pollice -->
          <button class="btn btn-vetro btn-piccolo" type="button" data-bv-no data-testi={JSON.stringify([t.bvNo, t.bvSalva])}>{t.bvNo}</button>
          <button class="btn btn-azione btn-piccolo" type="submit" value="si" data-bv-si data-testi={JSON.stringify([t.bvSi, t.bvAccetta, t.bvEntra, t.bvTutti])}>{t.bvSi} <span class="freccia" aria-hidden="true">→</span></button>
        </div>
        <!-- la × piccola in alto a destra: chiude senza accettare (resta il nome, se l'hai scritto) -->
        <button class="bv-chiudi" type="button" data-bv-senza aria-label={t.bvSenza} title={t.bvSenza}><span aria-hidden="true">×</span></button>
      </form>
    </div>

    {alt && (
      <div class="avviso-lingua" data-avviso-lingua data-per={altLang} hidden role="status" lang={altLang}>
        <span>{t.avvisoLingua}</span>
        <a href={alt} hreflang={altLang} data-lingua={altLang}>{t.avvisoLinguaLink} <span class="freccia" aria-hidden="true">→</span></a>
        <button type="button" aria-label={t.chiudi} data-avviso-chiudi>×</button>
      </div>
    )}


    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
