{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/((?!_sd/|img/|brand/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(img|brand)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/_sd/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/servizi/software-ai",
      "destination": "/servizi/automazioni-ai",
      "permanent": true
    },
    {
      "source": "/servizi/collegamenti-ai",
      "destination": "/servizi/automazioni-ai",
      "permanent": true
    },
    {
      "source": "/en/services/ai-software",
      "destination": "/en/services/ai-automation",
      "permanent": true
    },
    {
      "source": "/en/services/ai-integrations",
      "destination": "/en/services/ai-automation",
      "permanent": true
    }
  ]
}
